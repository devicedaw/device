// Mixer panel: replaces the bottom panel when "Toggle mixer panel" is on.
// Geometry:
// 108 pt strips, padding 0 8 8, laid out from the bottom up: foot row (M/S + peak),
// the 200 pt fader canvas, a 46 pt gain row (pan knob + gain readout), the 22 pt Sends row, and
// the insert list taking what is left under the 20 pt name bar. Lengths are points
// times `u` (our design units are 85 % of a point at 100 % zoom, see zoom.rs).
// Every value comes from Rust (Studio.strips / strip-meters / master-*); every edit goes out
// through the same Studio callbacks as the track headers.
import { Tokens } from "tokens.slint";
import { Panel, Icon, Icons, IconButton, Knob } from "widgets.slint";
import { Studio, MixerStrip, StripMeter, SendRow } from "studio.slint";
import { StripMetrics, StripCanvas, StripReadout, StripButton } from "channel_strip.slint";

// One send slot in an expanded Sends section: the return's colour tag with its letter (click:
// the send's options, Post-fader / Pre-fader / Reset to 0 dB / Remove send), a horizontal level
// slider (volume-slider taper, 0 dB at 0.8; double-click resets) and the dB value. A silent slot
// (nothing sent to that return yet) is dim; dragging its slider sends.
component SendLine inherits Rectangle {
    in property <SendRow> r;
    property <length> u: StripMetrics.u;
    property <length> track-x: 20 * root.u;
    property <length> track-w: 44 * root.u;
    height: 20 * root.u;
    Rectangle {
        x: 2 * root.u; y: 3 * root.u; width: 14 * root.u; height: 14 * root.u; border-radius: 3 * root.u;
        background: root.r.live ? root.r.color : root.r.color.with-alpha(opt-ta.has-hover ? 0.6 : 0.35);
        Text { text: root.r.letter; color: root.r.color.darker(4.5); font-size: 9 * root.u; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
        opt-ta := TouchArea {
            clicked => { Studio.open-send-options(root.r.track, root.r.target, self.absolute-position.x, (self.absolute-position.y - Studio.menu-dy) + parent.height + 2px); }
            accessible-role: button; accessible-label: "Send to " + root.r.name + " options";
        }
    }
    // Pre-fader sends: a small dot after the tag.
    if root.r.pre: Rectangle { x: 17.5 * root.u; y: 8.5 * root.u; width: 3 * root.u; height: 3 * root.u; border-radius: 1.5 * root.u; background: #ffffffb3; }
    Rectangle { x: root.track-x; y: 9 * root.u; width: root.track-w; height: 2 * root.u; border-radius: 1 * root.u; background: #2f3036; }
    Rectangle { x: root.track-x; y: 9 * root.u; width: root.track-w * root.r.pos; height: 2 * root.u; border-radius: 1 * root.u; background: root.r.color; }
    Rectangle {
        x: root.track-x + root.track-w * root.r.pos - 4 * root.u; y: 6 * root.u; width: 8 * root.u; height: 8 * root.u; border-radius: 4 * root.u;
        background: level-ta.pressed || level-ta.has-hover ? #ffffff : root.r.live ? #d9d9dc : #6b6c70;
    }
    Text {
        x: root.width - 28 * root.u; width: 28 * root.u; text: root.r.short-text; color: root.r.live ? #ffffff99 : #ffffff40;
        font-size: 9 * root.u; font-weight: 600; horizontal-alignment: right; vertical-alignment: center;
    }
    level-ta := TouchArea {
        x: root.track-x - 4 * root.u; width: root.track-w + 8 * root.u;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) { Studio.send-gesture-end(); }
        }
        moved => { if (self.pressed) { Studio.send-pos(root.r.track, root.r.target, max(0, min(1, (self.mouse-x - 4 * root.u) / root.track-w))); } }
        clicked => { Studio.send-pos(root.r.track, root.r.target, max(0, min(1, (self.mouse-x - 4 * root.u) / root.track-w))); Studio.send-gesture-end(); }
        double-clicked => { Studio.send-reset(root.r.track, root.r.target); }
    }
    accessible-role: slider; accessible-label: "Send to " + root.r.name; accessible-value: root.r.db-text;
    // Assistive technology steps the level by 2 % of the slider, one undo step each.
    accessible-action-increment => { Studio.send-pos(root.r.track, root.r.target, min(1, root.r.pos + 0.02)); Studio.send-gesture-end(); }
    accessible-action-decrement => { Studio.send-pos(root.r.track, root.r.target, max(0, root.r.pos - 0.02)); Studio.send-gesture-end(); }
}

// One channel strip. `master` switches to the master layout (white name bar, no sends,
// M only) and the master callbacks.
component Strip inherits Rectangle {
    in property <MixerStrip> s;
    in property <StripMeter> m;
    in property <bool> master;
    in property <string> gain-text;
    property <length> u: StripMetrics.u;
    property <length> foot-y: root.height - 26 * root.u;
    property <length> canvas-y: root.height - 234 * root.u;
    property <length> gain-y: root.height - 280 * root.u;
    property <length> sends-y: root.height - 302 * root.u;
    // Group lanes: 4 px above the name bar while the mixer shows any group.
    property <length> lanes-h: Studio.mixer-group-lanes * 4 * root.u;
    width: 108 * root.u;
    background: !root.master && root.s.selected ? #232428 : body-ta.has-hover ? #1c1d20 : transparent;
    // Body click selects the track (declared first so controls stay on top).
    body-ta := TouchArea { clicked => { if (!root.master) { Studio.select-track(root.s.id); } } }
    // Group bar: 3 px in the group's colour across the tops of its strips (joined to the next
    // strip until the group's last track).
    if !root.master && root.s.bar: Rectangle {
        x: 0; y: 0; width: root.width + (root.s.bar-end ? 0 : 1 * root.u); height: 3 * root.u; background: root.s.bar-color;
    }
    // Name bar (track colour); a group's starts with its fold button.
    Rectangle {
        y: root.lanes-h; height: 20 * root.u;
        background: root.master ? Tokens.track-master : root.s.color;
        if !root.master && root.s.is-group: Rectangle {
            x: 0; y: 0; width: 20 * root.u; height: 20 * root.u;
            accessible-role: button;
            accessible-label: (root.s.folded ? "Expand " : "Collapse ") + root.s.name;
            opacity: fold-ta.has-hover ? 1 : 0.75;
            fold-ta := TouchArea { clicked => { Studio.group-fold(root.s.id); } }
            Icon {
                x: 5 * root.u; y: 5 * root.u; width: 10 * root.u; height: 10 * root.u; stroke-width: 1.4px;
                d: root.s.folded ? Icons.chevron-right : Icons.chevron-down; ink: root.s.color.darker(4.5);
            }
        }
        Text {
            x: (!root.master && root.s.is-group ? 20 : 8) * root.u; width: parent.width - self.x - 8 * root.u; text: root.master ? "Master" : root.s.name;
            color: root.master ? #111215 : root.s.color.darker(4.5); font-size: 12 * root.u; font-weight: 700;
            letter-spacing: -0.48 * root.u; vertical-alignment: center; overflow: elide;
        }
    }
    // Insert list: the empty "add insert" pill (plugin inserts are on the Devices tab).
    Rectangle {
        x: 8 * root.u; y: 28 * root.u + root.lanes-h; width: 92 * root.u; height: 20 * root.u; border-radius: 10 * root.u;
        background: #34353a;
        drop-shadow-offset-y: 0.75 * root.u; drop-shadow-blur: 3 * root.u; drop-shadow-color: #00000040;
        Rectangle { y: 0.38 * root.u; height: parent.height - 0.38 * root.u; border-radius: parent.border-radius; background: ins-ta.has-hover ? #2f3035 : #292a2f; }
        Text { text: "–"; color: ins-ta.has-hover ? #ffffff : #81838a; font-size: 10 * root.u; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
        ins-ta := TouchArea { clicked => { if (!root.master) { Studio.select-track(root.s.id); } Studio.set-bottom-tab(0); Studio.toggle-mixer(); } }
    }
    Rectangle { x: 8 * root.u; y: root.master ? root.gain-y : root.sends-y; width: 92 * root.u; height: 1 * root.u; background: #ffffff14; }
    // Sends: title + chevron (expands / collapses the Sends section of every strip) and "+"
    // (a new return track, silent on every strip). Return strips have no sends.
    if !root.master && !root.s.is-return: Rectangle {
        x: 8 * root.u; y: root.sends-y; width: 92 * root.u; height: 22 * root.u;
        Text { x: 2 * root.u; y: 5 * root.u; height: 14 * root.u; text: "Sends"; color: sends-ta.has-hover ? #ffffffb3 : #ffffff66; font-size: 10 * root.u; font-weight: 600; letter-spacing: -0.2 * root.u; vertical-alignment: center; }
        Icon { x: 35.5 * root.u; y: 7.5 * root.u; width: 9 * root.u; height: 9 * root.u; d: Studio.sends-open ? Icons.chevron-down : Icons.chevron-up; ink: sends-ta.has-hover ? #ffffffb3 : #ffffff66; stroke-width: 1.4px; }
        sends-ta := TouchArea {
            x: 0; width: 50 * root.u; clicked => { Studio.toggle-sends-open(); }
            accessible-role: button; accessible-label: Studio.sends-open ? "Collapse sends" : "Expand sends";
        }
        if Studio.can-add-return: Rectangle {
            x: parent.width - 16 * root.u; y: 5 * root.u; width: 16 * root.u; height: 14 * root.u;
            Icon { x: 3 * root.u; y: 2 * root.u; width: 10 * root.u; height: 10 * root.u; d: Icons.plus; ink: add-ta.has-hover ? #ffffff : #ffffffcc; stroke-width: 1.6px; }
            add-ta := TouchArea {
                clicked => { Studio.sends-add-return(root.s.id); }
                accessible-role: button; accessible-label: "Add return track";
            }
        }
        Rectangle { y: parent.height - 1 * root.u; height: 1 * root.u; background: #ffffff14; }
    }
    // Expanded Sends section: one row per return track, stacked upward from the Sends row (the
    // same rows on every strip, so they line up across strips). It
    // takes at most the room under the insert pill; more rows scroll with the wheel.
    if Studio.sends-open && !root.master && !root.s.is-return: sends-box := Rectangle {
        property <length> content-h: (Studio.strip-sends-max * 20 + 4) * root.u;
        property <length> max-scroll: max(0px, self.content-h - self.height);
        property <length> scroll: min(self.scroll-raw, self.max-scroll);
        property <length> scroll-raw: 0px;
        x: 8 * root.u; y: root.sends-y - self.height; width: 92 * root.u; height: min(self.content-h, max(0px, root.sends-y - 52 * root.u));
        clip: true;
        TouchArea {
            scroll-event(e) => {
                if (sends-box.max-scroll <= 0) { return reject; }
                sends-box.scroll-raw = max(0px, min(sends-box.max-scroll, sends-box.scroll - e.delta-y));
                accept
            }
            // Only this strip's rows (a contiguous range of strip-sends), not every strip's.
            for k in root.s.send-count: SendLine {
                r: Studio.strip-sends[root.s.send-first + k];
                x: 0; y: self.r.row * 20 * root.u - sends-box.scroll; width: parent.width;
            }
        }
        if sends-box.max-scroll > 0: Rectangle {
            x: parent.width - 2px; y: sends-box.scroll / sends-box.content-h * parent.height; width: 2px;
            height: parent.height * parent.height / sends-box.content-h; border-radius: 1px; background: #ffffff33;
        }
    }
    // Return strips: a "Return" caption where the Sends row sits on track and group strips.
    if root.s.is-return: Text {
        x: 10 * root.u; y: root.sends-y + 5 * root.u; height: 14 * root.u; text: "Return"; color: #ffffff4d; font-size: 10 * root.u; font-weight: 600; letter-spacing: -0.2 * root.u; vertical-alignment: center;
    }
    // Gain row: pan knob (32 pt cell, 5 pt in) and the gain readout pill.
    Knob {
        x: 13 * root.u + 16 * root.u - self.width / 2; y: root.gain-y + 26 * root.u - self.height / 2;
        width: 38px; height: 38px; body: 20.5px; groove: true; groove-color: #2d2e32; arc-color: #ffffff;
        value: root.s.pan; value-angle: root.master ? 0 : root.s.pan * 135; tick-color: #ffffff;
        value-changed(v) => { if (!root.master) { Studio.track-pan(root.s.id, v); } }
        released => { Studio.gesture-end(); }
        reset => { if (!root.master) { Studio.track-pan(root.s.id, 0); Studio.gesture-end(); } }
        context(x, y) => { if (!root.master) { Studio.strip-menu(root.s.id, 1, x, y - Studio.menu-dy); } }
    }
    StripReadout { x: 58 * root.u; y: root.gain-y + 17 * root.u; width: 40 * root.u; text: root.gain-text; }
    StripCanvas {
        x: 8 * root.u; y: root.canvas-y; height: 200 * root.u;
        fader: root.s.fader; meter-l: root.m.l; meter-r: root.m.r;
        fill: root.master ? Tokens.track-master : root.s.color;
        moved(f) => { if (root.master) { Studio.master-fader-moved(f); } else { Studio.mixer-fader(root.s.id, f); } }
        released => { Studio.gesture-end(); }
        reset => { if (root.master) { Studio.master-fader-moved(0.2); } else { Studio.mixer-fader(root.s.id, 0.2); } Studio.gesture-end(); }
        context(x, y) => { Studio.strip-menu(root.master ? -1 : root.s.id, 0, x, y - Studio.menu-dy); }
    }
    // Foot: M / S (master: M only), peak hold readout (click resets).
    StripButton {
        x: 16 * root.u; y: root.foot-y + 1 * root.u; text: "M"; kind: 0;
        on: root.master ? Studio.master-mute : root.s.mute;
        clicked => { if (root.master) { Studio.master-mute-toggle(); } else { Studio.track-mute(root.s.id); } }
        context(x, y) => { if (!root.master) { Studio.strip-menu(root.s.id, 2, x, y - Studio.menu-dy); } }
    }
    if !root.master: StripButton {
        x: 38 * root.u; y: root.foot-y + 1 * root.u; text: "S"; kind: 1;
        on: root.s.solo;
        clicked => { Studio.track-solo(root.s.id); }
    }
    StripReadout {
        x: 58 * root.u; y: root.foot-y; width: 40 * root.u; boxed: false; text: root.m.peak;
        ink: root.m.peak == "−∞" ? #ffffff4d : #ffffff99;
        clicked => { Studio.reset-peaks(); }
    }
    // Strip separator (1 pt rule on the right; the master strip has its rule on the left).
    Rectangle { x: root.master ? 0 : parent.width - 1 * root.u; y: 0; width: 1 * root.u; height: parent.height; background: #ffffff14; }
    // Return strips are their own group: a brighter divider before the first one.
    if root.s.group-start: Rectangle { x: 0; y: 0; width: 2 * root.u; height: parent.height; background: #5a5b60; }
}

export component MixerPanel inherits Panel {
    property <length> u: StripMetrics.u;
    property <length> strip-w: 108 * root.u;
    // Tabs: clicking either returns to the clip/devices view (closes the mixer).
    Text { x: 6px; y: 7px; height: 14px; text: "Clip"; color: #6c6d71; font-size: 10px; font-weight: 600; vertical-alignment: center;
        TouchArea { clicked => { Studio.toggle-mixer(); } } }
    Text { x: 31px; y: 7px; height: 14px; text: "Devices"; color: #6c6d71; font-size: 10px; font-weight: 600; vertical-alignment: center;
        TouchArea { clicked => { Studio.toggle-mixer(); } } }
    // Collapse the bottom panel to its tab row (or reopen it).
    IconButton { x: root.width - 29px; y: 3px; width: 21px; height: 21px; icon: Studio.bottom-collapsed ? Icons.upload : Icons.download; ink: #6b6c70; icon-size: 14px;
        tooltip: Studio.bottom-collapsed ? "Expand the bottom panel" : "Collapse the bottom panel"; clicked => { Studio.bottom-collapse-toggle(); } }
    Rectangle { x: 0; y: 26.5px; width: root.width; height: 0.5px; background: Tokens.line-separator; }

    // Strips + "Add track" column, scrolled horizontally when they don't fit.
    strips := Rectangle {
        x: 0; y: 26.5px; width: root.width - root.strip-w; height: root.height - 26.5px;
        clip: true;
        property <length> content-w: Studio.strip-columns * root.strip-w + root.strip-w;
        property <length> max-scroll: max(0px, self.content-w - self.width);
        property <length> scroll: 0px;
        TouchArea {
            scroll-event(e) => {
                parent.scroll = max(0px, min(parent.max-scroll, parent.scroll - e.delta-x - e.delta-y));
                accept
            }
        }
        for st[i] in Studio.strips: Strip {
            visible: !st.hidden;
            // A muted group dims its tracks' strips.
            opacity: st.group-muted ? (st.selected ? 0.55 : 0.4) : 1;
            x: st.column * root.strip-w - parent.scroll; y: 0; height: parent.height;
            s: st; m: Studio.strip-meters[i]; gain-text: st.gain-text;
        }
        add-col := Rectangle {
            x: Studio.strip-columns * root.strip-w - parent.scroll; y: 0; width: root.strip-w; height: parent.height;
            property <color> ink: add-ta.has-hover ? #ffffffb3 : #ffffff66;
            Icon { x: (parent.width - 13px) / 2; y: parent.height / 2 - 14 * root.u; width: 13px; height: 13px; d: Icons.plus; ink: add-col.ink; stroke-width: 1.4px; }
            Text { x: 0; y: parent.height / 2 + 1 * root.u; width: parent.width; height: 16 * root.u; text: "Add track"; color: add-col.ink; font-size: 12 * root.u; font-weight: 700;
                letter-spacing: -0.48 * root.u; horizontal-alignment: center; vertical-alignment: center; }
            add-ta := TouchArea { clicked => { Studio.open-add-track-menu(self.absolute-position.x + (parent.width - 120px) / 2, (self.absolute-position.y - Studio.menu-dy) + parent.height / 2 + 18 * root.u); } }
        }
        // Horizontal scroll indicator (only when strips overflow)
        if strips.max-scroll > 0: Rectangle {
            x: strips.scroll / strips.content-w * strips.width; y: strips.height - 4px;
            width: strips.width * strips.width / strips.content-w; height: 2.5px; border-radius: 1.25px; background: #3a3b3f;
        }
    }
    // Not while the panel is shut to its tab row: the strip's controls would spill over the header
    // (and its collapse button) above it.
    if !Studio.bottom-collapsed: Strip {
        x: root.width - root.strip-w; y: 26.5px; height: root.height - 26.5px; master: true;
        s: { id: -1, name: "Master", color: Tokens.track-master, fader: Studio.master-fader, pan-text: "0.0" };
        m: { l: Studio.master-meter-l, r: Studio.master-meter-r, peak: Studio.master-peak-text };
        gain-text: Studio.master-gain-text;
    }
}
