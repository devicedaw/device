// Export dialog and the unsaved-changes prompt (src/dialogs.rs). Geometry of the
// export and unsaved-changes modals at 100 % zoom, in our 85 % units (520 x 400.5 pt export
// window centred in the main window; 440 x 149 pt prompt at x 515, y 347 over the timeline).
import { Tokens } from "tokens.slint";
import { Icon, Icons, Switch } from "widgets.slint";
import { Studio } from "studio.slint";
import { ChoiceList } from "settings.slint";

global DialogTokens {
    out property <color> surface: #232426;
    out property <color> pill: #292a2f;
    out property <color> pill-text: #d0d0d1;
    out property <color> label: #818389;
    out property <color> accent: #2752f5;
    out property <color> rule: #2c2c2e;
}

component PillButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    in property <length> font-size: 10.2px;
    callback clicked();
    preferred-width: label.preferred-width + 27.2px;
    border-radius: self.height / 2;
    background: root.primary ? (ta.has-hover ? #2a66ff : DialogTokens.accent) : (ta.has-hover ? #2e2f34 : DialogTokens.pill);
    drop-shadow-blur: 2.5px; drop-shadow-offset-y: 0.65px; drop-shadow-color: #00000040;
    accessible-role: button; accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    label := Text { text: root.text; color: root.primary ? #ffffff : DialogTokens.pill-text; font-size: root.font-size; font-weight: 600; letter-spacing: -0.2px; horizontal-alignment: center; vertical-alignment: center; }
    ta := TouchArea { clicked => { root.clicked(); } }
}

// Two-option segmented control; `index` is the selected option.
component Segments inherits Rectangle {
    in property <string> a;
    in property <string> b;
    in property <length> a-w;
    in property <int> index;
    callback picked(int);
    height: 18.7px; border-radius: self.height / 2; background: DialogTokens.pill;
    for t[i] in [root.a, root.b]: Rectangle {
        x: i == 0 ? 1.7px : 1.7px + root.a-w; y: 1.7px; width: i == 0 ? root.a-w : root.width - 3.4px - root.a-w; height: parent.height - 3.4px;
        border-radius: self.height / 2; background: root.index == i ? DialogTokens.accent : transparent;
        accessible-role: tab; accessible-label: t; accessible-checked: root.index == i;
        Text { text: t; color: root.index == i ? #ffffff : #a6a8ac; font-size: 10.2px; font-weight: 600; letter-spacing: -0.2px; horizontal-alignment: center; vertical-alignment: center; }
        TouchArea { clicked => { root.picked(i); } }
    }
}

component RowLabel inherits Text {
    height: 20.4px; color: DialogTokens.label; font-size: 10.2px; font-weight: 600; letter-spacing: -0.4px; vertical-alignment: center;
}

// Export (File › Export…, ⇧⌘E). Mixdown and Stems render to WAV, Project writes an Ableton
// Live set (Open in + Effects rows in place of Range + Format; Effects is always Render, Convert
// is a PLACEHOLDER). WAV or MP3 (the second segments are the bit depth for WAV, the bitrate
// for MP3); 44.1 / 48 kHz sets the file's rate
// (converted from the engine's). Range is the full project (plus a tail) or the loop region
// (exactly, so the file loops). Stems adds
// the Tracks row above Range (one form row, 30.6px: 24 pt rows 12 pt apart); the
// window keeps its height.
export component ExportModal inherits Rectangle {
    property <length> dy: Studio.export-recipe == 1 ? 30.6px : 0px;
    width: 442px; height: 340.4px;
    border-radius: 10.2px; background: DialogTokens.surface;
    border-width: 0.5px; border-color: #ffffff12;
    drop-shadow-blur: 21px; drop-shadow-offset-y: 6.8px; drop-shadow-color: #00000080;
    accessible-role: groupbox; accessible-label: "Export";
    TouchArea { }
    // ---- header ----
    Icon { x: 17px; y: 15.3px; width: 13.6px; height: 13.6px; d: Icons.download; ink: #ffffff; stroke-width: 1.4px; }
    Text { x: 37.4px; y: 12.4px; height: 19.4px; text: "Export"; color: #ffffff; font-size: 13.6px; font-weight: 700; letter-spacing: -0.54px; vertical-alignment: center; }
    Rectangle {
        x: root.width - 17px - 13.6px; y: 15.3px; width: 13.6px; height: 13.6px; border-radius: 6.8px;
        accessible-role: button; accessible-label: "Close";
        Icon { x: 2.3px; y: 2.3px; width: 9px; height: 9px; d: Icons.close; ink: close-ta.has-hover ? #ffffff : #bebebe; stroke-width: 1.4px; }
        close-ta := TouchArea { clicked => { Studio.export-close(); } }
    }
    // ---- recipes ----
    for r[i] in [
        { name: "Mixdown", value: Studio.export-recipe-text },
        { name: "Stems", value: Studio.export-stems-text },
        { name: "Project", value: "Ableton Live" },
    ]: Rectangle {
        x: 17px + i * (131.47px + 6.8px); y: 44.2px; width: 131.47px; height: 44.2px; border-radius: 8.5px;
        background: i == Studio.export-recipe ? DialogTokens.accent : (rta.has-hover ? #2e2f34 : DialogTokens.pill);
        accessible-role: tab; accessible-label: r.name; accessible-checked: i == Studio.export-recipe;
        Text { x: 10.2px; y: 7.9px; height: 13.6px; text: r.name; color: i == Studio.export-recipe ? #ffffff : DialogTokens.pill-text; font-size: 10.2px; font-weight: 600; letter-spacing: -0.4px; vertical-alignment: center; }
        Text { x: 10.2px; y: 23.4px; height: 11.9px; text: r.value; color: i == Studio.export-recipe ? #ffffffb8 : #d0d0d1b8; font-size: 9.35px; font-weight: 500; letter-spacing: -0.19px; vertical-alignment: center; }
        rta := TouchArea { clicked => { Studio.export-pick-recipe(i); } }
    }
    // ---- form ----
    if Studio.export-recipe == 1: RowLabel { x: 17px; y: 105.4px; text: "Tracks"; }
    if Studio.export-recipe == 1: Rectangle {
        x: 71.4px; y: 105.4px; width: tracks-text.preferred-width + 11.9px + 22.1px; height: 20.4px; border-radius: 10.2px;
        background: tracks-ta.has-hover || Studio.export-tracks-menu-open ? #2e2f34 : DialogTokens.pill;
        accessible-role: combobox; accessible-label: "Tracks"; accessible-value: Studio.export-tracks-label;
        tracks-text := Text { x: 11.9px; text: Studio.export-tracks-label; color: DialogTokens.pill-text; font-size: 10.2px; font-weight: 600; letter-spacing: -0.4px; vertical-alignment: center; }
        Icon { x: parent.width - 18.7px; y: 6.2px; width: 8px; height: 8px; d: Icons.chevron-down; ink: DialogTokens.label; stroke-width: 1.4px; }
        tracks-ta := TouchArea { clicked => { Studio.export-toggle-tracks(); } }
    }
    if Studio.export-recipe == 2: RowLabel { x: 17px; y: 105.4px; text: "Open in"; }
    if Studio.export-recipe == 2: Text { x: 71.4px; y: 105.4px; height: 20.4px; text: "Ableton Live"; color: #e5e5e8; font-size: 10.2px; font-weight: 600; letter-spacing: -0.4px; vertical-alignment: center; }
    if Studio.export-recipe == 2: RowLabel { x: 17px; y: 136px; text: "Effects"; }
    if Studio.export-recipe == 2: Rectangle {
        x: 71.4px; y: 136px; width: fx-text.preferred-width + 11.9px + 22.1px; height: 20.4px; border-radius: 10.2px;
        background: fx-ta.has-hover ? #2e2f34 : DialogTokens.pill;
        accessible-role: combobox; accessible-label: "DStudio effects"; accessible-value: "Render";
        fx-text := Text { x: 11.9px; text: "Render"; color: DialogTokens.pill-text; font-size: 10.2px; font-weight: 600; letter-spacing: -0.4px; vertical-alignment: center; }
        Icon { x: parent.width - 18.7px; y: 6.2px; width: 8px; height: 8px; d: Icons.chevron-down; ink: DialogTokens.label; stroke-width: 1.4px; }
        fx-ta := TouchArea { clicked => { Studio.chat-placeholder("Convert effects to Live devices"); } }
    }
    if Studio.export-recipe != 2: RowLabel { x: 17px; y: 105.4px + root.dy; text: "Range"; }
    if Studio.export-recipe != 2: Rectangle {
        x: 71.4px; y: 105.4px + root.dy; width: range-text.preferred-width + 11.9px + 22.1px; height: 20.4px; border-radius: 10.2px;
        background: range-ta.has-hover || Studio.export-range-menu-open ? #2e2f34 : DialogTokens.pill;
        accessible-role: combobox; accessible-label: "Range"; accessible-value: Studio.export-range-label;
        accessible-action-default => { Studio.export-toggle-range(); }
        range-text := Text { x: 11.9px; text: Studio.export-range-label; color: DialogTokens.pill-text; font-size: 10.2px; font-weight: 600; letter-spacing: -0.4px; vertical-alignment: center; }
        Icon { x: parent.width - 18.7px; y: 6.2px; width: 8px; height: 8px; d: Icons.chevron-down; ink: DialogTokens.label; stroke-width: 1.4px; }
        range-ta := TouchArea { clicked => { Studio.export-toggle-range(); } }
        // The bars the range covers, beside the picker.
        Text { x: parent.width + 8.5px; height: 20.4px; text: Studio.export-bars-text; color: DialogTokens.label; font-size: 10.2px; font-weight: 600; letter-spacing: -0.4px; vertical-alignment: center; }
    }
    if Studio.export-recipe != 2: RowLabel { x: 17px; y: 136px + root.dy; text: "Format"; }
    if Studio.export-recipe != 2: Segments { x: 71.4px; y: 136.85px + root.dy; width: 85.9px; a: "WAV"; b: "MP3"; a-w: 40px; index: Studio.export-mp3 ? 1 : 0; picked(i) => { Studio.export-format(i == 1); } }
    if Studio.export-recipe != 2: Segments { x: 71.4px + 91.8px; y: 136.85px + root.dy; width: 97.3px; a: Studio.export-mp3 ? "192k" : "16-bit"; b: Studio.export-mp3 ? "320k" : "24-bit"; a-w: 48.4px;
        index: (Studio.export-mp3 ? Studio.export-kbps-high : Studio.export-bits24) ? 1 : 0;
        picked(i) => { if (Studio.export-mp3) { Studio.export-kbps(i == 1); } else { Studio.export-bits(i == 1); } }
    }
    if Studio.export-recipe != 2: Segments {
        x: 71.4px + 197.7px; y: 136.85px + root.dy; width: 117.3px; a: "44.1 kHz"; b: "48 kHz"; a-w: 56.3px; index: Studio.export-rate48 ? 1 : 0;
        picked(i) => { Studio.export-rate(i == 1); }
    }
    Rectangle { x: 17px; y: 170px + root.dy; width: root.width - 34px; height: 0.45px; background: DialogTokens.rule; }
    RowLabel { x: 17px; y: 184.2px + root.dy; text: Studio.export-name-label; }
    Rectangle {
        x: 71.4px; y: 184.2px + root.dy; width: root.width - 17px - 71.4px; height: 20.4px; border-radius: 6.8px; background: DialogTokens.pill;
        border-width: 0.3px; border-color: name-in.has-focus ? DialogTokens.accent : #ffffff17;
        name-in := TextInput {
            x: 10.2px; width: parent.width - 20.4px; height: parent.height; text: Studio.export-name; color: #ffffff;
            font-size: 9.35px; font-weight: 500; letter-spacing: -0.28px; vertical-alignment: center; single-line: true;
            edited => { Studio.export-name-edited(self.text); }
        }
    }
    RowLabel { x: 17px; y: 214.8px + root.dy; text: "Save in"; }
    Rectangle {
        x: 71.4px; y: 214.8px + root.dy; width: 279.7px; height: 20.4px; border-radius: 6.8px; background: DialogTokens.pill;
        border-width: 0.3px; border-color: #ffffff17;
        Text { x: 10.2px; width: parent.width - 20.4px; text: Studio.export-dir; color: #ffffff; font-size: 9.35px; font-weight: 500; letter-spacing: -0.28px; vertical-alignment: center; overflow: elide; }
    }
    PillButton { x: root.width - 17px - 65.1px; y: 214.8px + root.dy; width: 65.1px; height: 20.4px; text: "Choose..."; clicked => { Studio.export-choose-dir(); } }
    // ---- footer ----
    Rectangle { x: 0; y: root.height - 57.8px; width: root.width; height: 0.45px; background: DialogTokens.rule; }
    size-label := Text { visible: Studio.export-recipe != 2; x: 17px; y: root.height - 57.8px + 13.6px + 4.25px; height: 13.6px; text: Studio.export-recipe == 1 ? Studio.export-files-text : "Size"; color: DialogTokens.label; font-size: 10.2px; font-weight: 600; letter-spacing: -0.4px; vertical-alignment: center; }
    Text { visible: Studio.export-recipe != 2; x: 17px + max(25.5px, size-label.preferred-width + 6.8px); y: root.height - 57.8px + 13.6px + 4.25px; height: 13.6px; text: Studio.export-estimate; color: #e5e5e8; font-size: 10.2px; font-weight: 600; letter-spacing: -0.4px; vertical-alignment: center; }
    PillButton { x: root.width - 17px - 52.2px - 6.8px - 46.75px; y: root.height - 57.8px + 16.15px; width: 46.75px; height: 22.1px; text: "Close"; clicked => { Studio.export-close(); } }
    PillButton { x: root.width - 17px - 52.2px; y: root.height - 57.8px + 16.15px; width: 52.2px; height: 22.1px; text: "Export"; primary: true; clicked => { Studio.export-run(); } }
    // Tracks menu (click outside closes it), below the picker.
    if Studio.export-tracks-menu-open: Rectangle {
        TouchArea { clicked => { Studio.export-toggle-tracks(); } }
        ChoiceList {
            x: 71.4px; y: 105.4px + 20.4px + 3.4px; width: 170px; height: Studio.export-tracks-menu-h;
            items: Studio.export-tracks-items;
            picked(i) => { Studio.export-pick-tracks(i); }
        }
    }
    // Range menu (click outside closes it): Full project, Loop region (dimmed when there is none).
    if Studio.export-range-menu-open: Rectangle {
        TouchArea { clicked => { Studio.export-toggle-range(); } }
        ChoiceList {
            x: 71.4px; y: 105.4px + root.dy + 20.4px + 3.4px; width: 130px; height: Studio.export-range-menu-h;
            items: Studio.export-range-items;
            picked(i) => { Studio.export-pick-range(i); }
        }
    }
}

// "Save changes?" before File › New Project (⌘N) or Import Ableton Live Set… replaces a
// project with unsaved changes.
export component UnsavedPrompt inherits Rectangle {
    width: 374px; height: 126.6px;
    border-radius: 10.2px; background: Tokens.bg-panel;
    drop-shadow-blur: 21px; drop-shadow-offset-y: 6.8px; drop-shadow-color: #00000080;
    accessible-role: groupbox; accessible-label: "Save changes?";
    TouchArea { }
    Text { x: 20.4px; y: 16.3px; height: 16.3px; text: "Save changes?"; color: #ffffff; font-size: 13.6px; font-weight: 700; letter-spacing: -0.54px; vertical-alignment: center; }
    Text {
        x: 20.4px; y: 37.4px; width: root.width - 40.8px; height: 27.2px; wrap: word-wrap;
        text: "Your current project has unsaved changes. Would you like to save your changes?";
        color: #c8c9cc; font-size: 10.2px; font-weight: 500; letter-spacing: -0.2px; vertical-alignment: top;
    }
    PillButton { x: root.width - 20.4px - 51.4px - 6.8px - 78.2px - 6.8px - 60.9px; y: 79px; width: 60.9px; height: 27.2px; text: "Cancel"; clicked => { Studio.unsaved-cancel(); } }
    PillButton { x: root.width - 20.4px - 51.4px - 6.8px - 78.2px; y: 79px; width: 78.2px; height: 27.2px; text: "Don't Save"; clicked => { Studio.unsaved-dont-save(); } }
    PillButton { x: root.width - 20.4px - 51.4px; y: 79px; width: 51.4px; height: 27.2px; text: "Save"; primary: true; clicked => { Studio.unsaved-save(); } }
}

// Options › Check for Updates…. A modal (400 pt wide, 24 pt corners, 20 pt padding, 16 pt
// title, 12 pt body, 32 pt pill buttons); DStudio has no update server yet, so the
// dialog reports the running version with an OK button.
export component UpdatesModal inherits Rectangle {
    width: 340px; height: 132.6px;
    border-radius: 20.4px; background: DialogTokens.surface;
    border-width: 0.45px; border-color: #ffffff22;
    drop-shadow-blur: 21px; drop-shadow-offset-y: 6.8px; drop-shadow-color: #00000080;
    accessible-role: groupbox; accessible-label: "Check for updates";
    TouchArea { }
    Text { x: 17px; y: 17px; height: 13.6px; text: "Check for updates"; color: #ffffff; font-size: 13.6px; font-weight: 700; letter-spacing: -0.54px; vertical-alignment: center; }
    Rectangle {
        x: root.width - 17px - 13.6px; y: 17px; width: 13.6px; height: 13.6px;
        accessible-role: button; accessible-label: "Close";
        accessible-action-default => { Studio.updates-close(); }
        Icon { width: parent.width; height: parent.height; d: Icons.close; stroke-width: 1.1px; ink: close-ta.has-hover ? #ffffffb3 : #ffffff8c; }
        close-ta := TouchArea { clicked => { Studio.updates-close(); } }
    }
    Text {
        x: 17px; y: 40.8px; width: root.width - 34px; height: 30.6px; wrap: word-wrap;
        text: "You're running Device v\{Studio.app-version}. There's no update server yet, so new versions arrive as new builds.";
        color: #c8c9cc; font-size: 10.2px; font-weight: 500; letter-spacing: -0.2px; vertical-alignment: top;
    }
    PillButton { x: root.width - 17px - 40.8px; y: root.height - 17px - 27.2px; width: 40.8px; height: 27.2px; text: "OK"; primary: true; clicked => { Studio.updates-close(); } }
}

// "Change project key?" when a project with a key and MIDI clips gets a new key. The same
// alert modal as Check for Updates (400 pt wide, 24 pt corners, 20 pt padding, 16 pt title,
// 12 pt body, 32 pt pill buttons 8 pt apart, 16 pt side padding); Transpose MIDI is primary.
export component KeyChangeModal inherits Rectangle {
    width: 340px; height: 132.6px;
    border-radius: 20.4px; background: DialogTokens.surface;
    border-width: 0.45px; border-color: #ffffff22;
    drop-shadow-blur: 21px; drop-shadow-offset-y: 6.8px; drop-shadow-color: #00000080;
    accessible-role: groupbox; accessible-label: "Change project key?";
    TouchArea { }
    Text { x: 17px; y: 17px; height: 13.6px; text: "Change project key?"; color: #ffffff; font-size: 13.6px; font-weight: 700; letter-spacing: -0.54px; vertical-alignment: center; }
    Text {
        x: 17px; y: 40.8px; width: root.width - 34px; height: 30.6px; wrap: word-wrap;
        text: Studio.key-change-text;
        color: #c8c9cc; font-size: 10.2px; font-weight: 500; letter-spacing: -0.2px; vertical-alignment: top;
    }
    transpose := PillButton { x: root.width - 17px - self.width; y: root.height - 17px - 27.2px; width: self.preferred-width; height: 27.2px; text: "Transpose MIDI"; primary: true; clicked => { Studio.key-change-choose(2); } }
    keep := PillButton { x: transpose.x - 6.8px - self.width; y: transpose.y; width: self.preferred-width; height: 27.2px; text: "Don’t transpose"; clicked => { Studio.key-change-choose(1); } }
    PillButton { x: keep.x - 6.8px - self.width; y: transpose.y; width: self.preferred-width; height: 27.2px; text: "Cancel"; clicked => { Studio.key-change-choose(0); } }
}

component HistoryButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled;
    callback clicked();
    width: label.preferred-width + 27.2px; height: 27.2px; border-radius: 13.6px;
    background: ta.has-hover && root.enabled ? #ffffff1f : #ffffff14;
    accessible-role: button; accessible-label: root.text; accessible-enabled: root.enabled;
    label := Text { text: root.text; color: root.enabled ? #e5e5e8 : #ffffff4d; font-size: 10.2px; font-weight: 700; letter-spacing: -0.41px; horizontal-alignment: center; vertical-alignment: center; }
    ta := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
}

// Edit › Undo History…. A modal: 640 pt wide, 20/20/16 pt padding, 14 pt between head,
// table and buttons; 28 pt rows (Number 56 pt right-aligned, Action, Date 108 pt, Time 92 pt,
// 12 pt gaps, 10 pt side padding), the list at most 60 % of the window tall. A click on a row
// undoes or redoes up to it; Undo and Redo step once.
export component UndoHistoryModal inherits Rectangle {
    in property <length> max-h;
    property <length> row-h: 23.8px;
    property <length> list-h: min(Studio.undo-history-rows.length * self.row-h, (root.max-h + 81.6px) * 0.6, root.max-h - 113.9px);
    width: 544px; height: 17px + 17px + 11.9px + self.row-h + self.list-h + 11.9px + 27.2px + 13.6px;
    border-radius: 20.4px; background: DialogTokens.surface;
    border-width: 0.45px; border-color: #ffffff22;
    drop-shadow-blur: 21px; drop-shadow-offset-y: 6.8px; drop-shadow-color: #00000080;
    accessible-role: groupbox; accessible-label: "Undo history";
    TouchArea { }
    Text { x: 17px; y: 17px; height: 17px; text: "Undo history"; color: #ffffff; font-size: 13.6px; font-weight: 700; letter-spacing: -0.54px; vertical-alignment: center; }
    Rectangle {
        x: root.width - 17px - 20.4px + 3.4px; y: 17px + (17px - 20.4px) / 2; width: 20.4px; height: 20.4px; border-radius: 3.4px;
        accessible-role: button; accessible-label: "Close";
        Text { text: "×"; color: close-ta.has-hover ? #ffffffb3 : #ffffff8c; font-size: 17px; horizontal-alignment: center; vertical-alignment: center; }
        close-ta := TouchArea { clicked => { Studio.undo-history-close(); } }
    }
    // Header row with its rule.
    Rectangle {
        x: 17px; y: 45.9px; width: root.width - 34px; height: root.row-h;
        for c[i] in [{ t: "Number", x: 8.5px, w: 47.6px, right: true }, { t: "Action", x: 66.3px, w: root.width - 34px - 66.3px - 8.5px - 78.2px - 10.2px - 91.8px - 10.2px, right: false }, { t: "Date", x: root.width - 34px - 8.5px - 78.2px - 10.2px - 91.8px, w: 91.8px, right: false }, { t: "Time", x: root.width - 34px - 8.5px - 78.2px, w: 78.2px, right: false }]: Text {
            x: c.x; width: c.w; text: c.t; color: #ffffff66; font-size: 10.2px; font-weight: 700; letter-spacing: -0.41px;
            horizontal-alignment: c.right ? right : left; vertical-alignment: center;
        }
        Rectangle { y: parent.height - 1px; height: 1px; background: #ffffff14; }
    }
    Flickable {
        x: 17px; y: 45.9px + root.row-h; width: root.width - 34px; height: root.list-h;
        content-height: Studio.undo-history-rows.length * root.row-h;
        for r[i] in Studio.undo-history-rows: Rectangle {
            y: i * root.row-h; height: root.row-h; border-radius: 5.1px;
            background: r.state == 1 ? #ffffff1f : (ta.has-hover ? #ffffff12 : transparent);
            property <color> ink: r.state == 1 ? #ffffff : (r.state == 2 ? #ffffff59 : #e5e5e8);
            property <color> dim: r.state == 2 ? #ffffff59 : #ffffff66;
            accessible-role: list-item; accessible-label: r.label; accessible-checked: r.state == 1;
            Text { x: 8.5px; width: 47.6px; text: r.number; color: parent.ink; font-size: 10.2px; font-weight: 700; letter-spacing: -0.41px; horizontal-alignment: right; vertical-alignment: center; }
            Text { x: 66.3px; width: parent.width - 66.3px - 8.5px - 78.2px - 10.2px - 91.8px - 10.2px; text: r.label; color: parent.ink; font-size: 10.2px; font-weight: 700; letter-spacing: -0.41px; overflow: elide; vertical-alignment: center; }
            Text { x: parent.width - 8.5px - 78.2px - 10.2px - 91.8px; width: 91.8px; text: r.date; color: parent.dim; font-size: 10.2px; font-weight: 700; letter-spacing: -0.41px; vertical-alignment: center; }
            Text { x: parent.width - 8.5px - 78.2px; width: 78.2px; text: r.time; color: parent.dim; font-size: 10.2px; font-weight: 700; letter-spacing: -0.41px; vertical-alignment: center; }
            ta := TouchArea { clicked => { Studio.undo-history-travel(i); } }
        }
    }
    redo := HistoryButton { x: root.width - 17px - self.width; y: root.height - 13.6px - 27.2px; text: "Redo"; enabled: Studio.can-redo; clicked => { Studio.undo-history-travel(Studio.undo-history-current + 1); } }
    HistoryButton { x: redo.x - 6.8px - self.width; y: redo.y; text: "Undo"; enabled: Studio.can-undo; clicked => { Studio.undo-history-travel(Studio.undo-history-current - 1); } }
}

// Text field of the feedback form: 6.8 pt corners, accent border while focused, a grey
// placeholder while empty. Multi-line fields wrap and scroll inside their box.
component FormField inherits Rectangle {
    in property <string> placeholder;
    in property <bool> multi-line;
    in-out property <string> text;
    callback accepted();
    border-radius: 6.8px; background: DialogTokens.pill; clip: true;
    border-width: 0.5px; border-color: input.has-focus ? DialogTokens.accent : #ffffff17;
    public function focus-input() { input.focus(); }
    input := TextInput {
        x: 10.2px; y: root.multi-line ? 7.65px : 0px;
        width: parent.width - 20.4px; height: root.multi-line ? parent.height - 15.3px : parent.height;
        text <=> root.text;
        single-line: !root.multi-line; wrap: root.multi-line ? word-wrap : no-wrap;
        color: #ffffff; font-size: 10.2px; font-weight: 500; letter-spacing: -0.2px;
        vertical-alignment: root.multi-line ? top : center;
        accessible-label: root.placeholder;
        key-pressed(e) => {
            if (!root.multi-line && e.text == Key.Return) { root.accepted(); return accept; }
            reject
        }
    }
    if root.text == "": Text {
        x: input.x; y: input.y; width: input.width; height: root.multi-line ? 13.6px : input.height;
        text: root.placeholder; color: #ffffff59; font-size: 10.2px; font-weight: 500; letter-spacing: -0.2px;
        vertical-alignment: center; overflow: elide;
    }
}

// "Report a bug" / "Share your feedback" (top bar). The alert-modal look (24 pt corners,
// 20 pt padding, 16 pt title, 12 pt body, 32 pt pill buttons). System info is opt-in per
// report and shown exactly as it will be sent.
export component FeedbackModal inherits Rectangle {
    property <length> pad: 17px;
    property <length> preview-h: Studio.feedback-system ? 64.6px : 0px;
    property <bool> can-send: !Studio.feedback-sending && Studio.feedback-message != "";
    width: 400px; height: 323px + root.preview-h + (Studio.feedback-error != "" ? 17px : 0px);
    border-radius: 20.4px; background: DialogTokens.surface;
    border-width: 0.45px; border-color: #ffffff22;
    drop-shadow-blur: 21px; drop-shadow-offset-y: 6.8px; drop-shadow-color: #00000080;
    accessible-role: groupbox; accessible-label: Studio.feedback-bug ? "Report a bug" : "Share your feedback";
    init => { message.focus-input(); }
    TouchArea { }
    Text { x: root.pad; y: 17px; height: 13.6px; text: Studio.feedback-bug ? "Report a bug" : "Share your feedback"; color: #ffffff; font-size: 13.6px; font-weight: 700; letter-spacing: -0.54px; vertical-alignment: center; }
    Rectangle {
        x: root.width - 17px - 13.6px; y: 17px; width: 13.6px; height: 13.6px;
        accessible-role: button; accessible-label: "Close";
        accessible-action-default => { Studio.feedback-close(); }
        Icon { width: parent.width; height: parent.height; d: Icons.close; stroke-width: 1.1px; ink: close-ta.has-hover ? #ffffffb3 : #ffffff8c; }
        close-ta := TouchArea { clicked => { Studio.feedback-close(); } }
    }
    Text {
        x: root.pad; y: 40.8px; width: root.width - 2 * root.pad; height: 27.2px; wrap: word-wrap;
        text: Studio.feedback-bug
            ? "What happened, and what did you expect? Steps to make it happen again help a lot."
            : "What do you like, what gets in your way, and what would you like next?";
        color: #c8c9cc; font-size: 10.2px; font-weight: 500; letter-spacing: -0.2px; vertical-alignment: top;
    }
    message := FormField {
        x: root.pad; y: 74.8px; width: root.width - 2 * root.pad; height: 112.2px;
        multi-line: true;
        placeholder: Studio.feedback-bug ? "Describe the bug" : "Your feedback";
        text <=> Studio.feedback-message;
    }
    RowLabel { x: root.pad; y: 197.2px; text: "Email"; }
    FormField {
        x: root.pad + 51px; y: 197.2px; width: root.width - 2 * root.pad - 51px; height: 20.4px;
        placeholder: "Optional, only if you'd like a reply";
        text <=> Studio.feedback-email;
        accepted => { if (root.can-send) { Studio.feedback-send(Studio.feedback-message, Studio.feedback-email); } }
    }
    // System info switch, then a preview of what it adds.
    Switch { x: root.pad; y: 233.75px; on: Studio.feedback-system; toggled => { Studio.feedback-toggle-system(); }
        accessible-role: checkbox; accessible-label: "Include system info"; accessible-checked: Studio.feedback-system;
        accessible-action-default => { Studio.feedback-toggle-system(); }
    }
    Text {
        x: root.pad + 27.2px; y: 229.5px; height: 19.4px; text: "Include system info and recent activity";
        color: DialogTokens.pill-text; font-size: 10.2px; font-weight: 600; letter-spacing: -0.4px; vertical-alignment: center;
        TouchArea { clicked => { Studio.feedback-toggle-system(); } }
    }
    if Studio.feedback-system: Rectangle {
        x: root.pad; y: 256.7px; width: root.width - 2 * root.pad; height: root.preview-h - 6.8px;
        border-radius: 6.8px; background: #1c1d1f; clip: true;
        Text {
            x: 8.5px; y: 6.8px; width: parent.width - 17px; height: parent.height - 13.6px;
            text: Studio.feedback-system-text; wrap: word-wrap; overflow: elide;
            color: DialogTokens.label; font-size: 8.5px; font-weight: 500; vertical-alignment: top;
        }
    }
    if Studio.feedback-error != "": Text {
        x: root.pad; y: 256.7px + root.preview-h; width: root.width - 2 * root.pad; height: 13.6px;
        text: Studio.feedback-error; color: #ff7a6b; font-size: 10.2px; font-weight: 600; letter-spacing: -0.2px; vertical-alignment: center; overflow: elide;
    }
    Text {
        x: root.pad; y: root.height - 17px - 27.2px; width: 170px; height: 27.2px; wrap: word-wrap;
        text: "Sent to the Device team. Your email is never shown publicly.";
        color: DialogTokens.label; font-size: 8.5px; font-weight: 500; letter-spacing: -0.17px; vertical-alignment: center;
    }
    send := PillButton {
        x: root.width - 17px - self.width; y: root.height - 17px - 27.2px; width: max(54.4px, self.preferred-width); height: 27.2px;
        text: Studio.feedback-sending ? "Sending…" : "Send"; primary: true;
        opacity: root.can-send || Studio.feedback-sending ? 1 : 0.5;
        clicked => { if (root.can-send) { Studio.feedback-send(Studio.feedback-message, Studio.feedback-email); } }
    }
    PillButton { x: send.x - 6.8px - self.width; y: send.y; width: self.preferred-width; height: 27.2px; text: "Cancel"; clicked => { Studio.feedback-close(); } }
}
