// Studio global: the single bridge between Rust and the Slint UI, plus the
// view-model structs. Everything here is pushed from Rust (no authoritative
// state in the UI); edits leave through the callbacks.
import { Tokens } from "tokens.slint";

export struct TrackRow {
    id: int,
    number: int,
    // Return tracks (src/routing.rs): lettered A, B, C ... instead of numbered.
    is-return: bool,
    letter: string,
    // Group tracks (src/groups.rs): a group row (fold chevron, no R), its folded state, and
    // rows of tracks inside a group (indented).
    is-group: bool,
    folded: bool,
    in-group: bool,
    group-color: color,  // a track in a group: the group's colour (its rail)
    group-muted: bool,   // a track in a muted group: drawn dimmed
    pinned: bool,       // drawn in the pinned band above the master row (y relative to it)
    name: string,
    instrument: bool,
    color: color,
    selected: bool,
    mute: bool,
    solo: bool,
    arm: bool,
    monitor: bool,
    volume-pos: float,
    pan: float,
    // Automation (src/automation.rs): content y and total height (expanded lanes add rows),
    // the shown parameter (category + name), its lane state (0 none/inactive, 1 active,
    // 2 disabled) and colour (the parameter's bright hue, Hue in src/automation.rs),
    // the "Show N automated lanes" count, and controls following automation.
    y: length,
    h: length,
    // Track row height without its 0.5 pt rule (height scale × 88 px row; src/timeline.rs).
    row-h: length,
    auto-cat: string,
    auto-param: string,
    auto-state: int,
    auto-accent: color,
    auto-count: int,
    auto-expanded: bool,
    vol-auto: bool,
    pan-auto: bool,
}

// Track-header meter: 0 (silent, below -50 dB) .. 1 (0 dB), clip latched.
export struct TrackLevel { l: float, r: float, clip: bool }

// Value label at the left of an automation row (lane-local). state, accent, dim: as TrackRow.auto-*.
export struct AutoLabel { x: length, y: length, text: string, state: int, accent: color, dim: color }
// Expanded automation row in the track header column (content y).
export struct AutoExtra { track-id: int, index: int, y: length, cat: string, param: string, state: int, accent: color }

export struct RulerLabel { x: length, text: string }

// Section name in the ruler's section lane (src/sections.rs): x and room in lane points, ink per block.
export struct SectionLabel { x: length, w: length, text: string, ink: color }

// Minimap bar (src/minimap.rs): x and w are fractions of the strip width.
export struct MiniBar { x: float, w: float, y: length, h: length, color: color }

// Devices minimap tile (src/devminimap.rs): strip-local px; frame draws a chain's frame; glyph is a stroke path in a 24 x 14 box.
export struct DevTile { x: length, y: length, w: length, h: length, frame: bool, art: string, art-accent: string, bg: color, art-fill: color, ink: color, opacity: float, name: string }

export struct ClipLabel { x: length, y: length, w: length, text: string, selected: bool }

// Browser tree row (Devices tab; src/devices.rs). icon: 0 folder, 1 instrument (keys), 2 effect.
// expander: 0 none, 1 closed, 2 open. leaf: a device (double-click / drag adds it).
export struct TreeRow { depth: int, label: string, count: string, icon: int, expander: int, selected: bool, leaf: bool }
// Browser › Files row (src/files.rs): kind 0 row, 1 group label, 2 note; y and h in list
// coordinates; glyph 0 folder, 1 audio file, 2 project, 3 audio track, 4 instrument track,
// 5 MIDI clip; expander 0 none, 1 closed, 2 open.
export struct FileRow { kind: int, depth: int, y: length, h: length, label: string, detail: string, glyph: int, expander: int, selected: bool }
// Vertical guide beside an open row's contents (list coordinates).
export struct FileGuide { x: length, y: length, h: length }

// One plugin card in the bottom-panel device chain (src/devices.rs). x is bottom-panel relative
// and already includes the chain scroll and a drag offset.
// ---- built-in device panel (src/device_panel.rs builds these from the DeviceDef) ----
// Knob cell (card relative x, y). face 1 = soft-knee transfer curve instead of the ring (paths
// in a 32 x 32 view box); face 2 = On/Off latch (value = state name, norm 0 / 1). origin: the
// arc's start as a norm. ticks: detent marks across the ring (32 x 32 view box). dim: drawn at
// 55% (the control has no effect in the current state). latch: an On/Off cluster parameter drawn
// as a latch cell (value = its text, on = lit); momentary: on only while held; inert: ignores gestures.
// mod-*: modulation display (src/device_mod.rs): the reach of every source around the set value
// (lo..hi, 0..1), the live modulated position and the first source's colour.
export struct PanelKnob {
    param: int, x: length, y: length, label: string, value: string, norm: float, origin: float, dim: bool, face: int, face-curve: string, face-bend: string, face-unity: string, ticks: string,
    mod-on: bool, mod-lo: float, mod-hi: float, mod-now: float, mod-color: color, selected: bool, mapped: bool,
    // Text the value editor starts with (empty = value).
    edit: string,
    // Knob cell width (0 = the 62 pt default).
    cell: length,
    latch: bool, on: bool, momentary: bool, inert: bool,
}
// One modulation link in a source's target list (LFO targets, macro targets).
export struct ModTarget { index: int, name: string, amount: string }
// Modulation / container body of a card (src/device_mod.rs). kind 1 LFO, 2 chain head.
export struct ModCard {
    kind: int,
    targets: [ModTarget], map-armed: bool, slot: int,
    macro-name: string, macro-open: bool, members: int, collapsed: bool,
}
// A chain head's frame around its member cards (bottom-panel relative x).
export struct ChainFrame { x: length, w: length, armed: bool, color: color, empty-x: length, empty: bool, head: int }
// Picker row item. kind 0 caption, 1 segmented choice, 2 menu pill (param -1: sidechain, else a
// choice menu), 3 value box, 4 flexible gap, 5 latch (On/Off parameter; label shows the state,
// selected 0 / 1), 6 action button, 7 view switch / tabs (choices = view names, selected = shown view; UI state). dim: a menu pill shown at 60% until hovered
// (values that follow the project, e.g. the Pitch Corrector's key while Follow is Project).
export struct PanelPick { kind: int, param: int, label: string, label-w: length, choices: [string], selected: int, value: string, enabled: bool, width: length, dim: bool }
// Vertical slider column (x = column left, card relative).
// zero: normalised position the fill starts from (0 = bottom; 0 dB on a range through zero).
export struct PanelSlider { param: int, x: length, label: string, value: string, norm: float, zero: float }
export struct PanelTick { y: length, text: string, rule: bool }
// Device field (View::Custom): layers of paths in field coordinates (the well below the
// caption when well = true, else the field box), texts, grip pills and drag zones.
// fill .. fill2: vertical gradient from the top to the bottom of the well (equal = solid).
// label: accessible value when it differs from the readout (e.g. the Tuner's spoken note).
export struct PanelPath { commands: string, stroke: color, width: length, fill: color, fill2: color }
// align: 0 left, 1 centre, 2 right of [x, x + w].
export struct PanelText { x: length, y: length, w: length, h: length, text: string, color: color, size: length, weight: int, align: int }
// anchor: x is the grip's left (0), centre (1) or right (2) edge; y its centre. hot: drawn
// highlighted (hovered or dragged handle); plain: no grip dots.
export struct PanelGrip { x: length, y: length, label: string, value: string, anchor: int, hot: bool, plain: bool }
// Dot (node, handle): centre x / y, radius r, optional ring of width ring.
export struct PanelDot { x: length, y: length, r: length, fill: color, ring: length, ring-color: color }
// Drag zone: param-x / param-y (-1 = axis unused), norm per px (rate-x < 0: dragging right lowers).
export struct PanelZone { x: length, y: length, w: length, h: length, param-x: int, param-y: int, rate-x: float, rate-y: float }
export struct PanelCanvas {
    visible: bool, well: bool, x: length, y: length, w: length, h: length, well-y: length,
    caption: string, readout: string,
    paths: [PanelPath], texts: [PanelText], dots: [PanelDot], grips: [PanelGrip], zones: [PanelZone],
    // pointer: raw pointer, wheel and key events over the well go to Rust (Studio.panel-graph*),
    // which hit-tests them. interactive: every pointer event over the whole canvas (press, drag,
    // release, hover, right press, double-click, wheel, leave) goes to Rust as
    // Studio.panel-editor, with window coordinates for menus, for editors with their own
    // gestures and menus (src/device_editors.rs). cursor: 0 default, 1 move, 2 ew-resize,
    // 3 ns-resize, 4 pointer, 5 crosshair. readout-accent: the caption value is drawn in the
    // track colour. label / value: the pointer well's accessible name and value.
    pointer: bool, interactive: bool, cursor: int, readout-accent: bool, label: string, value: string,
}
// Intensity image of a field well (Reverb tail), stretched (bilinear) over the box x/y/w/h in
// well coordinates under the paths. Kept out of PanelCanvas: an image field in that struct
// doubled the first frames' render cost of every card.
export struct PanelWash { device: int, img: image, x: length, y: length, w: length, h: length }
// Freely placed control (custom card bodies): kind 0 latch (On/Off parameter), 1 menu pill
// (choice parameter, opens a menu of its choices).
export struct PanelButton { kind: int, param: int, x: length, y: length, w: length, label: string, on: bool }
// Dynamics strip: caption + readout above a well; paths are in well coordinates (view box w x well-h).
// Draggable dashed line and an optional solid second line (Alt+drag moves both).
export struct PanelStrip {
    visible: bool, x: length, y: length, w: length, h: length, well-y: length,
    caption: string, readout: string, ticks: [PanelTick],
    in-fill: string, gr-fill: string, in-line: string, out-line: string,
    thresh-param: int, thresh-y: length, thresh-dash: string, thresh-label: string, thresh-value: string, thresh-rate: float,
    second-param: int, second-y: length, second-line: string, second-label: string, second-value: string, second-rate: float,
}
// Multiband field (src/panel_multiband.rs): field-relative lengths; paths in a w x h view box.
export struct PanelBand {
    x: length, w: length, selected: bool,
    level-y: length, show-level: bool, gain-y: length, gain-h: length, show-gain: bool,
    thr-y: length, floor-y: length, thr-param: int, floor-param: int, thr-active: bool, floor-active: bool,
    thr-dash: string, floor-dash: string, thr-text: string, floor-text: string,
    handle-x: length, handle-w: length, thr-hit-y: length, thr-hit-h: length, floor-hit-y: length, floor-hit-h: length,
}
export struct PanelXover { x: length, param: int, text: string, rate: float }
export struct PanelFreq { x: length, text: string, grid: bool }
export struct PanelBands {
    visible: bool, x: length, y: length, w: length, h: length, ladder: length,
    ticks: [PanelTick], freqs: [PanelFreq], bands: [PanelBand], xovers: [PanelXover],
    thr-rate: float, floor-rate: float,
}

// Sampler-family panels (src/sampler_panel.rs): every length is card relative and
// already scaled; paths are in their box's own coordinates.
export struct PanelPad { label: string, name: string, filled: bool, selected: bool, level: float, x: length, y: length, w: length, h: length }
export struct PanelHandle { x: length, y: length, active: bool }
export struct PanelSampler {
    visible: bool,
    kind: int,                 // 0 Sampler, 1 Pad Sampler, 2 Drum Rack
    pads: [PanelPad], divider-x: length,
    sub-visible: bool, sub-x: length, sub-y: length, sub-w: length, sub-h: length, sub-on: bool, sub-on-param: int, sub-title: string,
    layer-visible: bool, layer-x: length, layer-y: length, layer-text: string, layer-name: string, mapped: string, can-step: bool,
    play-visible: bool, play-x: length,
    head-x: length, head-picks: [PanelPick],
    row-y: length, row-right: length, row-picks: [PanelPick],
    well-x: length, well-y: length, well-w: length, well-h: length,
    loaded: bool, empty-text: string, hint: string, sample-name: string, can-remove: bool,
    wave: string, dim: string, fades: string, slices: string, sel-x: length, sel-w: length, heads: string,
    start-x: length, end-x: length, fade-in-x: length, fade-out-x: length, loop-x: length, grips: [length],
    tabs-visible: bool, tabs-y: length, tab-pick: PanelPick, tab-right: length, tab-picks: [PanelPick],
    knobs: [PanelKnob], knob-y: length,
    pic-visible: bool, pic-x: length, pic-y: length, pic-w: length, pic-h: length,
    pic-fill: string, pic-line: string, pic-grid: string, handles: [PanelHandle], pic-pads: [PanelPad],
}

// Plotted field (View::Field): caption + readout above a well; paths in well coordinates.
// plot-*: the drag area (well relative). band: fill is a min..max band (alpha .16) instead of
// the area under the first trace (alpha .28). dot: live LFO dot at dot-x / dot-y; live: the
// live response curve or the dot's trail, in the track colour.
export struct PanelField {
    visible: bool, x: length, y: length, w: length, h: length, well-y: length,
    caption: string, readout: string, ticks: [PanelTick], rest: string,
    fill: string, band: bool, main: string, main-w: length, main-hot-w: length,
    alt: string, alt-alpha: float, third: string, third-alpha: float,
    live: string, dot: bool, dot-x: length, dot-y: length,
    x-param: int, y-param: int, plot-x: length, plot-y: length, plot-w: length, plot-h: length,
}

// EQ chrome around a field (View::Eq): band tabs + On latch (+ Bank menu), type glyph picker,
// value cells. Lengths are card relative.
export struct EqTab { label: string, on: bool }
export struct EqGlyph { commands: string, name: string, choice: int }
export struct EqCell { x: length, w: length, label: string, value: string, param: int, enabled: bool, rate: float }
export struct PanelEq {
    visible: bool,
    tabs: [EqTab], selected: int, tab-w: length,
    on-param: int, on: bool, latch-x: length,
    bank-param: int, bank-value: string, bank-x: length, bank-w: length,
    glyphs: [EqGlyph], glyph-selected: int, type-param: int,
    cells: [EqCell],
}

export struct DeviceCard {
    id: int,
    x: length,
    name: string,
    vendor: string,
    format: string,        // "AU" / "VST3" / "CLAP"
    kind: string,          // "Audio effect" / "Instrument"
    enabled: bool,
    instrument: bool,      // the track's instrument plugin (replaces the built-in Synth)
    error: string,         // engine load error ("" = loaded / unknown)
    latency: string,       // "" when 0
    has-editor: bool,
    editor-supported: bool, // the host can open plugin windows on this OS
    editor-open: bool,
    win-dx: length,        // device window: drag offset from its default spot (src/devices.rs window_at)
    win-dy: length,
    dragging: bool,
    // Built-in devices (src/device_panel.rs, ui/device_panel.slint): the panel generated
    // from the device definition. Unused (empty) on plugin cards.
    builtin: bool,
    width: length,
    accent: color,
    accent-text: color,    // value text: the accent as a light OKLCH tint (L .87, chroma at most .11)
    accent-light: bool,    // the accent needs dark ink on it (switch thumb, selected segment text)
    preset: string,
    knobs: [PanelKnob],
    picks: [PanelPick],
    sliders: [PanelSlider],
    slider-top: length,
    strip: PanelStrip,
    // Generic header state (every card): folded to a strip, swappable from the name, in a chain.
    folded: bool,
    swappable: bool,
    member: bool,
    modv: ModCard,
    // Plugin card (third-party plugins): shown controls (knobs), pager.
    page: int,
    pages: int,
    sampler: PanelSampler,
    field: PanelField,
    bands: PanelBands,
    // Slider column rail (card relative) and cell width.
    slider-top: length,
    slider-bottom: length,
    slider-w: length,
    // Canvas view (src/device_canvas.rs) and EQ chrome.
    canvas: PanelCanvas,
    eq: PanelEq,
    buttons: [PanelButton],
}

// Settings › Plugins list rows. warn: drawn with the orange "Missing"/failure badge.
export struct PluginRow { name: string, detail: string, badge: string, warn: bool }


// ---- mixer panel (bottom panel replacement) ----
export struct MixerStrip {
    id: int,
    name: string,
    instrument: bool,
    is-return: bool,     // return strip: no R / I, no Sends section
    is-group: bool,      // group strip: no R / I, a fold chevron by the name
    group-start: bool,   // first return strip (divider before it)
    color: color,
    selected: bool,
    mute: bool,
    solo: bool,
    pan: float,
    pan-text: string,
    fader: float,   // 0 (top, +6 dB) .. 1 (bottom, -inf)
    gain-text: string, // gain readout: "0.0", "+1.5", "−12.0", "−∞" at or below -60 dB
    send-first: int,   // this strip's rows in Studio.strip-sends: send-first .. send-first + send-count
    send-count: int,
    // Groups (src/groups.rs): the strip's column (folded tracks have none and are hidden), the
    // group bar across the top of a group's strips (its colour, and whether this strip ends it),
    // whether the group is folded, and a muted group dims its tracks.
    column: int,
    hidden: bool,
    bar: bool,
    bar-color: color,
    bar-end: bool,
    folded: bool,
    group-muted: bool,
}
export struct StripMeter { l: float, r: float, peak: string }   // 0 (top) .. 1 (silent)
// One send slot (src/routing.rs): sender track id, the return's row among the returns, the return
// (id, letter, name, colour), level as a volume-slider position 0..1 with readouts, pre-fader;
// stored: a send is stored for the slot (else it is silent); live: it is stored and above −∞.
export struct SendRow { track: int, row: int, target: int, letter: string, name: string, color: color, pos: float, db-text: string, short-text: string, pre: bool, stored: bool, live: bool }

// ---- assistant panel ----
// kind: 0 user, 1 assistant reply, 2 error, 3 pending
// kind: 0 user, 1 reply, 2 error, 3 live row. point: sent in Point mode. fresh: added since the last rebuild (entry pop).
export struct ChatEntry { kind: int, text: string, lines: [string], worked: string, expanded: bool, point: bool, fresh: bool }
// Point ring (x, y, w, h, corner radius r) and its bubble anchor (bx; by is the bubble's top, or its bottom when above).
export struct HighlightRect { x: length, y: length, w: length, h: length, r: length, bx: length, by: length, above: bool, title: string, note: string }

// ---- clip editor / piano roll / context menu ----
export struct YLabel { y: length, text: string }
// Step sequencer (src/stepseq.rs), editor-local. SeqCell state: 0 past the pattern end, 1 off,
// 2 on; lane: 0 Steps, 1 Velocity, 2 Offset, 3 Repeat, 4 Tie; bar: the lane value as 0..1
// (Velocity fill, Offset line); marks: Repeat hits; label: value while it is dragged.
export struct SeqRow { y: length, number: string, name: string, muted: bool, soloed: bool, audible: bool }
export struct SeqCell { x: length, y: length, w: length, state: int, lane: int, bar: float, marks: int, label: string, dim: bool }
export struct SeqNum { x: length, text: string, beat: bool, active: bool }
// Clip sidebar pattern list (src/composer.rs): a row and its notes in miniature (x, y, w as
// fractions of the preview box).
export struct PreviewNote { x: float, y: float, w: float }
export struct PatternRow { name: string, playing: bool, notes: [PreviewNote] }
// One Shape rack row. kind 0 slider (norm 0..1, bipolar fills from the middle),
// 1 stepper (‹ value ›), 2 segments (segs, seg lit); tip shows on a disabled row.
// selected: the row whose curve the piano roll edits; curved: a curve is drawn on it.
export struct ShapeRow { label: string, value: string, kind: int, norm: float, bipolar: bool, segs: int, seg: int, enabled: bool, tip: string, selected: bool, curved: bool, color: color }
// separator: a line is drawn above the item; y: row top inside the menu.
// ---- synth device (src/synth.rs) ----
// One parameter of the Synth device: control position 0..1, readout with units.
export struct SynthParam { norm: float, text: string, bipolar: bool, auto: bool }
// A picture: SVG paths (viewbox = element size in points) of the curve, its filled area,
// secondary curves, handles and grid lines; dim = the part is silent.
export struct SynthDisplay { line: string, fill: string, ghost: string, dots: string, grid: string, marks: string, dim: bool }
// Axis / value text drawn inside picture slot; align 0 left, 1 centre, 2 right of x.
export struct SynthLabel { slot: int, x: length, y: length, text: string, align: int, accent: bool }
// Page elements (card coordinates; knobs, latches: centre of the dial; faders: centre x, groove top).
export struct SynthArc { d: string, c: color }
export struct SynthKnobItem { idx: int, x: length, y: length, label: string, accent: color, dim: bool, lit: bool, arcs: [SynthArc], dots: [color], band-on: bool, band-lo: float, band-hi: float, dot-on: bool, dot: float }
export struct SynthFaderItem { idx: int, x: length, y: length, label: string }
export struct SynthPillItem { x: length, y: length, w: length, label: string, value: string, action: int, arg: int, ring: int, ring-idx: int, outline: bool, chevron: bool }
export struct SynthTextItem { x: length, y: length, w: length, text: string, style: int, align: int }
export struct SynthSegItem { idx: int, x: length, y: length, w: length, options: [string], sel: int, first: int }
export struct SynthScopeItem { slot: int, x: length, y: length, w: length, h: length, grid: int, hgrid: int, zero: bool }
export struct SynthLatchItem { idx: int, x: length, y: length, label: string, on: bool }
export struct SynthRouteRow { slot: int, y: length, on: bool, on-idx: int, source: int, source-text: string, target-text: string, amount: float, amount-idx: int, text: string }
export struct SynthMapRow { heading: bool, slot: int, y: length, label: string, from: float, to: float, from-idx: int, to-idx: int, from-text: string, to-text: string }

// Checkable popup row ("In" selector, Settings dropdowns). hint: a grey wrapped note row.
export struct ChoiceItem { label: string, checked: bool, hint: bool, y: length, h: length }
// Settings › MIDI › MIDI inputs row: on = its switch, lit = activity light.
export struct MidiInputRow { name: string, on: bool, lit: bool }
// Edit › Undo History row; state 0 applied, 1 current, 2 undone.
export struct UndoHistoryRow { number: int, label: string, date: string, time: string, state: int }

// swatch: a colour chip before the label (track colour menu); transparent for none.
export struct MenuItem { label: string, shortcut: string, enabled: bool, separator: bool, submenu: bool, y: length, swatch: color }

export global Studio {
    // ---- project / status ----
    in property <string> project-name: "Untitled";
    in property <bool> project-edited;          // unsaved changes (window title)
    in property <string> status-text;
    // A clip render (Consolidate, Bounce, Export audio) runs on a worker: label with percent, bar fill 0..1, Cancel.
    in property <bool> render-busy;
    in property <string> render-label;
    in property <float> render-progress;
    callback render-cancel();
    // ---- transport (driven by engine.transport() every frame) ----
    in property <bool> playing;
    in property <string> bar-text: "001";
    in property <string> time-text: "00:00.000";
    in property <string> bpm-text: "120";
    in property <string> sig-text: "4/4";
    // ---- transport bar tempo / signature / key fields (src/transport_fields.rs) ----
    in property <string> key-text;                 // "C", "F#m"; empty: no key
    in property <int> key-root: -1;                // 0 = C .. 11 = B; -1 no key
    in property <bool> key-minor;                  // the key picker's Major / Minor
    in property <bool> key-menu-open;
    in property <bool> sig-menu-open;
    in property <int> sig-menu-active: -1;  // keyboard highlight row in the Sig menu
    in property <int> key-active: -1;       // keyboard highlight root in the key picker
    in property <[ChoiceItem]> sig-menu-items;
    in property <length> sig-menu-h: 100px;
    in property <length> sig-menu-w: 74.8px;
    in property <length> sig-menu-rule;
    callback tempo-drag(int, length, length);      // phase 0 press, 1 move, 2 release; offset from the press
    callback tempo-text(string);                   // typed tempo (double-click the readout)
    callback tempo-step(int);                     // the tempo field's accessible increment (+1) / decrement (-1)
    callback tap-tempo();
    callback sig-menu-toggle();
    callback sig-menu-pick(int);
    callback key-menu-toggle();
    callback key-pick(int);                        // root 0..11
    callback key-mode(bool);                       // minor
    callback key-clear();
    callback transport-menus-dismiss();
    in property <float> master-pos: 0.85;
    in-out property <bool> sounds-visible: true;
    // Loop (project transport) and metronome (app preference), both real engine features.
    in property <bool> loop-enabled: false;
    in property <bool> metronome-on: false;
    callback toggle-loop();
    callback toggle-metronome();
    // ---- timeline ----
    in property <[TrackRow]> tracks;
    in property <[TrackLevel]> track-levels;    // by track index
    in property <TrackLevel> master-level;
    in property <length> scroll-y;
