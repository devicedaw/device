    in property <string> sel-out-text: "Master";
    in property <[SendRow]> sel-sends;             // channel strip Sends tab: one slot per return
    in property <bool> sel-can-send;
    // The selected track can pick its output (not a return or group track).
    in property <bool> sel-can-route;
    in property <bool> can-add-return: true;       // fewer than the most return tracks
    in property <bool> route-menu-open;            // send options / Out / Add track menu
    in property <[ChoiceItem]> route-menu-items;
    in property <length> route-menu-x;
    in property <length> route-menu-y;
    in property <length> route-menu-w: 120px;
    in property <length> route-menu-h: 48px;
    callback toggle-returns();
    callback toggle-sends-open();
    callback sends-add-return(int);                // "+" beside Sends: a new return track (track id stays selected)
    callback send-new-return(int);                 // "Return A" placeholder: a return and a 0 dB send to it
    callback open-send-options(int, int, length, length);  // track, return, anchor x, y (window)
    callback open-out-menu(length, length);
    callback open-add-track-menu(length, length);
    callback route-menu-pick(int);
    callback route-menu-dismiss();
    callback send-pos(int, int, float);            // track, return, slider position 0..1
    callback send-reset(int, int);                 // level back to 0 dB
    callback send-toggle-pre(int, int);
    callback send-gesture-end();
    in property <bool> input-menu-open;
    in property <[ChoiceItem]> input-menu-items;
    in property <length> input-menu-h: 48px;
    in property <length> input-menu-w: 136px;
    callback track-arm(int);                    // SetTrackArm (audio) / placeholder status (instrument)
    callback track-monitor(int);                // SetTrackMonitor (audio) / placeholder status (instrument)
    callback open-input-menu();
    callback input-menu-pick(int);              // SetTrackInput
    callback input-menu-dismiss();
    // ---- export dialog and unsaved-changes prompt (src/dialogs.rs, ui/dialogs.slint) ----
    in property <bool> export-open;
    in property <bool> export-bits24: true;
    in property <bool> export-rate48: true;      // the file's rate: 48 kHz (true) or 44.1 kHz
    in property <bool> export-mp3;               // Format: MP3 (true) or WAV
    in property <bool> export-kbps-high: true;   // MP3 bitrate: 320 kbps (true) or 192 kbps
    in property <string> export-recipe-text: "WAV 24-bit";
    in property <string> export-bars-text: "Bars 1–1";
    in property <string> export-name: "Untitled.wav";
    in property <string> export-dir;
    in property <string> export-estimate;
    in property <int> export-recipe;             // 0 Mixdown, 1 Stems
    in property <string> export-stems-text: "0 WAV files";
    in property <string> export-files-text: "0 files";   // footer label on Stems
    in property <string> export-name-label: "Name"; // "Folder" when stems go into a folder
    in property <string> export-tracks-label: "All individual tracks";
    in property <bool> export-tracks-menu-open;
    in property <length> export-tracks-menu-h;
    in property <[ChoiceItem]> export-tracks-items;
    in property <string> export-range-label: "Full project";
    in property <bool> export-range-menu-open;
    in property <length> export-range-menu-h;
    in property <[ChoiceItem]> export-range-items;
    callback export-pick-recipe(int);
    callback export-toggle-tracks();
    callback export-pick-tracks(int);
    callback export-toggle-range();
    callback export-pick-range(int);             // 0 full project, 1 loop region
    callback export-close();
    callback export-run();
    callback export-choose-dir();
    callback export-bits(bool);                 // true = 24-bit
    callback export-rate(bool);                 // true = 48 kHz, false = 44.1 kHz
    callback export-format(bool);               // true = MP3, false = WAV
    callback export-kbps(bool);                 // true = 320 kbps, false = 192 kbps
    callback export-name-edited(string);
    in property <bool> unsaved-open;
    // Settings › General (src/settings.rs general_toggle): Always load last session, Auto-show
    // third-party effect windows, Auto-show built-in effect windows, Keep plugin windows on top.
    in property <[bool]> general-on: [false, true, false, true];
    in property <bool> general-stop-in-place;
    callback general-toggle(int);
    callback general-stop-mode(bool);                       // true = Stop in place
    in property <bool> updates-open;                        // Options › Check for Updates…
    in property <string> app-version;
    in property <bool> undo-history-open;                   // Edit › Undo History…
    in property <[UndoHistoryRow]> undo-history-rows;
    in property <int> undo-history-current;                 // row index of the current state
    callback undo-history-travel(int);
    callback undo-history-close();
    callback updates-close();
    callback unsaved-cancel();
    callback unsaved-dont-save();
    callback unsaved-save();
    // ---- settings window (src/settings.rs, ui/settings.slint) ----
    in property <bool> settings-open;
    in property <int> settings-page: 1;
    in property <[string]> settings-pages;
    in property <string> set-output-text: "System default";
    in property <string> set-input-text: "None";
    in property <string> set-rate-text: "48 kHz";
    in property <string> set-buffer-text: "Device default";
    in property <bool> set-input-muted;
    in property <string> settings-note;
    in property <bool> set-pdc-on: true;
    in property <string> set-latency-text;
    in property <[MidiInputRow]> midi-inputs;
    callback settings-midi-toggle(int);
    in property <bool> settings-menu-open;
    in property <int> settings-menu-field;      // 0 output, 1 input, 2 sample rate, 3 buffer size
    in property <[ChoiceItem]> settings-menu-items;
    in property <length> settings-menu-h;
    callback toggle-settings();
    callback close-settings();
    callback settings-page-select(int);
    callback settings-dropdown(int);
    callback settings-menu-pick(int);
    callback settings-menu-dismiss();
    callback settings-toggle-mute();
    callback settings-toggle-pdc();
    callback settings-test();

    // ---- device chain (Devices tab; src/devices.rs, ui/devices.slint) ----
    in property <[DeviceCard]> device-cards;
    in property <[DeviceCard]> device-window-cards;          // built-in cards open in a device window (any track)
    in property <length> chain-scroll;          // horizontal scroll of the chain (synth card included)
    in property <length> add-device-x: 265px;   // bottom-panel relative
    in property <bool> chain-marker-visible;    // insertion marker while dragging a card or a device
    in property <length> chain-marker-x;
    in property <string> sel-inst-text: "Synth";
    in-out property <string> add-search;        // Add device card search (transient input)
    in property <[MenuItem]> add-results;       // matches while add-search is not empty
    callback device-power(int);                 // SetDeviceEnabled
    callback device-edit(int);                  // open / close the plugin window
    callback device-remove(int);                // RemoveDevice (closes its window first)
    callback device-use-synth();                // SetInstrumentPlugin(None)
    callback device-drag(int, int, length);     // card id, phase 0/1/2, window x (MoveDevice on release)
    callback chain-scroll-by(float);
    // Devices minimap (src/devminimap.rs): shown while the chain is wider than the panel. Tiles are strip-local;
    // the window is (x, w) in strip px; the strip reports its width for the self-test.
    in property <bool> devmm-visible;
    in property <[DevTile]> devmm-tiles;
    in property <length> devmm-win-x;
    in property <length> devmm-win-w;
    in property <bool> devmm-dragging;
    in-out property <length> devmm-width;
    callback devmm-pointer(int, length, length, length, length);
    callback devmm-scroll(float, float);
    // Built-in device panels: device id, parameter index (definition order).
    callback panel-drag-pair(int, int, int, int, float, float, bool); // device, line param, other line param, then as panel-drag
    callback panel-drag(int, int, int, float, float, bool); // phase 0 press / 1 move / 2 release / 3 cancel, dy since last event (px, up +), norm per px, fine
    callback panel-reset(int, int);                          // default value (Alt-click, double-click)
    callback panel-reset-xy(int, int, int);                  // device, param x, param y (-1 = unused): both to default, one undo step
    callback panel-step(int, int, int, bool);                // arrow keys: +1 / -1, fine
    callback panel-choice(int, int, int);                    // choice index
    callback panel-text(int, int, string);                   // typed value (parsed by the definition)
    callback panel-menu(int, int, length, length);           // -1 sidechain source, -2 presets, >= 0 a dropdown's choices; window x, y
    callback panel-drag-xy(int, int, int, int, float, float, float, float, bool); // device, param x, param y, phase, dx, dy (px, right / up +), norm per px x / y, fine
    callback panel-field(int, int, float, float, bool);      // field XY drag: device, phase (as panel-drag), dx, dy (px, up +), fine
    callback panel-preset-step(int, int);                    // previous (-1) / next (+1) factory preset
    callback panel-latch(int, int, int);                     // latch: 0 click (toggle) / 1 press / 2 release (momentary)
    // Custom view canvas: kind 0 press, 1 drag, 2 release, 3 cancel, 4 hover, 5 right press,
    // 6 double-click, 7 wheel (dy notches, up +), 8 pointer left; canvas x, y; window x, y; shift, alt.
    callback panel-editor(int, int, length, length, length, length, bool, bool, float);
    callback panel-view(int, int, float);                    // custom view action (0 select band at field x px, 1 select band n, 2 show card view n)
    // ---- modulation and containers (src/device_mod.rs) ----
    in property <[ChainFrame]> chain-frames;
    // Bumped when the chain's cards change (added, removed, moved, folded): a focused control
    // inside a rebuilt card is gone, so the window takes the keyboard back.
    in property <int> cards-epoch;
    callback device-ask(int);                                // header spark: ask the assistant about this device
    callback device-window-moved(int, length, length);       // device window dragged: its new offset, kept per device
    callback device-window(int);                             // header arrow: open / close the device's floating window
    callback device-fold(int);                               // fold / unfold the card (header double-click, minus)
    callback device-collapse(int);                           // chain head: hide / show its members
    callback device-swap-menu(int, length, length);          // "Choose effect plugin" from the card name
    callback device-rename(int, string);                     // card label (chain group name)
    callback mod-menu(int, int, length, length);             // right-click on a control: Automate, Modulators, Macros
    callback mod-map(int, int);                              // arm / disarm a source output (LFO 0, macro n) for mapping
    callback mod-add-menu(int, int, length, length);         // + : parameter list of the track to add as targets
    callback mod-amount-drag(int, int, int, float, bool);    // source, link index, phase 0/1/2/3, dy (px, up +), fine
    callback mod-amount-text(int, int, string);              // typed amount (percent)
    callback mod-amount-step(int, int, int, bool);           // arrow keys
    callback mod-remove(int, int);                           // remove link
    callback macro-select(int, int);                         // chain head: open / toggle a macro's side panel
    callback macro-rename(int, int, string);
    callback chain-add-effect(int, length, length);          // empty chain "Add effect"
    callback card-add-menu(int, length, length);             // plugin card "+ Add": parameter list (knobs use panel-*)
    callback card-page(int, int);                            // pager -1 / +1
    // Sampler-family panels (src/sampler_panel.rs).
    callback sampler-pad(int, int, int, bool);               // which (0 rack pad, 1 slice pad), index, pressed
    callback sampler-layer(int, int);                        // previous (-1) / next (+1) sound of the pad
    callback sampler-play(int, bool);                        // Play button pressed / released
    callback sampler-action(int, int);                       // pick-row button (view, add slice, clear slice)
    callback sampler-remove(int);                            // remove the shown sample
    callback sampler-load(int);                              // choose an audio file for the shown slot
    callback sampler-well(int, int, float, float, bool);     // phase, x fraction, grab distance (fraction), alt
    callback sampler-handle(int, int, int, length, length);  // picture handle i: phase, x, y (picture px)
    callback panel-graph(int, int, float, float, bool, bool); // canvas pointer (PanelCanvas.pointer): phase (0 press, 1 drag, 2 release, 3 cancel, 4 hover, 5 leave, 6 double-click), well x, y (px), shift, alt
    in property <[PanelWash]> field-washes;                  // src/panel_fields.rs: wash images of field wells
    callback panel-graph-menu(int, float, float, length, length); // canvas right press: well x, y (px), window x, y: the handle's parameter menu
    callback panel-graph-wheel(int, float, float, float) -> bool; // canvas wheel: x, y, wheel dy (px, up +): used
    callback panel-graph-key(int, string, bool, bool) -> bool;     // canvas key: text, shift, alt: accepted
    callback panel-eq(int, int, int);                        // action 0 select band / 1 toggle On / 2 type choice / 3 reset type; value
    callback add-category(int, length, length); // row (Built-in, AU, VST3, CLAP, Chains), window x, y for the list
    callback add-search-edited(string);
    callback add-result-pick(int);
    callback open-inst-menu(length, length);    // instrument selector list at window x, y
    // Device popup list (Add device submenus, instrument selector).
    in property <bool> devmenu-open;
    in property <length> devmenu-x;
    in property <length> devmenu-y;
    in property <length> devmenu-w: 200px;
    in property <length> devmenu-h;
    in property <length> devmenu-content-h;
    in property <[MenuItem]> devmenu-items;
    callback devmenu-pick(int);
    callback devmenu-dismiss();
    // ---- Settings › Plugins ----
    in property <string> plugins-status;
    in property <bool> plugins-scanning;
    in property <[PluginRow]> scan-dirs;
    in property <[PluginRow]> plugin-rows;
    in property <[PluginRow]> plugin-failed;
    callback plugins-rescan(bool);              // false: check for new plugins (cache), true: rescan all
    callback plugins-add-folder();              // Settings › Plugins › Add folder (opens a folder picker)
    callback plugins-remove-folder(string);     // a custom folder row's remove button (its path)
    callback placeholder(string);               // PLACEHOLDER controls report "not implemented"

    // ---- automation (src/automation.rs) ----
    in property <bool> auto-shown;              // timeline header "Show/Hide automation lanes"
    in property <bool> auto-draw;               // "Draw mode (B)"
    in property <bool> auto-armed;              // transport "Automation Arm"
    in property <[AutoLabel]> auto-labels;
    in property <[AutoExtra]> auto-extras;
    in property <length> tracks-height: 149px;  // content height of all track rows
    in property <length> master-h: 30px;        // master row (64.5 pt while lanes are shown)
    in property <int> master-auto-state;
    in property <bool> master-vol-auto;
    in property <bool> sel-vol-auto;
    in property <bool> sel-pan-auto;
    callback auto-toggle-shown();
    callback auto-toggle-draw();
    callback auto-toggle-arm();
    callback auto-power(int, int);              // track id (-1 master), extra row index (-1 = shown lane)
    callback auto-expand(int);                  // track id
    callback auto-show-extra(int, int);         // track id, extra row index
    callback auto-open-picker(int, length, length); // track id (-1 master), window x, y of the pill's bottom-left
    in property <bool> picker-open;
    // Height of the in-window menu bar (Linux; 0 on macOS and Windows, whose menu bars are native).
    // Absolute positions include it but the overlays and the controller's layout are measured
    // from the content's top, so every absolute y the UI hands out has it subtracted.
    in-out property <length> menu-dy;
    in property <length> picker-x;
    in property <length> picker-y;
    in property <length> picker-h;
    in-out property <string> picker-query;
    in-out property <bool> picker-focused;
    in property <[MenuItem]> picker-items;
    in property <bool> picker-sub-open;
    in property <length> picker-sub-y;
    in property <length> picker-sub-h;
    in property <[MenuItem]> picker-sub-items;
    callback picker-edited(string);
    callback picker-pick(int);
    callback picker-sub-pick(int);
    callback picker-dismiss();

    callback report-bug();   // TODO: no-op placeholder
    callback feedback();     // TODO: no-op placeholder
}

