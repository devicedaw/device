// Device main window.
//
// Geometry is in window-relative points at 1440x820.
// Panels are positioned absolutely; right-hand
// elements are anchored to the right edge so the window stays resizable.
// The timeline lanes, ruler background, grid, loop bar, clips, waveforms and the
// playhead are a wgpu texture (`Studio.timeline-image`) rendered by src/gpu.
// Slint draws text and controls over/around it.
//
// The UI holds no authoritative state: every value comes from Rust (Studio
// global), every edit goes out through a Studio callback that becomes a
// dstudio_core::Command or an engine transport call.
// Inter 4.1 (SIL OFL 1.1, ui/fonts/Inter-OFL-LICENSE.txt): the UI typeface.
import "fonts/Inter-Regular.ttf";
import "fonts/Inter-Medium.ttf";
import "fonts/Inter-SemiBold.ttf";
import "fonts/Inter-Bold.ttf";
import { Tokens } from "tokens.slint";
import { Panel, Icon, Icons, Pill, IconButton, SmallButton, HSlider, Knob, Switch, Label, Raised, Field, Inset } from "widgets.slint";

export { Tokens }

import { Studio, TrackRow, TrackLevel, AutoLabel, AutoExtra, RulerLabel, SectionLabel, ClipLabel, MiniBar, TreeRow, FileRow, FileGuide, MixerStrip, StripMeter, ChatEntry, HighlightRect, YLabel, MenuItem, SynthParam, SynthDisplay, SynthLabel, SynthArc, SynthKnobItem, SynthFaderItem, SynthPillItem, SynthTextItem, SynthSegItem, SynthScopeItem, SynthLatchItem, SynthRouteRow, SynthMapRow, ChoiceItem, MidiInputRow, DeviceCard, PluginRow } from "studio.slint";
import { ClipSidebar, PianoRoll, ClipEmpty, ContextMenu, DropMenu } from "pianoroll.slint";
import { StepSequencer } from "stepseq.slint";
import { MixerPanel } from "mixer.slint";
import { StripMetrics, StripCanvas, StripReadout, StripButton } from "channel_strip.slint";
import { AssistantPanel, HighlightOverlay } from "assistant.slint";
import { SynthDevice, SynthMenuList } from "synth.slint";
import { SettingsPanel, ChoiceList } from "settings.slint";
import { ExportModal, UnsavedPrompt, UpdatesModal, UndoHistoryModal } from "dialogs.slint";
import { PluginCard, AddDeviceCard, DevMenuList } from "devices.slint";
import { BuiltinCard, FoldedStrip } from "device_panel.slint";
import { TrackHeaderRow, MasterHeaderRow, AutoPill, TrackName } from "track_header.slint";
import { KeyPicker } from "transport.slint";

export { Studio, TrackRow, TrackLevel, AutoLabel, AutoExtra, RulerLabel, SectionLabel, ClipLabel, TreeRow, FileRow, FileGuide, MixerStrip, StripMeter, ChatEntry, HighlightRect, YLabel, MenuItem, SynthParam, SynthDisplay, SynthLabel, SynthArc, SynthKnobItem, SynthFaderItem, SynthPillItem, SynthTextItem, SynthSegItem, SynthScopeItem, SynthLatchItem, SynthRouteRow, SynthMapRow, ChoiceItem, MidiInputRow, DeviceCard, PluginRow }

// ------------------------------------------------------------------ header
component Header inherits Rectangle {
    property <bool> bpm-editing;
    // Left edge of the 1440-unit transport block (it stays centred in the window).
    out property <length> transport-x: (root.width - 1440px) / 2;
    // Root-relative coordinates (header panel sits at 5,5).
    Panel { x: 5px; y: 5px; width: root.width - 10px; height: 68px; }

    // Title (centred). AX: 695,11,50,18
    Text {
        x: 0; y: 11px; width: root.width; height: 18px;
        text: Studio.project-name; color: Tokens.text-title; font-size: 10px; font-weight: 600;
        horizontal-alignment: center; vertical-alignment: center;
        accessible-role: text;
    }
    Pill { x: root.width - 220px; y: 9.45px; width: 82px; height: 22.1px; text: "Report a bug"; weight: 600; text-color: #f2f2f2; font-size: 10.2px; letter-spacing: -0.41px; clicked => { Studio.report-bug(); } }
    Pill { x: root.width - 131px; y: 9.45px; width: 118px; height: 22.1px; text: "Share your feedback"; weight: 600; text-color: #f2f2f2; font-size: 10.2px; letter-spacing: -0.41px; clicked => { Studio.feedback(); } }

    // Logo: sine-wave mark + "Beta" badge.
    Icon { x: 13px; y: 44px; width: 15px; height: 16px; d: Icons.logo; ink: #ffffff; stroke-width: 2.6px; }
    Rectangle {
        x: 31px; y: 46px; width: 26px; height: 12.5px;
        border-radius: 4px; border-width: 0.75px; border-color: #6a6b6f;
        Text { text: "Beta"; color: #ffffff; font-size: 6.75px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
    }
    // Sounds toggle (shows/hides the browser panel). AX 67,39,62,25
    Rectangle {
        x: 67px; y: 39px; width: 62px; height: 25px;
        accessible-role: checkbox; accessible-label: "Sounds"; accessible-checked: Studio.sounds-visible;
        Icon { x: 6px; width: 14px; height: 14px; d: Icons.library; ink: Studio.sounds-visible ? #c9c9cc : Tokens.icon; }
        Text { x: 22px; y: 1.5px; height: parent.height; text: "Sounds"; font-size: 10.2px; font-weight: 700; letter-spacing: -0.41px; color: Studio.sounds-visible ? #cfd0d3 : Tokens.text-tertiary; vertical-alignment: center; }
        TouchArea { clicked => { Studio.sounds-visible = !Studio.sounds-visible; } }
    }

    // Transport block (buttons, pill, master volume). Coordinates are for a 1440-unit-wide
    // window; the block stays centred, so it shifts by half the width change
    // (pill centre = window centre + 16.5 units at every zoom).
    Rectangle {
        x: root.transport-x; y: 0; width: 1440px; height: root.height;
        // Transport buttons
        IconButton { x: 368px; y: 38px; width: 28px; height: 28px; icon: Icons.rewind; filled: true; icon-size: 21.5px; ink: #63656c; tooltip: "Rewind to start (Enter)"; clicked => { Studio.stop-return(); } }
        IconButton { x: 396px; y: 38px; width: 28px; height: 28px; icon: Studio.playing ? Icons.pause : Icons.play; filled: true; icon-size: 21.5px;
            ink: Studio.playing ? Tokens.text-primary : #63656c; tooltip: "Play (Space)"; clicked => { Studio.play-toggle(); } }
        // Record (R): start/stop recording armed audio tracks. Dim when nothing is armed,
        // icon grey when ready, recording red while recording.
        IconButton { x: 423px; y: 38px; width: 28px; height: 28px; icon: Icons.record; filled: true; icon-size: 23px;
            ink: Studio.counting-in ? Tokens.record-red.with-alpha(0.45) : Studio.recording ? Tokens.record-red : Studio.record-ready ? #63656c : #303136;
            tooltip: "Record (R). Right-click for count-in"; active: false; clicked => { Studio.record(); }
            right-pressed(x, y) => { Studio.record-menu(x, y - Studio.menu-dy); } }

        // Transport capsule 464.5..1008.5 x 34.85..68.85 (40 CSS px high)
        // Inset well: 2 px dark top lip, short inner shadow, light bottom lip.
        Inset {
            x: 464.5px; y: 34.85px; width: 544px; height: 34px;
            border-radius: 17px; fill: Tokens.bg-raised;
            lip: 0.85px; shade: 1.3px; bottom: #4c4d51;
        }
        IconButton { x: 470px; y: 41px; width: 22px; height: 22px; icon: Icons.loop; ink: #63656c; tooltip: "Toggle loop (⌘L)"; active: Studio.loop-enabled; clicked => { Studio.toggle-loop(); } }
        // Automation Arm (src/automation.rs): while armed and playing, control moves write automation.
        IconButton { x: 496px; y: 41px; width: 21px; height: 22px; icon: Icons.automation; ink: #63656c; tooltip: "Automation Arm: knob moves write automation while playing";
            active: Studio.auto-armed; clicked => { Studio.auto-toggle-arm(); } }
        Label { x: 527px; y: 45px; text: "Bar"; color: #565656; font-size: 10.2px; font-weight: 700; letter-spacing: -0.41px; }
        Label { x: 548px; y: 45px; text: Studio.bar-text; color: #ffffff; font-size: 10.2px; font-weight: 700; letter-spacing: -0.41px; }
        Rectangle { x: 581.5px; y: 43px; width: 1px; height: 18px; background: Tokens.separator-dim; }
        Label { x: 595px; y: 45px; text: "Time"; color: #565656; font-size: 10.2px; font-weight: 700; letter-spacing: -0.41px; }
        Label { x: 624px; y: 45px; text: Studio.time-text; color: #ffffff; font-size: 10.2px; font-weight: 700; letter-spacing: -0.41px; }
        Rectangle { x: 689px; y: 43px; width: 1px; height: 18px; background: Tokens.separator-dim; }
        Label { x: 703px; y: 45px; text: "BPM"; color: #565656; font-size: 10.2px; font-weight: 700; letter-spacing: -0.41px; }
        // Tempo (src/transport_fields.rs): drag right or up (1 BPM per point), double-click to type.
        Label { x: 733px; y: 45px; text: Studio.bpm-text; color: bpm-ta.has-hover || bpm-ta.pressed ? Tokens.text-bright : #ffffff; font-size: 10.2px; font-weight: 700; letter-spacing: -0.41px; }
        bpm-ta := TouchArea {
            x: 729px; y: 41px; width: 31px; height: 22px;
            mouse-cursor: MouseCursor.ns-resize;
            accessible-role: spinbox; accessible-label: "Tempo"; accessible-value: Studio.bpm-text;
            accessible-description: "Double-click or use the default action to type a tempo";
            accessible-action-default => { root.bpm-editing = true; }
            accessible-action-increment => { Studio.tempo-step(1); }
            accessible-action-decrement => { Studio.tempo-step(-1); }
            pointer-event(e) => {
                if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) { Studio.tempo-drag(0, 0, 0); }
                if (e.button == PointerEventButton.left && e.kind == PointerEventKind.up) { Studio.tempo-drag(2, 0, 0); }
            }
            moved => { Studio.tempo-drag(1, self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y); }
            double-clicked => { root.bpm-editing = true; }
        }
        // The editor reaches left over the BPM label so six characters (998.99) fit before TAP.
        if root.bpm-editing: Rectangle {
            x: 712px; y: 43px; width: 48px; height: 18px; border-radius: 3.4px;
            background: #3a3b40; border-width: 0.85px; border-color: #ffffff59;
            TextInput {
                accessible-label: "Tempo (BPM)";
                x: 3px; width: parent.width - 6px; height: parent.height;
                text: Studio.bpm-text; color: #ffffff; font-size: 10.2px; font-weight: 700; letter-spacing: -0.41px;
                vertical-alignment: center; single-line: true; selection-background-color: #ffffff47;
                init => { self.focus(); self.select-all(); }
                accepted => { root.bpm-editing = false; Studio.tempo-text(self.text); }
                key-pressed(e) => {
                    if (e.text == Key.Escape) { root.bpm-editing = false; return accept; }
                    reject
                }
                changed has-focus => { if (!self.has-focus && root.bpm-editing) { root.bpm-editing = false; Studio.tempo-text(self.text); } }
            }
        }
        // TAP: two or more taps set the tempo to their average.
        Rectangle {
            x: 762px; y: 44px; width: 23px; height: 15px; border-radius: 3px;
            background: tap-ta.pressed ? Tokens.accent : tap-ta.has-hover ? #404146 : #34353a;
            accessible-role: button; accessible-label: "Tap tempo"; accessible-description: "Shift+T";
            accessible-action-default => { Studio.tap-tempo(); }
            Text { text: "TAP"; color: #e5e5e8; font-size: 7.75px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
            tap-ta := TouchArea {
                pointer-event(e) => { if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) { Studio.tap-tempo(); } }
            }
        }
        Rectangle { x: 798px; y: 43px; width: 1px; height: 18px; background: Tokens.separator-dim; }
        Label { x: 812px; y: 45px; text: "Key"; color: #565656; font-size: 10.2px; font-weight: 700; letter-spacing: -0.41px; }
        // Key: the readout ("C", "F#m") or a dash when the project has no key; opens the key picker.
        if Studio.key-text == "": Rectangle { x: 846px; y: 51.5px; width: 13px; height: 1.2px; background: #7a7b7e; }
        if Studio.key-text != "": Label { x: 846px; y: 45px; text: Studio.key-text; color: #ffffff; font-size: 10.2px; font-weight: 700; letter-spacing: -0.41px; }
        Icon { x: 873px; y: 45px; width: 14px; height: 14px; d: Icons.chevron-down; ink: Studio.key-menu-open || key-ta.has-hover ? #ffffff : #7a7b7e; }
        key-ta := TouchArea {
            x: 808px; y: 41px; width: 84px; height: 22px;
            accessible-role: combobox; accessible-label: "Key"; accessible-value: Studio.key-text == "" ? "None" : Studio.key-text;
            accessible-expanded: Studio.key-menu-open;
            accessible-action-default => { Studio.key-menu-toggle(); }
            clicked => { Studio.key-menu-toggle(); }
        }
        Rectangle { x: 901.5px; y: 43px; width: 1px; height: 18px; background: Tokens.separator-dim; }
        Label { x: 916px; y: 45px; text: "Sig"; color: #565656; font-size: 10.2px; font-weight: 700; letter-spacing: -0.41px; }
        Label { x: 936.5px; y: 45px; text: Studio.sig-text; color: #ffffff; font-size: 10.2px; font-weight: 700; letter-spacing: -0.41px; }
        Icon { x: 957px; y: 45px; width: 13px; height: 13px; d: Icons.chevron-down; ink: Studio.sig-menu-open || sig-ta.has-hover ? #ffffff : #a0a0a3; }
        sig-ta := TouchArea {
            x: 912px; y: 41px; width: 62px; height: 22px;
            accessible-role: combobox; accessible-label: "Time signature"; accessible-value: Studio.sig-text;
            accessible-expanded: Studio.sig-menu-open;
            accessible-action-default => { Studio.sig-menu-toggle(); }
            clicked => { Studio.sig-menu-toggle(); }
        }
        IconButton { x: 981px; y: 41px; width: 22px; height: 22px; icon: Icons.metronome; filled: true; ink: #63656c; tooltip: "Metronome"; active: Studio.metronome-on; clicked => { Studio.toggle-metronome(); } }

        // Master volume (header), real: SetMasterGain
        HSlider {
            x: 1022.5px; y: 45px; width: 95px; height: 14px; handle-size: 11px; lip: 0.85px;
            pos: Studio.master-pos;
            moved(p) => { Studio.master-volume(p); }
            released => { Studio.gesture-end(); }
            reset => { Studio.master-volume(Tokens.slider-zero-db); Studio.gesture-end(); }
        }
    }

    // Right-side panel toggles. Assistant and mixer are real; the rest are PLACEHOLDERS.
    // Glyph centres at y 51.9 (61 pt at 100 %); inactive ink #767678.
    IconButton { x: root.width - 147px; y: 39px; width: 25px; height: 25px; icon: Icons.assistant; filled: true; icon-size: 15px;
        ink: Studio.assistant-open ? #e5e5e8 : #767678; tooltip: "Toggle assistant panel (⇧⌘A)"; clicked => { Studio.toggle-assistant(); } }
    IconButton { x: root.width - 119px; y: 39px; width: 25px; height: 25px; icon: Icons.mixer;
        ink: Studio.mixer-open ? #e5e5e8 : #767678; tooltip: "Toggle mixer panel (⇧⌘X)"; clicked => { Studio.toggle-mixer(); } }
    IconButton { x: root.width - 91px; y: 39px; width: 25px; height: 25px; icon: Icons.panel-bottom; ink: #b4b5b8; tooltip: "Switch between clip editor and devices"; clicked => { Studio.toggle-clip-devices(); } }
    IconButton { x: root.width - 63px; y: 39px; width: 25px; height: 25px; icon: Icons.piano;
        ink: Studio.typing-on ? #e5e5e8 : #767678; tooltip: "Musical typing (K / ⇧K)"; clicked => { Studio.toggle-typing(); } }
    IconButton { x: root.width - 36px; y: 39px; width: 25px; height: 25px; icon: Icons.gear; tooltip: "Settings (⌘,)";
        ink: Studio.settings-open ? #e5e5e8 : #767678; clicked => { Studio.toggle-settings(); } }
}

// Browser › Files (src/files.rs lays the rows out). CSS px × 0.85: tabs like Devices', a 24 px
// count row (10 px weight 500 #81838a) with the sort button, 24 px rows 2 px apart indented 8 px
// per level, 11 px weight 600 names at 72 % white (selected: white on a 7 % white fill), 11 px
// #63656d details, 11 px #63656d group labels and notes.
component FilesPane inherits Rectangle {
    property <length> list-y: Studio.files-list-y - 59px;
    HorizontalLayout {
        x: 10.2px; y: 0; width: self.preferred-width; height: 16.7px; spacing: 10.2px;
        for t[i] in ["Projects", "Folders"]: Rectangle {
            width: label.preferred-width;
            accessible-role: tab; accessible-label: t; accessible-checked: Studio.files-tab == i;
            label := Text {
                x: 0; y: 0; height: 15px; text: t; color: Studio.files-tab == i ? #ffffff : #63656d;
                font-size: 9.35px; font-weight: 600; letter-spacing: -0.28px; vertical-alignment: center;
            }
            if Studio.files-tab == i: Rectangle { x: 0; y: 15px; width: parent.width; height: 1.7px; background: #ffffff; }
            TouchArea { clicked => { Studio.files-tab-select(i); } }
        }
    }
    // "+ Add folder": 10 px weight 500 #81838a, an 8 px plus 4 px before it, 12 px from the right.
    if Studio.files-tab == 1: Rectangle {
        x: root.width - 10.2px - self.width; y: 0; width: add-label.preferred-width + 10.2px; height: 15px;
        accessible-role: button; accessible-label: "Add folder";
        Path { x: 0; y: (parent.height - 6.8px) / 2 + 0.85px; width: 6.8px; height: 6.8px; viewbox-width: 8; viewbox-height: 8;
            commands: "M4 1v6M1 4h6"; stroke: add-ta.has-hover ? #a6a8ad : #81838a; stroke-width: 1.06px; stroke-line-cap: round; }
        add-label := Text { x: 10.2px; y: 0.85px; height: parent.height; text: "Add folder"; color: add-ta.has-hover ? #a6a8ad : #81838a;
            font-size: 8.5px; font-weight: 500; letter-spacing: -0.17px; vertical-alignment: center; }
        add-ta := TouchArea { clicked => { Studio.files-add-folder(); } }
    }
    // Count row and sort button (shown once the tab has items).
    if Studio.files-meta != "": Rectangle {
        x: 0; y: root.list-y - 20.4px; width: root.width; height: 20.4px;
        Text { x: 10.2px; text: Studio.files-meta; color: #81838a; font-size: 8.5px; font-weight: 500; letter-spacing: -0.17px; vertical-alignment: center; }
        Rectangle {
            x: parent.width - 10.2px - self.width; width: sort-label.preferred-width + 3.4px + 8.5px;
            accessible-role: button; accessible-label: "Sort: " + Studio.files-sort;
            accessible-action-default => { Studio.files-sort-open-menu(!Studio.files-sort-open); }
            property <color> ink: sort-ta.has-hover || Studio.files-sort-open ? #a6a8ad : #81838a;
            sort-label := Text { x: 0; text: Studio.files-sort; color: parent.ink; font-size: 8.5px; font-weight: 500; letter-spacing: -0.17px; vertical-alignment: center; }
            Icon { x: sort-label.preferred-width + 3.4px; y: (parent.height - 8.5px) / 2; width: 8.5px; height: 8.5px; d: Icons.chevron-down; ink: parent.ink; stroke-width: 1.4px; }
            sort-ta := TouchArea { clicked => { Studio.files-sort-open-menu(!Studio.files-sort-open); } }
        }
    }
    Rectangle { x: 0; y: root.list-y; width: root.width; height: 0.5px; background: Tokens.line-separator; }

    Rectangle {
        x: 0; y: root.list-y + 0.5px; width: root.width; height: root.height - root.list-y - 0.5px;
        clip: true;
        TouchArea { scroll-event(e) => { Studio.files-scroll-by(e.delta-y / 1px); accept } }
        // Empty tab: a centred title (11 px weight 600 #81838a) over a hint (11 px weight 500 #63656d).
        if Studio.files-empty-title != "": Rectangle {
            Text { y: parent.height / 2 - 8.7px - 6.3px; height: 16px; width: parent.width; horizontal-alignment: center; vertical-alignment: center;
                text: Studio.files-empty-title; color: #81838a; font-size: 9.35px; font-weight: 600; letter-spacing: -0.28px; }
            Text { y: parent.height / 2 + 8.7px - 6.3px; height: 16px; x: 10.2px; width: parent.width - 20.4px; horizontal-alignment: center; vertical-alignment: center;
                text: Studio.files-empty-hint; color: #63656d; font-size: 9.35px; font-weight: 500; letter-spacing: -0.19px; wrap: word-wrap; }
        }
        for g in Studio.files-guides: Rectangle { x: g.x; y: g.y - Studio.files-scroll; width: 0.85px; height: g.h; background: #2c2d30; }
        for row[i] in Studio.files: Rectangle {
            property <length> inset: 10.2px + row.depth * 6.8px;
            x: 0; y: row.y - Studio.files-scroll; width: parent.width; height: row.h;
            accessible-role: list-item;
            accessible-label: row.label;
            if row.kind == 0 && (row.selected || ta.has-hover): Rectangle { background: #ffffff12; }
            if row.kind == 0 && row.expander != 0: Icon {
                x: parent.inset; y: (parent.height - 8.5px) / 2; width: 8.5px; height: 8.5px;
                d: row.expander == 2 ? Icons.chevron-down : Icons.chevron-right; ink: parent.ink; stroke-width: 1.6px;
            }
            property <color> ink: row.selected ? #ffffff : ta.has-hover ? #ffffffeb : #ffffffb8;
            if row.kind == 0: Icon {
                x: parent.inset + 13.6px; y: (parent.height - 13.6px) / 2; width: 13.6px; height: 13.6px; ink: parent.ink; stroke-width: 1.2px;
                d: row.glyph == 1 ? Icons.wave : row.glyph == 2 ? Icons.window : row.glyph == 3 ? Icons.track-audio : row.glyph == 4 ? Icons.keys : row.glyph == 5 ? Icons.piano : Icons.folder;
            }
            if row.kind == 0: Text {
                x: parent.inset + 32.3px; width: parent.width - self.x - 10.2px - (row.detail == "" ? 0 : detail.preferred-width + 6.8px);
                text: row.label; color: parent.ink; font-size: 9.35px; font-weight: 600; letter-spacing: -0.28px; vertical-alignment: center; overflow: elide;
            }
            detail := Text {
                visible: row.kind == 0 && row.detail != "";
                x: parent.width - 10.2px - self.preferred-width; text: row.detail; color: #63656d;
                font-size: 9.35px; font-weight: 600; letter-spacing: -0.28px; vertical-alignment: center;
            }
            // Group labels sit 16 px past their row's inset; notes one level deeper.
            if row.kind != 0: Text {
                x: parent.inset + 13.6px + (row.kind == 2 ? 6.8px : 0); y: row.kind == 1 ? 3.4px : 0; height: row.kind == 1 ? 13.6px : parent.height;
                text: row.label; color: #63656d; font-size: 9.35px; font-weight: 600; letter-spacing: -0.28px; vertical-alignment: center;
            }
            ta := TouchArea {
                enabled: row.kind == 0;
                clicked => { Studio.files-click(i, self.mouse-x < parent.inset + 11px); }
                double-clicked => { Studio.files-activate(i); }
                pointer-event(e) => {
                    if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) { Studio.files-drag(i, 0, self.absolute-position.x + self.mouse-x, (self.absolute-position.y - Studio.menu-dy) + self.mouse-y); }
                    if (e.button == PointerEventButton.left && e.kind == PointerEventKind.up) { Studio.files-drag(i, 2, self.absolute-position.x + self.mouse-x, (self.absolute-position.y - Studio.menu-dy) + self.mouse-y); }
                }
                moved => { Studio.files-drag(i, 1, self.absolute-position.x + self.mouse-x, (self.absolute-position.y - Studio.menu-dy) + self.mouse-y); }
            }
        }
    }
}


// ------------------------------------------------------------------ browser
// Sections Devices and Files are real (src/devices.rs, src/files.rs); Search and Library have no
// content (PLACEHOLDER: no sample catalog). The preview bar plays the file last clicked in Files
// (Link: PLACEHOLDER, it ties catalog loops to the arrangement).
// Devices › Chains is PLACEHOLDER data. Back / Forward step through visited sections and tabs.
component Browser inherits Panel {
    // Section tabs: 12 px weight 700, -0.04 em, 8 px apart from 12 px in; rest #63656d, active white.
    HorizontalLayout {
        x: 10.2px; y: 0; width: self.preferred-width; height: 27.2px; spacing: 6.8px;
        for t[i] in ["Search", "Library", "Devices", "Files"]: Rectangle {
            width: section-label.preferred-width;
            accessible-role: tab; accessible-label: t; accessible-checked: Studio.browser-section == i;
            section-label := Text {
                x: 0; height: parent.height; text: t; color: Studio.browser-section == i ? #ffffff : #63656d;
                font-size: 10.2px; font-weight: 700; letter-spacing: -0.41px; vertical-alignment: center;
            }
            TouchArea { clicked => { Studio.browser-section-select(i); } }
        }
    }
    // Back / Forward: white when there is somewhere to go, else #63656d.
    Icon {
        x: 218px; y: 6.5px; width: 13px; height: 13px; d: Icons.chevron-left; ink: Studio.browser-can-back ? #ffffff : #63656d;
        accessible-role: button; accessible-label: "Back";
        TouchArea { x: -2px; y: -4px; width: 16px; height: 20px; clicked => { Studio.browser-back(); } }
    }
    Icon {
        x: 234px; y: 6.5px; width: 13px; height: 13px; d: Icons.chevron-right; ink: Studio.browser-can-forward ? #ffffff : #63656d;
        accessible-role: button; accessible-label: "Forward";
        TouchArea { x: -2px; y: -4px; width: 16px; height: 20px; clicked => { Studio.browser-forward(); } }
    }
    // Section separator (01/05/06: 0.5 pt at panel y 27).
    Rectangle { x: 0; y: 27px; width: root.width; height: 0.5px; background: Tokens.line-separator; }
    // Search field (real: filters the tree)
    Field {
        x: 8.5px; y: 34px; width: 235px; height: 20px; border-radius: 10px;
        Icon { x: 8px; width: 13px; height: 13px; d: Icons.search; ink: #b0b0b3; }
        if Studio.browser-search == "": Text { x: 27px; text: Studio.browser-section == 3 ? "Search files" : "Search devices"; color: #a5a5a8; font-size: 9px; vertical-alignment: center; }
        TextInput {
            x: 27px; width: parent.width - 34px; height: parent.height;
            text: Studio.browser-search; color: Tokens.text-primary; font-size: 9px; vertical-alignment: center;
            single-line: true;
            accessible-label: Studio.browser-section == 3 ? "Search files" : "Search devices";
            edited => { Studio.browser-search = self.text; Studio.browser-search-edited(self.text); }
            changed has-focus => { Studio.search-focused = self.has-focus; }
        }
    }
    // Sub-tabs (real): 11 px weight 600, -0.03 em, 12 px apart; rest #63656d, active white with
    // a 2 px underline.
    if Studio.browser-section == 2: HorizontalLayout {
        x: 10.2px; y: 59px; width: self.preferred-width; height: 16.7px; spacing: 10.2px;
        for t[i] in ["Instruments", "Effects", "Chains"]: Rectangle {
            width: label.preferred-width;
            accessible-role: tab; accessible-label: t; accessible-checked: Studio.browser-tab == i;
            label := Text {
                x: 0; y: 0; height: 15px; text: t; color: Studio.browser-tab == i ? #ffffff : #63656d;
                font-size: 9.35px; font-weight: 600; letter-spacing: -0.28px; vertical-alignment: center;
            }
            if Studio.browser-tab == i: Rectangle { x: 0; y: 15px; width: parent.width; height: 1.7px; background: #ffffff; }
            TouchArea { clicked => { Studio.browser-tab-select(i); } }
        }
    }
    if Studio.browser-section == 2: Rectangle { x: 0; y: 80px; width: root.width; height: 0.5px; background: Tokens.line-separator; }

    // Tree (rows supplied by Rust; scrolls with the wheel).
    if Studio.browser-section == 2: Rectangle {
        x: 0; y: 81px; width: root.width; height: root.height - 81px - 36px;
        clip: true;
        TouchArea { scroll-event(e) => { Studio.tree-scroll-by(e.delta-y / 1px); accept } }
        if Studio.tree.length == 0 && Studio.tree-empty != "": Text {
            x: 14px; y: 12px; width: parent.width - 28px; text: Studio.tree-empty; color: Tokens.text-tertiary; font-size: 9px; wrap: word-wrap;
        }
        for row[i] in Studio.tree: Rectangle {
            x: 0; y: 4px + i * 22px - Studio.tree-scroll; width: parent.width; height: 21px;
            property <length> indent: row.depth * 6.75px;
            accessible-role: list-item;
            accessible-label: row.label;
            if row.selected: Rectangle { x: 4px; width: parent.width - 8px; border-radius: 4px; background: #2a2b30; }
            for k in row.depth: Rectangle { x: 14px + k * 7px; y: -4px; width: 0.5px; height: 22px; background: Tokens.line-separator; }
            if row.expander != 0: Icon {
                x: 10px + parent.indent; width: 11px; height: 11px;
                d: row.expander == 2 ? Icons.chevron-down : Icons.chevron-right; ink: #a7a7aa;
            }
            Icon {
                x: 24px + parent.indent; width: 14.5px; height: 14.5px;
                d: row.icon == 1 ? Icons.keys : row.icon == 2 ? Icons.effect : Icons.folder; ink: #d0d0d3; stroke-width: 1.3px;
            }
            Text { x: 42.5px + parent.indent; width: parent.width - 42.5px - parent.indent - 44px; text: row.label; color: Tokens.text-primary; font-size: 9.5px; font-weight: 500; vertical-alignment: center; overflow: elide; }
            Text { x: parent.width - 60px; width: 52px; text: row.count; color: #8a8b8e; font-size: 9px; horizontal-alignment: right; vertical-alignment: center; }
            TouchArea {
                clicked => { Studio.tree-click(i); }
                double-clicked => { Studio.tree-activate(i); }
                pointer-event(e) => {
                    if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) { Studio.tree-drag(i, 0, self.absolute-position.x + self.mouse-x, (self.absolute-position.y - Studio.menu-dy) + self.mouse-y); }
                    if (e.button == PointerEventButton.left && e.kind == PointerEventKind.up) { Studio.tree-drag(i, 2, self.absolute-position.x + self.mouse-x, (self.absolute-position.y - Studio.menu-dy) + self.mouse-y); }
                }
                moved => { Studio.tree-drag(i, 1, self.absolute-position.x + self.mouse-x, (self.absolute-position.y - Studio.menu-dy) + self.mouse-y); }
            }
        }
    }
    if Studio.browser-section == 3: FilesPane { x: 0; y: 59px; width: root.width; height: root.height - 59px - 33px; }
    // Preview bar (CSS px × 0.85): sound icon, previous / play-pause / next, volume with the
    // preview's stereo meter (#abfcb6 bars) under the handle, Solo (#f5950a on #1a1a1a), Link.
    // A 1.7 px progress line sits on its top edge while a file is loaded: 6 % white, #1253ff fill.
    Rectangle {
        x: 0; y: root.height - 33px; width: root.width; height: 33px; background: Tokens.bg-panel;
        if Studio.preview-active: Rectangle {
            x: 0; y: -1.7px; width: parent.width; height: 1.7px; background: #ffffff0f;
            Rectangle { x: 0; width: parent.width * Studio.preview-progress; background: #1253ff; }
        }
        Icon { x: 8px; y: 8.5px; width: 17px; height: 17px; d: Icons.wave; ink: #6a6b6f;
            accessible-role: button; accessible-label: "Show the previewed file";
            TouchArea { clicked => { Studio.preview-toggle(); } double-clicked => { Studio.preview-reveal(); } } }
        Icon { x: 42.5px; y: 9.5px; width: 13px; height: 14px; d: Icons.skip-back; ink: #55565c; stroke-width: 1.6px;
            accessible-role: button; accessible-label: "Previous file";
            TouchArea { x: -1px; y: -3px; width: 14px; height: 20px; clicked => { Studio.preview-step(-1); } } }
        Icon { x: 56.5px; y: 9.5px; width: 13px; height: 14px; d: Studio.preview-playing ? Icons.pause : Icons.play; filled: true;
            ink: Studio.preview-playing ? #f0f0f2 : #55565c;
            accessible-role: button; accessible-label: Studio.preview-playing ? "Pause preview" : "Play preview";
            TouchArea { x: -1px; y: -3px; width: 14px; height: 20px; clicked => { Studio.preview-toggle(); } } }
        Icon { x: 71.5px; y: 9.5px; width: 13px; height: 14px; d: Icons.skip-fwd; ink: #55565c; stroke-width: 1.6px;
            accessible-role: button; accessible-label: "Next file";
            TouchArea { x: -1px; y: -3px; width: 14px; height: 20px; clicked => { Studio.preview-step(1); } } }
        Rectangle {
            x: 94.5px; y: 13px; width: 66.5px; height: 7px;
            accessible-role: slider; accessible-label: "Preview volume"; accessible-value: Studio.preview-volume;
            accessible-action-increment => { Studio.preview-volume-moved(min(1, Studio.preview-volume + 0.05)); Studio.preview-volume-done(); }
            accessible-action-decrement => { Studio.preview-volume-moved(max(0, Studio.preview-volume - 0.05)); Studio.preview-volume-done(); }
            Inset { width: parent.width; height: parent.height; border-radius: 3.5px; bottom: #3f4044; }
            Rectangle { x: 1px; y: 1.1px; width: (parent.width - 2px) * Studio.preview-meter-l; height: 2.2px; border-radius: 1.1px; background: #abfcb6; }
            Rectangle { x: 1px; y: 3.7px; width: (parent.width - 2px) * Studio.preview-meter-r; height: 2.2px; border-radius: 1.1px; background: #abfcb6; }
            Rectangle { x: Studio.preview-volume * (parent.width - 7px); width: 7px; height: 7px; border-radius: 3.5px; background: Tokens.handle; }
            TouchArea {
                y: -4px; height: 15px;
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                        Studio.preview-volume-moved(max(0, min(1, (self.mouse-x - 3.5px) / (parent.width - 7px))));
                    }
                    if (e.kind == PointerEventKind.up && e.button == PointerEventButton.left) { Studio.preview-volume-done(); }
                }
                moved => { if (self.pressed) { Studio.preview-volume-moved(max(0, min(1, (self.mouse-x - 3.5px) / (parent.width - 7px)))); } }
                double-clicked => { Studio.preview-volume-moved(Tokens.slider-zero-db); Studio.preview-volume-done(); }
            }
        }
        Rectangle { x: 168.5px; y: 11px; width: 11px; height: 11px; border-radius: 2px; background: Studio.preview-solo ? #f5950a : #2f3032;
            accessible-role: button; accessible-label: "Solo preview"; accessible-checked: Studio.preview-solo;
            Text { text: "S"; font-size: 5.5px; font-weight: 700; color: Studio.preview-solo ? #1a1a1a : #acacad; horizontal-alignment: center; vertical-alignment: center; }
            TouchArea { clicked => { Studio.preview-solo-toggle(); } } }
        Icon { x: 227px; y: 9.5px; width: 16px; height: 15px; d: Icons.link; ink: Tokens.text-tertiary; }
    }
}

// ------------------------------------------------------------------ timeline
// One track header row with its bottom rule and height handle (scrolling list or pinned band).
component TrackRowItem inherits Rectangle {
    in property <TrackRow> t;
    in property <TrackLevel> level;
    in property <bool> rename-target: true;
    callback edit-done();
    TrackHeaderRow { x: 0; y: 0; width: parent.width; height: root.t.row-h; row-h: root.t.row-h; t: root.t; automation: Studio.auto-shown; level: root.level; rename-target: root.rename-target; edit-done => { root.edit-done(); } }
    Rectangle { y: root.t.row-h; height: Tokens.track-pitch - Tokens.track-h; background: root.t.selected ? #353639 : Tokens.line-separator; }
    // Height handle: 6 px at the row's bottom edge.
    TouchArea {
        y: root.t.row-h + 0.5px - 5.1px; height: 5.1px;
        mouse-cursor: row-resize;
        pointer-event(e) => {
            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) { Studio.track-resize(root.t.id, 0, (self.absolute-position.y - Studio.menu-dy) + self.mouse-y); }
            if (e.kind == PointerEventKind.move && self.pressed) { Studio.track-resize(root.t.id, 1, (self.absolute-position.y - Studio.menu-dy) + self.mouse-y); }
            if ((e.button == PointerEventButton.left && e.kind == PointerEventKind.up) || e.kind == PointerEventKind.cancel) { Studio.track-resize(root.t.id, 2, (self.absolute-position.y - Studio.menu-dy) + self.mouse-y); }
        }
    }
}

// "Add track" row: 12 px plus (1.6 px stroke) and a 12 px bold label, 12 px from the left,
// white 40 % (70 % on hover).
component AddTrackButton inherits Rectangle {
    property <color> ink: ta.has-hover ? #ffffffb3 : #ffffff66;
    Path {
        x: 10.2px; y: (root.height - 10.2px) / 2; width: 10.2px; height: 10.2px;
        viewbox-width: 12; viewbox-height: 12;
        commands: "M6 1.75V10.25M1.75 6H10.25"; stroke: root.ink; stroke-width: 1.36px; stroke-line-cap: round;
    }
    Text { x: 25.5px; text: "Add track"; color: root.ink; font-size: 10.2px; font-weight: 700; letter-spacing: -0.408px; vertical-alignment: center; }
    // Opens the Add track menu (Audio, Instrument or Return track) under the label.
    ta := TouchArea { clicked => { Studio.open-add-track-menu(root.absolute-position.x + 8px, (root.absolute-position.y - Studio.menu-dy) + root.height / 2 + 9px); } }
}

// Header minimap: clip bars per track, the visible-window outline with a scrim outside it,
// window grips on hover, and the playhead. 20 CSS px high, 5 px radius.
component Minimap inherits Rectangle {
    // Window in px: at least 6 CSS px wide, kept inside the strip.
    property <length> o: Studio.minimap-win-x * root.width;
    property <length> s: (Studio.minimap-win-x + Studio.minimap-win-w) * root.width;
    property <length> m: 5.1px;
    property <length> wl: max(0px, min(s - o < m ? (o + s) / 2 - m / 2 : o, root.width - m));
    property <length> wr: min(root.width, max(wl + m, s - o < m ? (o + s) / 2 + m / 2 : s));
    property <bool> over-window: ta.has-hover && ta.mouse-x > root.wl && ta.mouse-x < root.wr;
    background: #1a1b1e;
    border-radius: 4.25px;
    clip: true;
    changed width => { Studio.minimap-width = self.width; }
    Rectangle { border-radius: 4.25px; border-width: 0.85px; border-color: #ffffff14; }
    for b in Studio.minimap-bars: Rectangle {
        x: b.x * root.width; y: b.y; width: max(b.w * root.width, 1.0625px); height: b.h; background: b.color;
    }
    Rectangle { x: 0; width: root.wl; background: #0203062b; }
    Rectangle { x: root.wr; width: root.width - root.wr; background: #0203062b; }
    Rectangle { x: root.wl; width: root.wr - root.wl; border-radius: 4.25px; border-width: 0.85px; border-color: #767678; }
    if root.over-window: Rectangle { x: root.wl + 1.7px; y: 2.55px; width: 0.85px; height: root.height - 5.1px; background: #ffffffb3; }
    if root.over-window: Rectangle { x: root.wr - 2.55px; y: 2.55px; width: 0.85px; height: root.height - 5.1px; background: #ffffffb3; }
    if Studio.minimap-playhead >= 0: Rectangle { x: Studio.minimap-playhead * root.width; y: 1.7px; width: 0.85px; height: root.height - 3.4px; background: #ffffff8c; }
    ta := TouchArea {
        mouse-cursor: Studio.pointer-hidden ? MouseCursor.none : (abs(self.mouse-x - root.wl) <= 4.25px || abs(self.mouse-x - root.wr) <= 4.25px) ? MouseCursor.ew-resize : MouseCursor.pointer;
        pointer-event(e) => {
            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                Studio.minimap-pointer(0, self.mouse-x, self.mouse-y, root.width, root.absolute-position.x, (root.absolute-position.y - Studio.menu-dy));
            }
            if ((e.button == PointerEventButton.left && e.kind == PointerEventKind.up) || e.kind == PointerEventKind.cancel) {
                Studio.minimap-pointer(2, self.mouse-x, self.mouse-y, root.width, root.absolute-position.x, (root.absolute-position.y - Studio.menu-dy));
            }
        }
        moved => { if (self.pressed) { Studio.minimap-pointer(1, self.mouse-x, self.mouse-y, root.width, root.absolute-position.x, (root.absolute-position.y - Studio.menu-dy)); } }
        double-clicked => { Studio.minimap-double(); }
        scroll-event(e) => {
            Studio.minimap-scroll(e.delta-x / 1px, e.delta-y / 1px, self.mouse-x, root.width, e.modifiers.control || e.modifiers.alt);
            accept
        }
    }
}

// Devices minimap (src/devminimap.rs): the track's devices in miniature at the right of the
// Clip / Devices strip, with the part the panel shows outlined and the rest in a scrim. 20 CSS px of
// strip minus padding, 5 px radius; the window outline brightens while dragging.
component DevMinimap inherits Rectangle {
    background: #1a1b1e;
    border-radius: 4.25px;
    clip: true;
    init => { Studio.devmm-width = self.width; }
    changed width => { Studio.devmm-width = self.width; }
    Rectangle { border-radius: 4.25px; border-width: 0.85px; border-color: #ffffff14; }
    for t in Studio.devmm-tiles: Rectangle {
        x: t.x; y: t.y; width: t.w; height: t.h;
        background: t.bg;
        if t.art != "": Path {
            width: parent.width; height: parent.height;
            viewbox-width: 127; viewbox-height: 75;
            commands: t.art; fill: t.art-fill;
        }
        if t.art != "": Path {
            width: parent.width; height: parent.height;
            viewbox-width: 127; viewbox-height: 75;
            commands: t.art-accent; fill: t.ink;
        }
    }
    Rectangle { x: 0; width: Studio.devmm-win-x; background: #0203062b; }
    Rectangle { x: Studio.devmm-win-x + Studio.devmm-win-w; width: root.width - self.x; background: #0203062b; }
    Rectangle {
        x: Studio.devmm-win-x; width: Studio.devmm-win-w; border-radius: 4.25px; border-width: 0.85px;
        border-color: Studio.devmm-dragging ? #dddddd : #767678;
    }
    ta := TouchArea {
        mouse-cursor: Studio.pointer-hidden ? MouseCursor.none : MouseCursor.default;
        pointer-event(e) => {
            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                Studio.devmm-pointer(0, self.mouse-x, self.mouse-y, root.absolute-position.x, (root.absolute-position.y - Studio.menu-dy));
            }
            if ((e.button == PointerEventButton.left && e.kind == PointerEventKind.up) || e.kind == PointerEventKind.cancel) {
                Studio.devmm-pointer(2, self.mouse-x, self.mouse-y, root.absolute-position.x, (root.absolute-position.y - Studio.menu-dy));
            }
        }
        moved => { if (self.pressed) { Studio.devmm-pointer(1, self.mouse-x, self.mouse-y, root.absolute-position.x, (root.absolute-position.y - Studio.menu-dy)); } }
        scroll-event(e) => { Studio.devmm-scroll(e.delta-x / 1px, e.delta-y / 1px); accept }
    }
}

component Timeline inherits Panel {
    callback focus-main();
    out property <length> lanes-width: lanes.width;
    out property <length> lanes-height: lanes.height;
    out property <length> lanes-x: lanes.x;
    out property <length> lanes-y: lanes.y;
    out property <length> tracks-y: track-area.y;

    // ---- header row (y 0..27) ----
    // The zoom sliders hide once the header can no longer give the minimap its 140 px minimum
    // and the docked chat is already at its minimum width (AppWindow decides).
    in property <bool> zoom-hidden;
    Text { x: 6.8px; y: 0; height: 27.2px; text: "Timeline"; color: Tokens.text-bright; font-size: 10.2px; font-weight: 700; letter-spacing: -0.41px; vertical-alignment: center; }
    // Returns: shows or hides the return track rows (view state, src/routing.rs). Master pill:
    // shows the master row (static on).
    // Header-row x positions/widths below are the values at 100 % zoom.
    Pill {
        x: 60.35px; y: 5px; width: 59.5px; height: 18px; text: "Returns"; icon: Icons.returns; font-size: 8.75px;
        active: Studio.returns-shown; text-color: Studio.returns-shown ? Tokens.on-accent : #a0a1a5;
        accessible-role: checkbox; accessible-label: Studio.returns-shown ? "Hide return tracks" : "Show return tracks"; accessible-checked: Studio.returns-shown;
        clicked => { Studio.toggle-returns(); }
    }
    Pill { x: 124.1px; y: 5px; width: 59.5px; height: 18px; text: "Master"; icon: Icons.master; active: true; font-size: 8.75px; }
    // Minimap: fills the space up to the right group (src/minimap.rs).
    Minimap { x: 200.6px; y: 5.1px; width: max(0px, rgroup.x - 10.2px - self.x); height: 17px; }
    rgroup := HorizontalLayout {
        x: root.width - self.width - 10.2px; y: 0; width: self.preferred-width; height: 27.2px;
        spacing: 3.4px;
        // Smart Fill: PLACEHOLDER
        Rectangle {
            width: 63.75px + 6.8px;
            Pill { x: 0; y: 5px; width: 63.75px; height: 18px; text: "Smart Fill"; icon: Icons.marquee; font-size: 8.25px; text-color: #a0a1a5; }
        }
        // Show/Hide automation lanes and Draw mode (B) (src/automation.rs).
        Rectangle {
            width: 11.05px + 6.8px;
            Icon {
                x: 0; y: 8.1px; width: 11.05px; height: 11.05px; d: Icons.automation; ink: Studio.auto-shown ? #e5e5e8 : #6b6c70;
                accessible-role: checkbox; accessible-label: Studio.auto-shown ? "Hide automation lanes" : "Show automation lanes"; accessible-checked: Studio.auto-shown;
                TouchArea { x: -3px; y: -2px; width: 20px; height: 18px; clicked => { Studio.auto-toggle-shown(); } }
            }
        }
        Rectangle {
            width: 11.05px + 6.8px;
            Icon {
                x: 0; y: 8.1px; width: 11.05px; height: 11.05px; d: Icons.pencil; ink: Studio.auto-draw ? #e5e5e8 : #6b6c70;
                accessible-role: checkbox; accessible-label: "Draw mode (B)"; accessible-checked: Studio.auto-draw;
                TouchArea { x: -3px; y: -2px; width: 19px; height: 18px; clicked => { Studio.auto-toggle-draw(); } }
            }
        }
        Rectangle {
            width: 25px + 1.7px;
            Icon { x: 0; y: 7px; width: 13px; height: 13px; d: Icons.cursor; ink: #e5e5e8; filled: true; }
            Icon { x: 14px; y: 8px; width: 11px; height: 11px; d: Icons.chevron-down; ink: #8e8f93; }
        }
        // vertical zoom (placeholder), horizontal zoom (mirrors the real zoom level)
        if !root.zoom-hidden: Rectangle {
            width: 172px;
            Icon { x: 0; y: 7px; width: 13px; height: 13px; d: Icons.v-resize; ink: #727377; }
            Rectangle { x: 18.4px; y: 13px; width: 68px; height: 2px; border-radius: 1px; background: #2f3036; }
            Rectangle { x: 18.4px; y: 13px; width: 8px; height: 2px; background: #e5e5e8; }
            Rectangle { x: 24.5px; y: 10px; width: 8px; height: 8px; border-radius: 4px; background: #f2f2f2; }
            Icon { x: 91.4px; y: 7px; width: 13px; height: 13px; d: Icons.h-resize; ink: #727377; }
            Rectangle { x: 110.2px; y: 13px; width: 68px; height: 2px; border-radius: 1px; background: #2f3036; }
            Rectangle { x: 110.2px; y: 13px; width: 8px; height: 2px; background: #e5e5e8; }
            Rectangle { x: 116px; y: 10px; width: 8px; height: 8px; border-radius: 4px; background: #f2f2f2; }
        }
        // Snap: the readout toggles snapping, the chevron opens the grid-size menu (S76).
        Rectangle {
            width: 44.2px;
            Text { x: 0; y: 7px; width: 28.9px; height: 14px; text: Studio.snap-text; color: Studio.snap-text == "Off" ? #8e8f93 : Tokens.text-bright; font-size: 9px; font-weight: 600; letter-spacing: -0.36px; vertical-alignment: center; horizontal-alignment: right; }
            Icon { x: 32.3px; y: 8px; width: 11.9px; height: 11px; d: Icons.chevron-down; ink: Studio.snap-menu-open ? #ffffff : #c9c9cc; }
            TouchArea { x: 0; width: 30px; clicked => { Studio.snap-toggle(); } }
            TouchArea { x: 30px; width: 14.2px; clicked => { Studio.snap-menu-toggle(parent.absolute-position.x + parent.width, (parent.absolute-position.y - Studio.menu-dy) + parent.height); } }
        }
    }
    Rectangle { x: 0; y: 27px; width: root.width; height: 0.5px; background: Tokens.line-separator; }

    // ---- lanes: wgpu texture (ruler + lanes + master lane) ----
    lanes := Rectangle {
        x: Tokens.lane-x; y: 27.5px; width: root.width - Tokens.lane-x; height: root.height - 27.5px;
        clip: true;
        Image { x: 0; y: 0; width: parent.width; height: parent.height; source: Studio.timeline-image; image-fit: fill; }
        for l in Studio.ruler-labels: Text {
            x: l.x + 4.5px; y: 0px; height: 11px; text: l.text; color: #bdbdbd; font-size: 7.75px; font-weight: 600; vertical-alignment: center;
        }
        Icon { x: Studio.section-add-x - 5.5px; y: 26.5px; width: 11px; height: 11px; d: Icons.plus; ink: Tokens.text-tertiary; }
        // Section names: 10 px weight 600, -0.04 em, in a dark shade of the block's hue.
        for l in Studio.section-labels: Text {
            x: l.x; y: 25.85px; width: l.w; height: 11.9px; text: l.text; color: l.ink;
            font-size: 8.5px; font-weight: 600; letter-spacing: -0.34px; vertical-alignment: center; overflow: elide;
        }
        for c in Studio.clip-labels: Text {
            x: c.x + 5px; y: c.y; width: max(0px, c.w - 8px); height: 17px;
            text: c.text; color: Studio.auto-shown ? #191b24 : #15161a; font-size: 7.75px; font-weight: 500; vertical-alignment: center; overflow: elide;
        }
        // Automation value labels in the parameter's hue (dim while the lane has no points, grey while off).
        for l in Studio.auto-labels: Text {
            x: l.x; y: l.y + 0.75px; height: 13px; text: l.text; font-size: 9.25px; font-weight: 600; vertical-alignment: center;
            color: l.state == 1 ? l.accent : l.state == 2 ? #6a6b6f : l.dim;
        }
        if Studio.marquee-on: Rectangle {
            x: Studio.marquee-x; y: Studio.marquee-y; width: Studio.marquee-w; height: Studio.marquee-h;
            background: #ffffff0f; border-width: 1px; border-color: #ffffff59;
        }
        TouchArea {
            mouse-cursor: Studio.lane-cursor == 1 ? MouseCursor.ew-resize : Studio.lane-cursor == 2 ? MouseCursor.move : MouseCursor.default;
            pointer-event(e) => {
                if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                    Studio.lane-pointer(0, self.mouse-x, self.mouse-y, e.modifiers.shift, e.modifiers.control, e.modifiers.alt);
                }
                if (e.button == PointerEventButton.left && e.kind == PointerEventKind.up) {
                    Studio.lane-pointer(2, self.mouse-x, self.mouse-y, e.modifiers.shift, e.modifiers.control, e.modifiers.alt);
                }
                if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down) {
                    Studio.lane-context(self.mouse-x, self.mouse-y, self.absolute-position.x + self.mouse-x, (self.absolute-position.y - Studio.menu-dy) + self.mouse-y);
                }
            }
            moved => { Studio.lane-pointer(1, self.mouse-x, self.mouse-y, false, false, false); }
            changed mouse-x => { if (!self.pressed) { Studio.lane-hover(self.mouse-x, self.mouse-y); } }
            changed mouse-y => { if (!self.pressed) { Studio.lane-hover(self.mouse-x, self.mouse-y); } }
            scroll-event(e) => {
                Studio.lane-scroll(e.delta-x / 1px, e.delta-y / 1px, self.mouse-x, e.modifiers.control || e.modifiers.alt);
                accept
            }
        }
    }

    // ---- track header column ----
    AddTrackButton { x: 0; y: 27.5px; width: 184px; height: 39px; }
    Rectangle { x: 0; y: 66px; width: Tokens.lane-x; height: 0.5px; background: Tokens.line-separator; }
    track-area := Rectangle {
        x: 0; y: 66.5px; width: Tokens.lane-x - 0.5px; height: root.height - 66.5px - Studio.master-h - 0.5px - Studio.pinned-h;
        clip: true;
        TouchArea {
            scroll-event(e) => { Studio.lane-scroll(0, e.delta-y / 1px, 0, false); accept }
        }
        for t[i] in Studio.tracks: TrackRowItem {
            // Rows of a folded group's tracks have no height and don't show.
            visible: !t.pinned && t.h > 0; rename-target: !t.pinned;
            x: 0; y: t.y - Studio.scroll-y; width: parent.width; height: t.h;
            t: t; level: Studio.track-levels[i];
            edit-done => { root.focus-main(); }
        }
        // Reorder drag: the drop line between two rows (src/track_menu.rs).
        if Studio.track-drop-on: Rectangle {
            x: 0; y: Studio.track-drop-y - Studio.scroll-y - 1px; width: parent.width; height: 2px;
            background: Tokens.accent;
        }
        // Expanded automation rows (src/automation.rs, EXTRA_H + separator): well fill, a 1 px
        // white 5 % top rule, and the pill 48 px in.
        for e in Studio.auto-extras: Rectangle {
            x: 0; y: e.y - Studio.scroll-y; width: parent.width; height: 40.5px;
            background: #17181b;
            Rectangle { height: 0.85px; background: #ffffff0d; }
            AutoPill {
                x: 40.8px; y: (40px - self.height) / 2; width: parent.width - 47.6px; cat: e.cat; param: e.param; state: e.state; accent: e.accent; chevron: false;
                power => { Studio.auto-power(e.track-id, e.index); }
                open(x, y) => { Studio.auto-show-extra(e.track-id, e.index); }
            }
            Rectangle { y: 40px; height: 0.5px; background: Tokens.line-separator; }
        }
        property <length> tracks-end: Studio.tracks-height - Studio.scroll-y;
        // Fills the column below the last track (at least one track high) and runs on under the
        // pinned master row, which covers it when space is short.
        AddTrackButton {
            x: 0; y: parent.tracks-end; width: parent.width;
            height: max(Tokens.track-pitch, parent.height + Studio.master-h + 0.5px - parent.tracks-end);
        }
    }
    // ---- pinned return track rows (src/routing.rs): their own group above the master row ----
    if Studio.pinned-h > 0: Rectangle {
        x: 0; y: root.height - Studio.master-h - 0.5px - Studio.pinned-h; width: Tokens.lane-x - 0.5px; height: Studio.pinned-h;
        clip: true;
        background: Tokens.bg-panel;
        for t[i] in Studio.tracks: TrackRowItem {
            visible: t.pinned; rename-target: t.pinned;
            x: 0; y: t.y; width: parent.width; height: t.h;
            t: t; level: Studio.track-levels[i];
            edit-done => { root.focus-main(); }
        }
        // Group divider above the first return row.
        Rectangle { y: 0; height: 1.5px; background: #5a5b60; }
    }
    Rectangle { x: Tokens.lane-x - 0.5px; y: 27.5px; width: 0.5px; height: root.height - 27.5px; background: Tokens.line-separator; }

    // ---- master row (36 px; 76 px with the automation row) ----
    Rectangle { x: 0; y: root.height - Studio.master-h - 0.5px; width: Tokens.lane-x - 0.5px; height: 0.5px; background: Tokens.line-separator; }
    MasterHeaderRow {
        edit-done => { root.focus-main(); }
        x: 0; y: root.height - Studio.master-h; width: Tokens.lane-x - 0.5px; height: Studio.master-h;
        automation: Studio.auto-shown; volume-pos: Studio.master-pos; vol-auto: Studio.master-vol-auto;
        level: Studio.master-level; auto-state: Studio.master-auto-state; muted: Studio.master-mute;
    }
}

// ------------------------------------------------------------------ bottom panel
component Inspector inherits Rectangle {
    callback focus-main();
    // Readouts are the track colour pulled toward grey (#c670f7 track -> #a66bca text,
    // #72b6d7 -> #77a6bd, #8092eb -> #7b87c3; this mix gives all three within a few levels).
    property <color> value-color: Studio.sel-color.mix(#7d7e80, 0.62);
    // inspector header
    // Colour tab flush with the panel edge: 4 x 19 pt at y 6.5 pt (100 % zoom).
    Rectangle { x: 0px; y: 5.5px; width: 3.4px; height: 16.15px; border-radius: 1.7px; background: Studio.sel-color; }
    Text { visible: Studio.has-selection; x: 10.5px; y: 7px; height: 13px; text: Studio.sel-return ? Studio.sel-letter : Studio.sel-number; color: Tokens.text-bright; font-size: 9px; font-weight: 700; vertical-alignment: center; }
    Icon { visible: Studio.has-selection; x: 21px; y: 8px; width: 11px; height: 11px; d: Studio.sel-return ? Icons.returns : Studio.sel-group ? Icons.folder : Studio.sel-instrument ? Icons.keys : Icons.wave; ink: #a8a8ab; stroke-width: 1.1px; }
    if !Studio.has-selection: Label { x: 37px; y: 7px; text: "No track selected"; color: Tokens.text-bright; font-size: 10px; }
    if Studio.has-selection: TrackName { x: 37px; y: 7px; width: 120px; height: 14.5px; track-id: Studio.sel-id; text: Studio.sel-name; text-color: Tokens.text-bright; font-size: 10px; font-weight: 600; letter-spacing: 0; review-edit: Studio.review-rename; edit-done => { root.focus-main(); } }

    // In: audio tracks open the input selector (SetTrackInput; popup drawn by AppWindow). Instrument
    // tracks open the instrument selector (built-in Synth or an instrument plugin: SetInstrumentPlugin).
    // Return tracks have no input: a "Return" label instead.
    // Out: Master or a return track (SetTrackOutput, src/routing.rs); fixed to Master on returns.
    // Group tracks have no input: their Out selector takes the top row.
    if Studio.sel-return: Raised {
        x: 10px; y: 37px; width: 149px; height: 19px; border-radius: 9.5px;
        Text { x: 7.5px; text: "Return"; color: Tokens.text-tertiary; font-size: 9.5px; font-weight: 600; vertical-alignment: center; }
    }
    if !Studio.sel-return && !Studio.sel-group: Raised {
        x: 10px; y: 37px; width: 149px; height: 19px; border-radius: 9.5px;
        Text { x: 7.5px; text: Studio.sel-instrument ? "Inst" : "In"; color: Tokens.text-tertiary; font-size: 9.5px; font-weight: 600; vertical-alignment: center; }
        Text { x: Studio.sel-instrument ? 29.5px : 21px; width: 134px - self.x - 4px; text: Studio.sel-instrument ? Studio.sel-inst-text : Studio.sel-input-text; color: Tokens.text-bright; font-size: 9.5px; font-weight: 600; vertical-alignment: center; overflow: elide; }
        Icon { x: 134px; width: 10px; height: 10px; d: Icons.chevron-down; ink: #a0a0a3; }
        accessible-role: combobox; accessible-label: Studio.sel-instrument ? "Inst" : "In"; accessible-value: Studio.sel-instrument ? Studio.sel-inst-text : Studio.sel-input-text;
        TouchArea { clicked => { if (Studio.sel-instrument) { Studio.open-inst-menu(parent.absolute-position.x + 1px, (parent.absolute-position.y - Studio.menu-dy) + parent.height + 3px); } else if (Studio.has-selection) { Studio.open-input-menu(); } } }
    }
    Raised {
        x: 10px; y: Studio.sel-group ? 37px : 63px; width: 149px; height: 18px; border-radius: 9px;
        Text { x: 7.5px; text: "Out"; color: Tokens.text-tertiary; font-size: 9.5px; font-weight: 600; vertical-alignment: center; }
        Text { x: 29.5px; width: 134px - self.x - 4px; text: Studio.sel-out-text; color: Tokens.text-bright; font-size: 9.5px; font-weight: 600; vertical-alignment: center; overflow: elide; }
        if Studio.sel-can-route: Icon { x: 134px; width: 10px; height: 10px; d: Icons.chevron-down; ink: #a0a0a3; }
        accessible-role: combobox; accessible-label: "Out"; accessible-value: Studio.sel-out-text;
        TouchArea { clicked => { if (Studio.sel-can-route) { Studio.open-out-menu(parent.absolute-position.x + 1px, (parent.absolute-position.y - Studio.menu-dy) + parent.height + 3px); } } }
    }
    // Input / Sends tabs: 24 pt row, 12 pt bold, centred 24 pt apart; the Sends tab adds a "+"
    // (add a send) after its label. View state only (Studio.strip-tab, so review states can open
    // the Sends tab).
    property <int> tab <=> Studio.strip-tab;
    for t[i] in [ {label: "Input", x: 56}, {label: "Sends", x: 108} ]: Text {
        x: t.x * StripMetrics.u; y: 104 * StripMetrics.u; height: 24 * StripMetrics.u;
        text: t.label; font-size: 12 * StripMetrics.u; font-weight: 700; letter-spacing: -0.48 * StripMetrics.u; vertical-alignment: center;
        color: root.tab == i ? #ffffff : tab-ta.has-hover ? #ffffffb3 : #63656d;
        tab-ta := TouchArea { clicked => { root.tab = i; } }
    }
    // "+" beside Sends (while the tab is open): a new return track; every track gets a silent
    // send slot for it, and this track stays selected.
    if root.tab == 1 && Studio.sel-can-send && Studio.can-add-return: Rectangle {
        x: 146 * StripMetrics.u; y: 108 * StripMetrics.u; width: 16 * StripMetrics.u; height: 16 * StripMetrics.u;
        Icon { x: 3 * StripMetrics.u; y: 3 * StripMetrics.u; width: 10 * StripMetrics.u; height: 10 * StripMetrics.u; d: Icons.plus; ink: send-add.has-hover ? #ffffffb3 : #63656d; stroke-width: 1.4px; }
        send-add := TouchArea {
            clicked => { Studio.sends-add-return(Studio.sel-id); }
            accessible-role: button; accessible-label: "Add return track";
        }
    }
    // Sends tab: one knob per return track, two to a row like the Input tab's knobs: a Post / Pre
    // chip above (once the send is stored), the level knob, its dB value and the return's name.
    // A silent slot (nothing sent yet, or all the way down) is dim; moving its knob sends.
    // Double-clicking a knob sets 0 dB. With no return tracks, a dim "Return A" placeholder
    // creates the return and sends to it at 0 dB.
    if root.tab == 1: sends-list := Rectangle {
        x: 0; y: 128 * StripMetrics.u; width: 170px; height: 324 * StripMetrics.u - self.y - 4px;
        clip: true;
        property <length> cell-h: 78px;
        property <int> rows: (Studio.sel-sends.length + 1) / 2;
        // More returns than fit scroll with the wheel.
        property <length> max-scroll: max(0px, self.rows * self.cell-h + 6px - self.height);
        property <length> scroll: min(self.scroll-raw, self.max-scroll);
        property <length> scroll-raw: 0px;
        if !Studio.sel-can-send: Text {
            x: 10px; y: 10px; width: 150px; text: Studio.has-selection ? "Return tracks have no sends." : ""; color: #63656d; font-size: 9.5px; font-weight: 600; wrap: word-wrap;
        }
        TouchArea {
            scroll-event(e) => {
                if (sends-list.max-scroll <= 0) { return reject; }
                sends-list.scroll-raw = max(0px, min(sends-list.max-scroll, sends-list.scroll - e.delta-y));
                accept
            }
        // Placeholder: no return tracks yet.
        if Studio.sel-can-send && Studio.sel-sends.length == 0: Rectangle {
            x: 10px; y: 6px; width: 74px; height: sends-list.cell-h;
            Knob { x: 18px; y: 14px; width: 38px; height: 38px; body: 20.5px; groove: true; show-arc: false; value-angle: -135; tick-color: #63656d; arc-color: #63656d; }
            Text { x: 0; y: 50px; width: parent.width; height: 13px; text: "−∞"; color: #4a4b50; font-size: 9px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
            Text { x: 0; y: 65px; width: parent.width; height: 14px; text: "Return A"; color: new-ta.has-hover ? Tokens.text-primary : #63656d; font-size: 9.5px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
            new-ta := TouchArea {
                clicked => { Studio.send-new-return(Studio.sel-id); }
                accessible-role: button; accessible-label: "Create Return A and send to it";
            }
        }
        for r[k] in Studio.sel-sends: Rectangle {
            x: mod(k, 2) == 0 ? 10px : 86px; y: 6px + floor(k / 2) * sends-list.cell-h - sends-list.scroll; width: 74px; height: sends-list.cell-h;
            property <color> value-color: r.live ? r.color.mix(#7d7e80, 0.62) : #4a4b50;
            if r.stored: Rectangle {
                x: (parent.width - 26px) / 2; y: 0; width: 26px; height: 12px;
                Text { text: r.pre ? "Pre" : "Post"; color: r.pre ? Tokens.text-primary : (chip-ta.has-hover ? #ffffffb3 : #63656d); font-size: 8.5px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                chip-ta := TouchArea {
                    clicked => { Studio.send-toggle-pre(r.track, r.target); }
                    accessible-role: button; accessible-label: (r.pre ? "Pre-fader send to " : "Post-fader send to ") + r.name;
                }
            }
            Knob {
                x: 18px; y: 14px; width: 38px; height: 38px; body: 20.5px; groove: true; show-arc: r.live; arc-from: -135;
                min-value: 0; max-value: 1; value: r.pos; value-angle: -135 + r.pos * 270; tick-color: r.live ? #ffffff : #63656d; arc-color: parent.value-color;
                value-changed(v) => { Studio.send-pos(r.track, r.target, v); }
                released => { Studio.send-gesture-end(); }
                reset => { Studio.send-reset(r.track, r.target); }
                accessible-role: slider; accessible-label: "Send to " + r.name; accessible-value: r.db-text;
                accessible-action-increment => { Studio.send-pos(r.track, r.target, min(1, r.pos + 0.02)); Studio.send-gesture-end(); }
                accessible-action-decrement => { Studio.send-pos(r.track, r.target, max(0, r.pos - 0.02)); Studio.send-gesture-end(); }
            }
            Text { x: 0; y: 50px; width: parent.width; height: 13px; text: r.live ? r.db-text : "−∞"; color: parent.value-color; font-size: 9px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
            Text { x: 0; y: 65px; width: parent.width; height: 14px; text: r.name; color: r.live ? Tokens.text-primary : #63656d; font-size: 9.5px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
        }
        }
        if sends-list.max-scroll > 0: Rectangle {
            x: parent.width - 3px; y: sends-list.scroll / (sends-list.rows * sends-list.cell-h + 6px) * parent.height; width: 2px;
            height: parent.height * parent.height / (sends-list.rows * sends-list.cell-h + 6px); border-radius: 1px; background: #ffffff33;
        }
    }
    Rectangle { x: 10px; y: 128 * StripMetrics.u - 0.5px; width: 150px; height: 0.5px; background: #ffffff14; }

    if root.tab == 0: Rectangle {
        x: 0; y: 0; width: root.width; height: root.height;
        // Trim (dB, bipolar around 0), width (0..200 %, 100 % at the top) and mono: spec 004.
        // A knob drag is one undo step; double-click resets.
        Knob {
            x: 28px; y: 122px; width: 38px; height: 38px; body: 20.5px; groove: true; tick-color: #ffffff; arc-color: root.value-color;
            min-value: -24; max-value: 24; value: Studio.sel-trim; value-angle: Studio.sel-trim / 24 * 135;
            value-changed(v) => { if (Studio.has-selection) { Studio.track-trim(Studio.sel-id, v); } }
            released => { Studio.strip-gesture-end(); }
            reset => { if (Studio.has-selection) { Studio.track-trim(Studio.sel-id, 0); Studio.strip-gesture-end(); } }
            context(x, y) => { if (Studio.has-selection) { Studio.strip-menu(Studio.sel-id, 3, x, y - Studio.menu-dy); } }
            accessible-role: slider; accessible-label: "Trim"; accessible-value: Studio.sel-trim-text;
            accessible-action-increment => { if (Studio.has-selection) { Studio.track-trim(Studio.sel-id, min(24, Studio.sel-trim + 0.5)); Studio.strip-gesture-end(); } }
            accessible-action-decrement => { if (Studio.has-selection) { Studio.track-trim(Studio.sel-id, max(-24, Studio.sel-trim - 0.5)); Studio.strip-gesture-end(); } }
        }
        Text { x: 10px; y: 158px; width: 74px; height: 13px; text: Studio.sel-trim-text; color: root.value-color; font-size: 9px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
        Text { x: 10px; y: 173px; width: 74px; height: 14px; text: "Trim"; color: Tokens.text-primary; font-size: 9.5px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
        Knob {
            x: 104px; y: 122px; width: 38px; height: 38px; body: 20.5px; groove: true; show-arc: true; arc-from: -135; tick-color: #ffffff; arc-color: root.value-color;
            opacity: Studio.sel-mono ? 0.45 : 1;   // mono overrides the width
            min-value: 0; max-value: 2; value: Studio.sel-width; value-angle: -135 + Studio.sel-width / 2 * 270;
            value-changed(v) => { if (Studio.has-selection) { Studio.track-width(Studio.sel-id, v); } }
            released => { Studio.strip-gesture-end(); }
            reset => { if (Studio.has-selection) { Studio.track-width(Studio.sel-id, 1); Studio.strip-gesture-end(); } }
            context(x, y) => { if (Studio.has-selection) { Studio.strip-menu(Studio.sel-id, 4, x, y - Studio.menu-dy); } }
            accessible-role: slider; accessible-label: "Width"; accessible-value: Studio.sel-width-text;
            accessible-action-increment => { if (Studio.has-selection) { Studio.track-width(Studio.sel-id, min(2, Studio.sel-width + 0.05)); Studio.strip-gesture-end(); } }
            accessible-action-decrement => { if (Studio.has-selection) { Studio.track-width(Studio.sel-id, max(0, Studio.sel-width - 0.05)); Studio.strip-gesture-end(); } }
        }
        Text { x: 86px; y: 158px; width: 74px; height: 13px; text: Studio.sel-width-text; color: root.value-color; font-size: 9px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
        Text { x: 86px; y: 173px; width: 74px; height: 14px; text: "Width"; color: Tokens.text-primary; font-size: 9.5px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
        Knob {
            x: 28px; y: 191px; width: 38px; height: 38px; body: 20.5px; groove: true; arc-color: root.value-color;
            value: Studio.sel-pan; value-angle: Studio.sel-pan * 135; tick-color: Studio.sel-pan-auto ? #65bce3 : #ffffff;
            value-changed(v) => { if (Studio.has-selection) { Studio.track-pan(Studio.sel-id, v); } }
            released => { Studio.gesture-end(); }
            reset => { if (Studio.has-selection) { Studio.track-pan(Studio.sel-id, 0); Studio.gesture-end(); } }
            context(x, y) => { if (Studio.has-selection) { Studio.strip-menu(Studio.sel-id, 1, x, y - Studio.menu-dy); } }
        }
        Text { x: 10px; y: 228px; width: 74px; height: 13px; text: Studio.sel-pan-text; color: root.value-color; font-size: 9px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
        Text { x: 10px; y: 243px; width: 74px; height: 13px; text: "Pan"; color: Tokens.text-primary; font-size: 9.5px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
        Switch {
            x: 112.5px; y: 205px; on: Studio.sel-mono;
            toggled => { if (Studio.has-selection) { Studio.track-mono(Studio.sel-id); } }
            context(x, y) => { if (Studio.has-selection) { Studio.strip-menu(Studio.sel-id, 5, x, y - Studio.menu-dy); } }
            accessible-role: checkbox; accessible-label: "Mono"; accessible-checked: Studio.sel-mono;
            accessible-action-default => { if (Studio.has-selection) { Studio.track-mono(Studio.sel-id); } }
        }
        Text { x: 86px; y: 228px; width: 74px; height: 13px; text: Studio.sel-mono ? "On" : "Off"; color: root.value-color; font-size: 9px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
        Text { x: 86px; y: 243px; width: 74px; height: 13px; text: "Mono"; color: Tokens.text-primary; font-size: 9.5px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
    }

    // M / S / R / I (R / I: SetTrackArm / SetTrackMonitor on audio tracks; PLACEHOLDERS on
    // instrument tracks). 22 x 20 pt, 4 pt apart, on the peak box's row.
    for b[i] in [ {t: "M", on: Studio.sel-mute}, {t: "S", on: Studio.sel-solo}, {t: "R", on: Studio.sel-arm}, {t: "I", on: Studio.sel-monitor} ]: StripButton {
        x: (50 + i * 26) * StripMetrics.u; y: 324 * StripMetrics.u; big: true; text: b.t; kind: i; on: b.on;
        visible: i < 2 || !(Studio.sel-return || Studio.sel-group);   // return and group tracks: M / S only
        clicked => {
            if (i == 0) { Studio.track-mute(Studio.sel-id); }
            if (i == 1) { Studio.track-solo(Studio.sel-id); }
            if (i == 2) { Studio.track-arm(Studio.sel-id); }
            if (i == 3) { Studio.track-monitor(Studio.sel-id); }
        }
        context(x, y) => { if (i == 0 && Studio.has-selection) { Studio.strip-menu(Studio.sel-id, 2, x, y - Studio.menu-dy); } }
    }

    // Meter column (92 pt at x 196): gain readout, fader canvas, peak box (6 pt gaps).
    StripReadout { x: 218 * StripMetrics.u; y: 44.5 * StripMetrics.u; width: 70 * StripMetrics.u; height: 20 * StripMetrics.u; text: Studio.sel-db-text; }
    StripCanvas {
        x: 196 * StripMetrics.u; y: 70.5 * StripMetrics.u; height: 248 * StripMetrics.u;
        enabled: Studio.has-selection;
        fader: Studio.sel-fader; meter-l: Studio.sel-meter-l; meter-r: Studio.sel-meter-r;
        fill: Studio.sel-vol-auto ? #ebc542 : Studio.sel-color;
        cap: Studio.sel-vol-auto ? #e9d38e : #fdf8f0;
        moved(f) => { Studio.sel-fader-moved(f); }
        released => { Studio.gesture-end(); }
        reset => { Studio.sel-fader-moved(0.2); Studio.gesture-end(); }
        context(x, y) => { if (Studio.has-selection) { Studio.strip-menu(Studio.sel-id, 0, x, y - Studio.menu-dy); } }
    }
    StripReadout {
        x: 218 * StripMetrics.u; y: 324.5 * StripMetrics.u; width: 70 * StripMetrics.u; height: 20 * StripMetrics.u;
        text: Studio.sel-peak-text; ink: Studio.sel-peak-text == "−∞" ? #ffffff4d : #ffffff99;
    }
}

component BottomPanel inherits Panel {
    callback focus-main();
    if Studio.bottom-tab == 0: Inspector { x: 0; y: 0; width: 254.5px; height: root.height; focus-main => { root.focus-main(); } }
    if Studio.bottom-tab == 1: ClipSidebar { x: 0; y: 0; width: 254.5px; height: root.height; focus-main => { root.focus-main(); } }
    Rectangle { x: 254.5px; y: 0; width: 0.5px; height: root.height; background: Tokens.line-separator; }
    Rectangle { x: 0; y: 26.5px; width: root.width; height: 0.5px; background: Tokens.line-separator; }
    // Clip / Devices tabs (real: switch the bottom panel content)
    Label {
        x: 261px; y: 7px; text: "Clip";
        color: Studio.bottom-tab == 1 ? Tokens.text-bright : Tokens.text-tertiary; font-size: 10px; font-weight: Studio.bottom-tab == 1 ? 600 : 500;
        TouchArea { clicked => { Studio.set-bottom-tab(1); } }
    }
    Label {
        x: 286px; y: 7px; text: "Devices";
        color: Studio.bottom-tab == 0 ? Tokens.text-bright : Tokens.text-tertiary; font-size: 10px; font-weight: Studio.bottom-tab == 0 ? 600 : 500;
        TouchArea { clicked => { Studio.set-bottom-tab(0); } }
    }
    // Pattern clips: Sequencer / Piano roll tabs.
    if Studio.bottom-tab == 1 && Studio.seq-tabs: Rectangle {
        Rectangle { x: 336px; y: 8px; width: 0.5px; height: 11px; background: Tokens.line-separator; }
        Label {
            x: 347px; y: 7px; text: "Sequencer";
            color: Studio.seq-visible ? Tokens.text-bright : Tokens.text-tertiary; font-size: 10px; font-weight: Studio.seq-visible ? 600 : 500;
            TouchArea { clicked => { Studio.seq-tab(false); } }
        }
        Label {
            x: 404.5px; y: 7px; text: "Piano roll";
            color: !Studio.seq-visible ? Tokens.text-bright : Tokens.text-tertiary; font-size: 10px; font-weight: !Studio.seq-visible ? 600 : 500;
            TouchArea { clicked => { Studio.seq-tab(true); } }
        }
    }
    if Studio.bottom-tab == 1 && Studio.seq-visible: StepSequencer { x: 255px; y: 27px; width: root.width - 255px; height: root.height - 27px; }
    if Studio.bottom-tab == 1 && !Studio.seq-visible && (Studio.pr-visible || Studio.ac-visible): PianoRoll { x: 255px; y: 27px; width: root.width - 255px; height: root.height - 27px; }
    if Studio.bottom-tab == 1 && !Studio.pr-visible && !Studio.ac-visible: ClipEmpty { x: 255px; y: 27px; width: root.width - 255px; height: root.height - 27px; }
    if Studio.bottom-tab == 0 && Studio.devmm-visible: DevMinimap { x: root.width - 252.45px; y: 3.4px; width: 192.95px; height: 20.4px; }
    IconButton { x: root.width - 53px; y: 3px; width: 21px; height: 21px; icon: Icons.panel-bottom; ink: #6b6c70; icon-size: 14px; }
    IconButton { x: root.width - 29px; y: 3px; width: 21px; height: 21px; icon: Studio.bottom-collapsed ? Icons.upload : Icons.download; ink: #6b6c70; icon-size: 14px;
        tooltip: Studio.bottom-collapsed ? "Expand the bottom panel" : "Collapse the bottom panel"; clicked => { Studio.bottom-collapse-toggle(); } }
    // Device chain (Devices tab): built-in Synth card (instrument tracks without an instrument
    // plugin; src/synth.rs), plugin cards (src/devices.rs), then "Add device". Positions come
    // from Rust (bottom-panel relative, scroll included); the area clips at the inspector edge.
    if Studio.bottom-tab == 0: Rectangle {
        x: 255px; y: 27px; width: root.width - 255px; height: root.height - 27px;
        clip: true;
        TouchArea {
            scroll-event(e) => { Studio.chain-scroll-by(e.delta-x != 0 ? e.delta-x / 1px : e.delta-y / 1px); accept }
        }
        if Studio.synth-visible && !Studio.synth-card.folded: SynthDevice { x: 263.5px - 255px - Studio.chain-scroll; y: 34px - 27px; }
        if Studio.synth-visible && Studio.synth-card.folded: FoldedStrip { x: 263.5px - 255px - Studio.chain-scroll; y: 34px - 27px; card: Studio.synth-card; }
        // Chain heads frame their members; an empty chain offers "Add effect".
        for f in Studio.chain-frames: Rectangle {
            x: f.x - 255px; y: 34px - 27px - 5px; width: f.w; height: 265px + 10px; border-radius: 9px;
            background: #1b1c20; border-width: f.armed ? 1px : 0.5px; border-color: f.armed ? f.color : #3a3b40;
        }
        for f in Studio.chain-frames: Rectangle {
            visible: f.empty;
            x: f.empty-x - 255px; y: 34px - 27px; width: 182.5px; height: 265px; border-radius: 6px;
            background: empty-ta.has-hover ? #222328 : #1f2024; border-width: 0.5px; border-color: #313236;
            accessible-role: button; accessible-label: "Add effect";
            HorizontalLayout {
                alignment: center; spacing: 6px;
                Icon { y: (265px - 12px) / 2; width: 12px; height: 12px; d: Icons.plus; ink: #c5c5c8; stroke-width: 1.4px; }
                Text { text: "Add effect"; color: #c5c5c8; font-size: 10px; font-weight: 600; vertical-alignment: center; }
            }
            empty-ta := TouchArea { enabled: f.empty; clicked => { Studio.chain-add-effect(f.head, self.absolute-position.x + 20px, (self.absolute-position.y - Studio.menu-dy) + 120px); } }
        }
        for card in Studio.device-cards: Rectangle {
            x: card.x - 255px; y: 34px - 27px; width: card.width; height: 265px;
            if !card.builtin: PluginCard { x: 0; y: 0; card: card; }
            if card.builtin: BuiltinCard { x: 0; y: 0; card: card; }
        }
        AddDeviceCard { x: Studio.add-device-x - 255px; y: 34.5px - 27px; }
        if Studio.chain-marker-visible: Rectangle { x: Studio.chain-marker-x - 255px - 1px; y: 34px - 27px; width: 2px; height: 265px; border-radius: 1px; background: Tokens.accent; }
    }
}

// Automation parameter popup: search field + category rows (or search results).
component AutoPicker inherits Rectangle {
    callback done();
    border-radius: 7px; background: #212227; border-width: 0.5px; border-color: #46474b;
    drop-shadow-blur: 12px; drop-shadow-color: #00000080; drop-shadow-offset-y: 4px;
    TouchArea { }
    Rectangle {
        x: 7.5px; y: 5.5px; width: parent.width - 15px; height: 20.5px; border-radius: 10.25px;
        background: #292a2f; border-width: 0.5px; border-color: #35363a;
        Icon { x: 6.5px; y: 4.5px; width: 12px; height: 12px; d: Icons.search; ink: #a6a8ac; stroke-width: 1.5px; }
        if Studio.picker-query == "": Text { x: 24px; height: parent.height; text: "Search parameters…"; color: #a6a8ac; font-size: 9px; vertical-alignment: center; }
        TextInput {
            x: 23.5px; width: parent.width - 30px; height: parent.height;
            text: Studio.picker-query; color: Tokens.text-primary; font-size: 9px; vertical-alignment: center; single-line: true;
            accessible-label: "Search parameters";
            init => { self.focus(); }
            edited => { Studio.picker-query = self.text; Studio.picker-edited(self.text); }
            changed has-focus => { Studio.picker-focused = self.has-focus; }
            accepted => { Studio.picker-pick(0); root.done(); }
        }
    }
    for it[i] in Studio.picker-items: Rectangle {
        x: 4px; y: it.y; width: parent.width - 8px; height: 21px; border-radius: 4px;
        background: ta.has-hover && it.enabled ? #2c2d32 : transparent;
        accessible-role: list-item; accessible-label: it.label;
        Text { x: 7px; width: parent.width - 30px; height: parent.height; text: it.label; color: it.enabled ? #d3d3d4 : #6a6b6f; font-size: 9.5px; font-weight: 500; vertical-alignment: center; overflow: elide; }
        if it.submenu: Icon { x: parent.width - 19px; y: 5.5px; width: 10px; height: 10px; d: Icons.chevron-right; ink: #8c8c8f; stroke-width: 1.5px; }
        if it.shortcut != "": Text { x: parent.width - 20px; width: 14px; height: parent.height; text: it.shortcut; color: #c9a83d; font-size: 9px; vertical-alignment: center; }
        ta := TouchArea { clicked => { if (it.enabled) { if (Studio.picker-query != "") { root.done(); } Studio.picker-pick(i); } } }
    }
}

// ------------------------------------------------------------------ window
// Window positions of the main panels (AppWindow.anchors).
export struct LayoutAnchors {
    transport-x: length,
    timeline-x: length, timeline-y: length, timeline-w: length,
    lanes-x: length, lanes-y: length,
    tracks-x: length, tracks-y: length,
    browser-x: length, browser-y: length,
    chat-x: length, chat-y: length, chat-w: length, chat-h: length,
    bottom-x: length, bottom-y: length, bottom-w: length,
    settings-x: length, settings-y: length, settings-w: length,
}

export component AppWindow inherits Window {
    title: Studio.project-name + (Studio.project-edited ? " — Edited" : "") + " — Device";
    preferred-width: 1440px;
    preferred-height: 820px;
    min-width: 960px;
    min-height: 600px;
    background: Tokens.bg-window;
    default-font-size: 9.5px;
    default-font-family: Tokens.font-ui;

    // Native menu bar on macOS (the app menu with About/Services/Hide/Quit comes from the backend).
    // Shortcut items are disabled while menu-key replays their key (see Studio.menu-replay).
    // The first menu holds the app menu's own items: src/appmenu.rs moves them into the app
    // menu after About and hides this menu (other platforms show it as is).
    MenuBar {
        Menu {
            title: "Device";
            MenuItem { title: "Settings…"; enabled: !Studio.menu-replay; shortcut: @keys(Control + ","); activated => { Studio.menu-key(",", true, false); } }
            MenuSeparator { }
        }
        Menu {
            title: "File";
            MenuItem { title: "New Project"; enabled: !Studio.menu-replay; shortcut: @keys(Control + N); activated => { Studio.menu-key("n", true, false); } }
            MenuSeparator { }
            MenuItem { title: "Save Project"; enabled: !Studio.menu-replay; shortcut: @keys(Control + S); activated => { Studio.menu-key("s", true, false); } }
            MenuItem { title: "Save Project As…"; enabled: !Studio.menu-replay; shortcut: @keys(Control + Shift + S); activated => { Studio.menu-key("s", true, true); } }
            MenuSeparator { }
            MenuItem { title: "Open Project…"; enabled: !Studio.menu-replay; shortcut: @keys(Control + O); activated => { Studio.menu-key("o", true, false); } }
            Menu {
                title: "Open Recent";
                for name[i] in Studio.recent-projects: MenuItem { title: name; activated => { Studio.open-recent(i); } }
                if Studio.recent-projects.length > 0: MenuSeparator { }
                MenuItem { title: "Clear Menu"; enabled: Studio.recent-projects.length > 0; activated => { Studio.menu-action("file.clear_recent"); } }
            }
            MenuItem { title: "Show Project in Finder"; enabled: Studio.project-on-disk; activated => { Studio.menu-action("file.show_in_finder"); } }
            MenuSeparator { }
            MenuItem { title: "Export Audio…"; enabled: !Studio.menu-replay; shortcut: @keys(Control + Shift + E); activated => { Studio.menu-key("e", true, true); } }
            MenuItem { title: "Export Project for Ableton Live…"; activated => { Studio.menu-action("file.export_ableton"); } }
            MenuItem { title: "Import Ableton Live Set…"; enabled: !Studio.menu-replay; activated => { Studio.menu-action("file.import_ableton"); } }
        }
        Menu {
            title: "Edit";
            MenuItem { title: Studio.undo-text; enabled: Studio.can-undo && !Studio.menu-replay; shortcut: @keys(Control + Z); activated => { Studio.menu-key("z", true, false); } }
            MenuItem { title: Studio.redo-text; enabled: Studio.can-redo && !Studio.menu-replay; shortcut: @keys(Control + Shift + Z); activated => { Studio.menu-key("z", true, true); } }
            MenuItem { title: "Undo History…"; activated => { Studio.menu-action("edit.undo_history"); } }
            MenuSeparator { }
            MenuItem { title: "Cut"; enabled: Studio.can-copy && !Studio.menu-replay; shortcut: @keys(Control + X); activated => { Studio.menu-key("x", true, false); } }
            MenuItem { title: "Copy"; enabled: Studio.can-copy && !Studio.menu-replay; shortcut: @keys(Control + C); activated => { Studio.menu-key("c", true, false); } }
            MenuItem { title: "Paste"; enabled: !Studio.menu-replay; shortcut: @keys(Control + V); activated => { Studio.menu-key("v", true, false); } }
            MenuItem { title: "Delete"; activated => { Studio.menu-key(Key.Delete, false, false); } }
        }
        Menu {
            title: "Create";
            MenuItem { title: "Audio Track"; enabled: !Studio.menu-replay; shortcut: @keys(Control + T); activated => { Studio.menu-key("t", true, false); } }
            MenuItem { title: "Instrument Track"; enabled: !Studio.menu-replay; shortcut: @keys(Control + Shift + T); activated => { Studio.menu-key("t", true, true); } }
            MenuSeparator { }
            MenuItem { title: "MIDI Clip"; enabled: !Studio.menu-replay; shortcut: @keys(Control + Shift + M); activated => { Studio.menu-key("m", true, true); } }
        }
        Menu {
            title: "View";
            MenuItem { title: "Zoom In"; enabled: !Studio.menu-replay; shortcut: @keys(Control + "="); activated => { Studio.menu-key("=", true, false); } }
            MenuItem { title: "Zoom Out"; enabled: !Studio.menu-replay; shortcut: @keys(Control + "-"); activated => { Studio.menu-key("-", true, false); } }
            MenuItem { title: "Reset Zoom"; enabled: !Studio.menu-replay; shortcut: @keys(Control + "0"); activated => { Studio.menu-key("0", true, false); } }
            MenuSeparator { }
            // No menu shortcut for the bare W / H: a menu shortcut takes the key even while a
            // text field has the focus. The keymap handles them (src/fit.rs).
            MenuItem { title: "Zoom to Fit Width (W)"; enabled: !Studio.menu-replay; activated => { Studio.menu-key("w", false, false); } }
            MenuItem { title: "Zoom to Fit Height (H)"; enabled: !Studio.menu-replay; activated => { Studio.menu-key("h", false, false); } }
        }
        Menu {
            title: "Options";
            MenuItem { title: "Audio/MIDI Settings…"; activated => { Studio.menu-action("options.audio_midi"); } }
            MenuSeparator { }
            MenuItem { title: "Check for New Plugins…"; activated => { Studio.menu-action("options.check_plugins"); } }
            MenuItem { title: "Rescan All Plugins…"; activated => { Studio.menu-action("options.rescan_plugins"); } }
            MenuSeparator { }
            MenuItem { title: "Check for Updates…"; activated => { Studio.menu-action("options.check_updates"); } }
        }
    }

    out property <length> lanes-width: timeline.lanes-width;
    out property <length> lanes-height: timeline.lanes-height;
    // Panel geometry (mirrored in src/highlight.rs `Layout`).
    property <length> bottom-h: Studio.bottom-h;
    // Top row y 78.2 / browser width 252.45 / timeline x 262.65: 92 pt, 297 pt and
    // 309 pt at the default (100 %) zoom, in our 85 % units.
    property <length> top-h: root.height - 88.4px - self.bottom-h;
    // Docked assistant: the saved width, narrowed first to keep the timeline header
    // usable (down to 252.45 = 297 px); only then do the zoom sliders hide. 711.5 is the timeline
    // width the header needs with its sliders; mirrored in src/splitters.rs.
    property <length> timeline-x: Studio.sounds-visible ? 262.65px : 5px;
    property <length> chat-room: root.width - self.timeline-x - 10px - 711.5px;
    property <length> chat-w: max(252.45px, min(Studio.assistant-pref-w, self.chat-room));
    out property <bool> header-zoom-hidden: Studio.assistant-open ? self.chat-room < 252.45px : self.chat-room + 5px < 0px;
    property <length> right-w: Studio.assistant-open ? self.chat-w + 5px : 0px;
    property <length> top-y: 78.2px;
    property <length> chat-x: root.width - 5px - root.chat-w;
    property <length> bottom-y: root.height - 5px - root.bottom-h;
    property <length> settings-x: max(0px, min(216.75px, root.width - 816px));
    property <length> settings-y: 5.5px;
    property <length> settings-w: min(816px, root.width);
    // Where the panels are, in window units: the self-test aims its clicks from these.
    // The content's top in window coordinates: the in-window menu bar's height (see Studio.menu-dy).
    content-origin := Rectangle { x: 0; y: 0; width: 0; height: 0; }
    property <length> menu-dy: content-origin.absolute-position.y;
    changed menu-dy => { Studio.menu-dy = self.menu-dy; }
    init => { Studio.menu-dy = self.menu-dy; }
    // Content height (below the in-window menu bar on Linux; the whole window on macOS and
    // Windows, whose menu bars are native). The self-test adds the difference to its pointer events.
    out property <length> content-height: root.height;
    out property <LayoutAnchors> anchors: {
        transport-x: header.transport-x,
        timeline-x: timeline.x, timeline-y: timeline.y, timeline-w: timeline.width,
        lanes-x: timeline.x + timeline.lanes-x, lanes-y: timeline.y + timeline.lanes-y,
        tracks-x: timeline.x, tracks-y: timeline.y + timeline.tracks-y,
        browser-x: 5px, browser-y: root.top-y,
        chat-x: root.chat-x, chat-y: root.top-y, chat-w: root.chat-w, chat-h: root.top-h,
        bottom-x: 5px, bottom-y: root.bottom-y, bottom-w: root.width - 10px,
        settings-x: root.settings-x, settings-y: root.settings-y, settings-w: root.settings-w,
    };

    property <int> cards-epoch: Studio.cards-epoch;
    changed cards-epoch => { fs.focus(); }
    // A press in the lanes or a clip editor takes the focus back, so an open track-name field
    // commits (TrackName commits when it loses the focus).
    property <int> press-epoch: Studio.press-epoch;
    changed press-epoch => { fs.focus(); }
    // A clip editor value stopped taking typing: keys go back to the shortcuts.
    property <int> ac-edit-field: Studio.ac-edit-field;
    changed ac-edit-field => { if (self.ac-edit-field < 0) { fs.focus(); } }
    // The key handler gets the focus back when a modal dialog closes, and takes it when one
    // without a text field of its own opens, so no field behind the dialog keeps typing (the
    // handler only passes Escape on while a dialog is open).
    property <bool> modal-open: Studio.export-open || Studio.unsaved-open || Studio.updates-open || Studio.undo-history-open;
    changed modal-open => {
        if (!self.modal-open || !Studio.export-open) {
            fs.focus();
        }
    }
    fs := FocusScope {
        init => { self.focus(); }
        key-pressed(e) => {
            if (e.text == Key.Escape) { self.focus(); }
            if (Studio.typing-key(e.text, true, e.repeat, e.modifiers.control || e.modifiers.shift || e.modifiers.alt || e.modifiers.meta)) { return accept; }
            if (Studio.key(e.text, e.modifiers.control, e.modifiers.shift, e.modifiers.alt, e.modifiers.meta, e.repeat)) { return accept; }
            reject
        }
        key-released(e) => {
            Studio.typing-key(e.text, false, false, false);
            reject
        }
        changed has-focus => {
            if (!self.has-focus) { Studio.typing-release(); }
        }
        header := Header { x: 0; y: 0; width: root.width; height: 73px; }
        if Studio.sounds-visible: Browser { x: 5px; y: root.top-y; width: 252.45px; height: root.top-h; }
        timeline := Timeline {
            focus-main => { fs.focus(); }
            zoom-hidden: root.header-zoom-hidden;
            x: root.timeline-x; y: root.top-y;
            width: root.width - self.x - 5px - root.right-w; height: root.top-h;
        }
        // Assistant panel: right-docked beside the timeline (nothing overlaps).
        if Studio.assistant-open: AssistantPanel {
            x: root.chat-x; y: root.top-y; width: root.chat-w; height: root.top-h;
            focus-main => { fs.focus(); }
        }
        // Width splitter between timeline and assistant: 13 px hit strip over the 6 px gap,
        // col-resize cursor, double-click restores the default width.
        if Studio.assistant-open: TouchArea {
            x: root.width - 5px - root.chat-w - 7.55px; y: 78.2px; width: 11.05px; height: root.top-h;
            mouse-cursor: col-resize;
            pointer-event(e) => {
                if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) { Studio.chat-resize(0, self.absolute-position.x + self.mouse-x); }
                if (e.kind == PointerEventKind.move && self.pressed) { Studio.chat-resize(1, self.absolute-position.x + self.mouse-x); }
                if ((e.button == PointerEventButton.left && e.kind == PointerEventKind.up) || e.kind == PointerEventKind.cancel) { Studio.chat-resize(2, self.absolute-position.x + self.mouse-x); }
            }
            double-clicked => { Studio.chat-resize-reset(); }
        }
        // Bottom panel: inspector + devices, or the mixer (taller; the row above shrinks).
        if !Studio.mixer-open: BottomPanel { x: 5px; y: root.bottom-y; width: root.width - 10px; height: root.bottom-h; focus-main => { fs.focus(); } }
        if Studio.mixer-open: MixerPanel { x: 5px; y: root.bottom-y; width: root.width - 10px; height: root.bottom-h; }
        // Timeline / bottom-panel splitter: an invisible 14 px strip across the gap, 8 px of it
        // above the panel's top edge (the resize handle).
        TouchArea {
            x: 5px; y: root.height - 5px - root.bottom-h - 6.8px; width: root.width - 10px; height: 11.9px;
            mouse-cursor: row-resize;
            pointer-event(e) => {
                if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) { Studio.bottom-resize(0, (self.absolute-position.y - Studio.menu-dy) + self.mouse-y); }
                if (e.kind == PointerEventKind.move && self.pressed) { Studio.bottom-resize(1, (self.absolute-position.y - Studio.menu-dy) + self.mouse-y); }
                if ((e.button == PointerEventButton.left && e.kind == PointerEventKind.up) || e.kind == PointerEventKind.cancel) { Studio.bottom-resize(2, (self.absolute-position.y - Studio.menu-dy) + self.mouse-y); }
            }
        }
        HighlightOverlay { x: 0; y: 0; width: root.width; height: root.height; }
        // Device windows: a built-in card opened from its header arrow floats above the
        // arrangement (the card stays in the chain too) and stays up across track changes;
        // its title strip moves it, the arrow or the strip's x closes it.
        for card[i] in Studio.device-window-cards: win := Rectangle {
            property <length> dx: card.win-dx;
            property <length> dy: card.win-dy;
            x: max(0px, min(root.width - self.width, (root.width - card.width) / 2 + i * 16px + self.dx));
            y: max(0px, min(root.height - 22px, 120px + i * 16px + self.dy));
            width: card.width + 8px; height: 265px + 26px;
            border-radius: 8px; background: #1a1b1e; border-width: 0.5px; border-color: #ffffff1f;
            drop-shadow-blur: 24px; drop-shadow-offset-y: 8px; drop-shadow-color: #00000099;
            Rectangle {
                TouchArea {
                    mouse-cursor: MouseCursor.move;
                    moved => { win.dx += self.mouse-x - self.pressed-x; win.dy += self.mouse-y - self.pressed-y; }
                    pointer-event(e) => { if (e.kind == PointerEventKind.up) { Studio.device-window-moved(card.id, win.x - (root.width - card.width) / 2 - i * 16px, win.y - 120px - i * 16px); } }
                }
                Text { x: 10px; y: 0; height: 22px; text: card.name; color: #81838a; font-size: 10px; font-weight: 600; vertical-alignment: center; }
                Rectangle {
                    x: parent.width - 21px; y: 3px; width: 16px; height: 16px; border-radius: 4px;
                    background: close-ta.has-hover ? #ffffff14 : transparent;
                    accessible-role: button; accessible-label: "Close device window";
                    Icon { x: 3px; y: 3px; width: 10px; height: 10px; d: Icons.close; ink: close-ta.has-hover ? #ffffff : #81838a; stroke-width: 1.04px; }
                    close-ta := TouchArea { clicked => { Studio.device-window(card.id); } }
                }
                BuiltinCard { x: 4px; y: 22px; card: card; }
            }
        }
        // Clip context menu (click outside dismisses).
        if Studio.menu-open: Rectangle {
            x: 0; y: 0; width: root.width; height: root.height;
            TouchArea { pointer-event(e) => { if (e.kind == PointerEventKind.down) { Studio.menu-dismiss(); } } }
            ContextMenu { x: Studio.menu-x; y: Studio.menu-y; height: Studio.menu-h; items: Studio.menu-items; activated(i) => { Studio.menu-activate(i); } }
            if Studio.sub-open: ContextMenu {
                x: Studio.menu-x + 209px - 4px; y: Studio.menu-y + Studio.sub-y; height: Studio.sub-h;
                items: Studio.sub-items; activated(i) => { Studio.sub-activate(i); }
            }
        }
        // Synth dropdown / preset list (click outside dismisses).
        if Studio.synth-menu-open: Rectangle {
            x: 0; y: 0; width: root.width; height: root.height;
            TouchArea { pointer-event(e) => { if (e.kind == PointerEventKind.down) { Studio.synth-menu-dismiss(); } } }
            SynthMenuList {
                x: min(Studio.synth-menu-x, root.width - 5px - Studio.synth-menu-w);
                y: max(5px, min(Studio.synth-menu-y, root.height - 5px - Studio.synth-menu-h));
                width: Studio.synth-menu-w; height: min(Studio.synth-menu-h, root.height - 10px);
                content-h: Studio.synth-menu-h;
                items: Studio.synth-menu-items;
                picked(i) => { Studio.synth-menu-pick(i); }
            }
        }
        // Timeline snap menu: Off, then Auto and the grid sizes, a rule before the triplets (S76).
        if Studio.snap-menu-open: Rectangle {
            x: 0; y: 0; width: root.width; height: root.height;
            TouchArea { pointer-event(e) => { if (e.kind == PointerEventKind.down) { Studio.snap-menu-dismiss(); } } }
            ChoiceList {
                x: Studio.snap-menu-x - Studio.snap-menu-w; y: Studio.snap-menu-y + 5.1px;
                width: Studio.snap-menu-w; height: Studio.snap-menu-h;
                items: Studio.snap-menu-items;
                font-size: 9.35px; text-x: 10.2px; check-x: 17px;
                picked(i) => { Studio.snap-menu-pick(i); }
                Rectangle { x: 3px; y: Studio.snap-menu-rule1; width: parent.width - 6px; height: 0.5px; background: #ffffff1c; }
                Rectangle { x: 3px; y: Studio.snap-menu-rule2; width: parent.width - 6px; height: 0.5px; background: #ffffff1c; }
            }
        }
        // Routing menu (src/routing.rs): add send, Out, Add track. Anchored at the control that
        // opened it, kept inside the window.
        if Studio.route-menu-open: Rectangle {
            x: 0; y: 0; width: root.width; height: root.height;
            TouchArea { pointer-event(e) => { if (e.kind == PointerEventKind.down) { Studio.route-menu-dismiss(); } } }
            ChoiceList {
                x: max(4px, min(Studio.route-menu-x, root.width - self.width - 4px));
                y: Studio.route-menu-y + self.height > root.height - 4px ? max(4px, Studio.route-menu-y - self.height - 26px) : Studio.route-menu-y;
                width: Studio.route-menu-w; height: Studio.route-menu-h;
                items: Studio.route-menu-items;
                picked(i) => { Studio.route-menu-pick(i); }
            }
        }
        // Transport bar Sig menu and key picker (src/transport_fields.rs), below their fields
        // (header coordinates: the fields' TouchAreas end at y 63).
        if Studio.sig-menu-open || Studio.key-menu-open: Rectangle {
            x: 0; y: 0; width: root.width; height: root.height;
            TouchArea { pointer-event(e) => { if (e.kind == PointerEventKind.down) { Studio.transport-menus-dismiss(); } } }
            if Studio.sig-menu-open: ChoiceList {
                x: header.transport-x + 912px; y: 66.4px;
                width: Studio.sig-menu-w; height: Studio.sig-menu-h;
                items: Studio.sig-menu-items;
                active: Studio.sig-menu-active;
                font-size: 9.35px; text-x: 10.2px; check-x: 17px;
                picked(i) => { Studio.sig-menu-pick(i); }
                Rectangle { x: 3px; y: Studio.sig-menu-rule; width: parent.width - 6px; height: 0.5px; background: #ffffff1c; }
            }
            if Studio.key-menu-open: KeyPicker { x: header.transport-x + 808px; y: 66.4px; }
        }
        // Inspector "In" selector (audio tracks): below the In field (bottom panel y + 59, x 5 + 11).
        if Studio.input-menu-open: Rectangle {
            x: 0; y: 0; width: root.width; height: root.height;
            TouchArea { pointer-event(e) => { if (e.kind == PointerEventKind.down) { Studio.input-menu-dismiss(); } } }
            ChoiceList {
                x: 16px; y: root.height - 5px - root.bottom-h + 59px;
                width: Studio.input-menu-w; height: Studio.input-menu-h;
                items: Studio.input-menu-items;
                picked(i) => { Studio.input-menu-pick(i); }
            }
        }
        // Browser › Files sort menu (click outside dismisses): a select menu (#212227, 8 px
        // radius, 4 px padding, 11 px semibold rows padded 4 / 12 px, the current one white on a
        // 7 % tint), as wide as its longest label, right-aligned under the sort button.
        if Studio.files-sort-open && Studio.sounds-visible && Studio.browser-section == 3: sm := Rectangle {
            x: 0; y: 0; width: root.width; height: root.height;
            TouchArea { pointer-event(e) => { if (e.kind == PointerEventKind.down) { Studio.files-sort-open-menu(false); } } }
            Rectangle {
                width: widest.preferred-width + 20.4px; height: 2 * 18.7px + 6.8px;
                x: 5px + 252.45px - 10.2px - self.width; y: 78.2px + Studio.files-list-y + 3.4px;
                widest := Text { visible: false; text: "Recent"; font-size: 9.35px; font-weight: 600; letter-spacing: -0.374px; }
                border-radius: 6.8px; background: #212227; border-width: 0.85px; border-color: #ffffff1c;
                drop-shadow-blur: 20px; drop-shadow-color: #00000066; drop-shadow-offset-y: 6.8px;
                accessible-role: list; accessible-label: "Sort";
                TouchArea { }
                for label[i] in ["Recent", "Name"]: Rectangle {
                    x: 0; y: 3.4px + i * 18.7px; width: parent.width; height: 18.7px;
                    accessible-role: list-item; accessible-label: label; accessible-checked: i == Studio.files-sort-index;
                    accessible-action-default => { Studio.files-sort-pick(i); }
                    Rectangle { background: row-ta.has-hover || i == Studio.files-sort-index ? #ffffff12 : transparent; }
                    Text { x: 10.2px; text: label; color: i == Studio.files-sort-index ? #ffffff : #d6d6d9;
                        font-size: 9.35px; font-weight: 600; letter-spacing: -0.374px; vertical-alignment: center; }
                    row-ta := TouchArea { clicked => { Studio.files-sort-pick(i); } }
                }
            }
        }
        // Clip editor dropdowns (click outside dismisses). Anchored below the field's value in
        // the audio toolbar (PianoRoll at window x 260, bottom panel y + 27), above the Grid footer
        // value, and below the Type / Genre pickers of the clip sidebar (above when it does not fit).
        if Studio.clip-menu >= 0: cm := Rectangle {
            property <length> bp-y: root.height - 5px - root.bottom-h;
            property <int> m: Studio.clip-menu;
            property <length> fy: Studio.composer-drums ? 71.5px : 104px;   // sidebar Type / Genre row
            x: 0; y: 0; width: root.width; height: root.height;
            TouchArea { pointer-event(e) => { if (e.kind == PointerEventKind.down) { Studio.clip-menu-open(-1); } } }
            DropMenu {
                row-h: cm.m <= 2 ? 18.7px : 20.4px;
                text-size: cm.m <= 2 ? 9.35px : 10.2px;
                check: cm.m == 3 || cm.m >= 6;
                max-rows: cm.m == 5 || cm.m >= 8 ? 12 : 99;
                section: cm.m == 3 ? 4 : cm.m == 7 ? 6 : -1;
                width: cm.m <= 1 ? 47.6px : cm.m == 2 ? 56px : cm.m == 3 ? 108px : cm.m == 4 ? 61px : cm.m == 5 ? 104px : cm.m == 8 ? 60px : cm.m == 9 ? 150px : 72px;
                x: cm.m >= 8 ? 260px + 720px : cm.m == 0 ? 260px + 206.2px : cm.m == 1 ? 260px + 273.95px : cm.m == 2 ? 260px + 347.6px : cm.m == 3 ? 260px + 387px : cm.m == 4 ? 5px + 48px
                    : cm.m == 6 ? 260px + 211.5px : cm.m == 7 ? 260px + 264px : Studio.composer-drums ? 5px + 53.5px : 5px + 153px;
                y: cm.m <= 2 ? cm.bp-y + 27px + 24.4px
                    : cm.m == 3 || cm.m >= 6 ? root.height - 5px - 24.5px + 7px - 10.2px - self.height
                    : cm.bp-y + cm.fy + 20.4px + self.height <= root.height - 5px ? cm.bp-y + cm.fy + 20.4px : cm.bp-y + cm.fy - 5.1px - self.height;
                picked(i) => { Studio.clip-menu-pick(i); }
            }
        }
        // Device popup list: Add device submenus, instrument selector (click outside dismisses).
        if Studio.devmenu-open: Rectangle {
            x: 0; y: 0; width: root.width; height: root.height;
            TouchArea { pointer-event(e) => { if (e.kind == PointerEventKind.down) { Studio.devmenu-dismiss(); } } }
            DevMenuList {
                x: max(5px, min(Studio.devmenu-x, root.width - 5px - Studio.devmenu-w));
                y: max(5px, min(Studio.devmenu-y, root.height - 5px - Studio.devmenu-h));
                width: Studio.devmenu-w; height: Studio.devmenu-h; content-h: Studio.devmenu-content-h;
                items: Studio.devmenu-items;
                picked(i) => { Studio.devmenu-pick(i); }
            }
        }
        // Browser device drag: drop target outline + ghost label at the pointer.
        if Studio.dnd-active && Studio.dnd-target-visible: Rectangle {
            x: Studio.dnd-tx; y: Studio.dnd-ty; width: Studio.dnd-tw; height: Studio.dnd-th; border-radius: 4px;
            background: #2752f522; border-width: 1.5px; border-color: Tokens.accent;
        }
        if Studio.dnd-active: Rectangle {
            x: Studio.dnd-x + 10px; y: Studio.dnd-y + 6px; height: 20px; width: ghost.preferred-width + 18px; border-radius: 10px;
            background: Studio.dnd-ok ? Tokens.accent : #3a3b40;
            ghost := Text { text: Studio.dnd-label; color: #ffffff; font-size: 9px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
        }
        // Automation parameter picker (188 pt wide, search field, 21 pt rows).
        if Studio.picker-open: Rectangle {
            x: 0; y: 0; width: root.width; height: root.height;
            TouchArea { pointer-event(e) => { if (e.kind == PointerEventKind.down) { Studio.picker-dismiss(); fs.focus(); } } }
            AutoPicker {
                x: max(5px, min(Studio.picker-x, root.width - 5px - 188px));
                y: max(5px, min(Studio.picker-y, root.height - 5px - Studio.picker-h));
                width: 188px; height: Studio.picker-h;
                done => { fs.focus(); }
            }
            if Studio.picker-sub-open: DevMenuList {
                x: min(Studio.picker-x + 190px, root.width - 5px - 188px);
                y: max(5px, min(Studio.picker-y + Studio.picker-sub-y, root.height - 5px - Studio.picker-sub-h));
                width: 188px; height: min(Studio.picker-sub-h, root.height - 10px); content-h: Studio.picker-sub-h;
                items: Studio.picker-sub-items;
                picked(i) => { Studio.picker-sub-pick(i); fs.focus(); }
            }
        }
        // Rename clip popup.
        if Studio.rename-open: Rectangle {
            x: 0; y: 0; width: root.width; height: root.height; background: #00000040;
            TouchArea { clicked => { Studio.rename-cancel(); fs.focus(); } }
            Rectangle {
                x: (root.width - 260px) / 2; y: 220px; width: 260px; height: 66px; border-radius: 8px;
                background: Tokens.bg-raised; border-width: 0.5px; border-color: #3a3b40;
                TouchArea { }
                Text { x: 12px; y: 8px; height: 14px; text: Studio.rename-title; color: Tokens.text-bright; font-size: 10px; font-weight: 600; vertical-alignment: center; }
                Rectangle {
                    x: 12px; y: 30px; width: parent.width - 24px; height: 24px; border-radius: 5px; background: Tokens.bg-input;
                    border-width: 0.5px; border-color: Tokens.accent;
                    rename-input := TextInput {
                        x: 8px; width: parent.width - 16px; height: parent.height;
                        text: Studio.rename-text; color: Tokens.text-primary; font-size: 10px; vertical-alignment: center;
                        single-line: true;
                        init => { self.focus(); self.select-all(); }
                        edited => { Studio.rename-text = self.text; }
                        accepted => { Studio.rename-commit(self.text); fs.focus(); }
                    }
                }
            }
        }
        // Settings window (in-app modal panel at the settings window rect; outside click closes).
        if Studio.settings-open: Rectangle {
            x: 0; y: 0; width: root.width; height: root.height;
            TouchArea { clicked => { Studio.close-settings(); fs.focus(); } }
            SettingsPanel { x: root.settings-x; y: root.settings-y; width: root.settings-w; height: root.height - 5.5px + 12px; }
        }
        // Export dialog (centred) and the unsaved-changes prompt (over the timeline);
        // both are modal: clicks outside them are swallowed.
        if Studio.export-open: Rectangle {
            x: 0; y: 0; width: root.width; height: root.height;
            TouchArea { }
            ExportModal { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
        }
        if Studio.unsaved-open: Rectangle {
            x: 0; y: 0; width: root.width; height: root.height;
            TouchArea { }
            UnsavedPrompt { x: max(0px, min(438px, parent.width - self.width)); y: max(0px, min(295px, parent.height - self.height)); }
        }
        // Clip render in progress (the export progress look: 6 px bar, 6 % white track, #1253ff fill).
        if Studio.render-busy: Rectangle {
            x: root.width - self.width - 14px; y: root.height - 60px; height: 24px; width: 292px; border-radius: 12px; background: #2a2b30ee;
            Text { x: 12px; width: 150px; height: parent.height; text: Studio.render-label; color: #e5e5e8; font-size: 8.75px; vertical-alignment: center; overflow: elide; }
            Rectangle {
                x: 168px; y: 9px; width: 64px; height: 6px; border-radius: 3px; background: #ffffff0f; clip: true;
                Rectangle { x: 0; width: parent.width * clamp(Studio.render-progress, 0, 1); background: #1253ff; }
            }
            Text { x: 242px; width: 44px; height: parent.height; text: "Cancel"; color: #8fb0ff; font-size: 8.75px; vertical-alignment: center; horizontal-alignment: center;
                TouchArea { clicked => { Studio.render-cancel(); } mouse-cursor: pointer; }
            }
        }
        if Studio.updates-open: Rectangle {
            x: 0; y: 0; width: root.width; height: root.height;
            TouchArea { clicked => { Studio.updates-close(); } }
            UpdatesModal { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
        }
        if Studio.undo-history-open: Rectangle {
            x: 0; y: 0; width: root.width; height: root.height;
            TouchArea { clicked => { Studio.undo-history-close(); } }
            UndoHistoryModal {
                max-h: parent.height - 81.6px;
                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            }
        }
        // Status line (engine/device/import messages); empty most of the time.
        if Studio.status-text != "": Rectangle {
            x: root.width - self.width - 14px; y: root.height - 34px; height: 20px;
            width: status.preferred-width + 20px; border-radius: 10px; background: #2a2b30ee;
            status := Text { text: Studio.status-text; color: #e5e5e8; font-size: 8.75px; vertical-alignment: center; horizontal-alignment: center; }
        }
    }
}
